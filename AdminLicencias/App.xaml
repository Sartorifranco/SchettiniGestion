<Application x:Class="AdminLicencias.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ── Paleta ─────────────────────────────────────────────────────── -->
        <Color x:Key="AccentColor">#2563EB</Color>
        <Color x:Key="AccentDark">#1D4ED8</Color>
        <Color x:Key="SurfaceColor">#1E293B</Color>
        <Color x:Key="SurfaceMid">#273449</Color>
        <Color x:Key="SurfaceLight">#334155</Color>
        <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="OrangeColor">#F59E0B</Color>
        <Color x:Key="RedColor">#EF4444</Color>
        <Color x:Key="GrayColor">#64748B</Color>

        <SolidColorBrush x:Key="Accent"         Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>
        <SolidColorBrush x:Key="Surface"        Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceMidBrush" Color="{StaticResource SurfaceMid}"/>
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="GreenBrush"     Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="OrangeBrush"    Color="{StaticResource OrangeColor}"/>
        <SolidColorBrush x:Key="RedBrush"       Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="GrayBrush"      Color="{StaticResource GrayColor}"/>

        <!-- ── TextBox ───────────────────────────────────────────────────── -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background"     Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground"     Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="10,8"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="CaretBrush"     Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ─────────────────────────────────────────────────── -->
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background"     Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground"     Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Padding"        Value="10,8"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="Height"         Value="38"/>
        </Style>

        <!-- ── Button primario ─────────────────────────────────────────── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="18,9"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Button secundario ──────────────────────────────────────── -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,9"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón de peligro ───────────────────────────────────────── -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="{StaticResource RedBrush}"/>
        </Style>

        <!-- ── Label de campo ────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ── Separador ─────────────────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Margin"     Value="0,8"/>
        </Style>

        <!-- ── CheckBox ──────────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <!-- ── ScrollBar slim ────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
        </Style>
    </Application.Resources>
</Application>
