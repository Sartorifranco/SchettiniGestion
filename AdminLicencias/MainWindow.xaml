<Window x:Class="AdminLicencias.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCHPOS — Admin Licencias"
        Width="1200" Height="750" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <Window.Resources>
        <!-- Botón de navegación lateral -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ───────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceMidBrush}">
            <DockPanel>
                <!-- Logo / nombre -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,20">
                    <TextBlock Text="⬛ SCHPOS" Foreground="{StaticResource Accent}"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Admin Licencias" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Margin="16,0"/>

                <!-- Versión en footer -->
                <TextBlock DockPanel.Dock="Bottom" Text="v1.0.0"
                           Foreground="{StaticResource TextSecondary}" FontSize="10"
                           Margin="16,12" HorizontalAlignment="Left"/>

                <!-- Nav items -->
                <StackPanel Margin="0,12,0,0">
                    <Button x:Name="btnDashboard"  Content="📊  Dashboard"       Click="Nav_Click" Tag="dashboard"  Style="{StaticResource NavBtnActive}"/>
                    <Button x:Name="btnClientes"   Content="👥  Clientes"         Click="Nav_Click" Tag="clientes"/>
                    <Button x:Name="btnNuevaLic"   Content="🔑  Nueva Licencia"   Click="Nav_Click" Tag="nueva"/>
                    <Button x:Name="btnHistorial"  Content="📋  Historial"        Click="Nav_Click" Tag="historial"/>
                    <Button x:Name="btnConfig"     Content="⚙  Configuración"    Click="Nav_Click" Tag="config"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Contenido principal ────────────────────────────────────── -->
        <Frame x:Name="frameMain" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource Surface}"/>
    </Grid>
</Window>
