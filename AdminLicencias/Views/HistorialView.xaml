<Page x:Class="AdminLicencias.Views.HistorialView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Surface}" Title="Historial">

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Encabezado ─────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Historial de licencias" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="txtResumen" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="⬇  Exportar CSV" Style="{StaticResource BtnSecondary}"
                    Click="ExportCSV_Click" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ── Filtros ────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceMidBrush}"
                CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="txtBuscar" Style="{StaticResource Field}" Height="36"
                             TextChanged="TxtBuscar_Changed"/>
                    <TextBlock Text="🔍  Buscar cliente o HWID…" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Estado -->
                <ComboBox Grid.Column="2" x:Name="cbEstado" Style="{StaticResource Combo}" Height="36"
                          SelectionChanged="CbEstado_Changed">
                    <ComboBoxItem Content="Todos los estados" IsSelected="True"/>
                    <ComboBoxItem Content="Activa"/>
                    <ComboBoxItem Content="PorVencer"/>
                    <ComboBoxItem Content="Vencida"/>
                    <ComboBoxItem Content="Revocada"/>
                </ComboBox>

                <!-- Desde -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <DatePicker x:Name="dpDesde" Height="36"
                                SelectedDateChanged="Dp_Changed"/>
                </StackPanel>

                <!-- Hasta -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <DatePicker x:Name="dpHasta" Height="36"
                                SelectedDateChanged="Dp_Changed"/>
                </StackPanel>

                <!-- Limpiar -->
                <Button Grid.Column="8" Content="✕ Limpiar" Style="{StaticResource BtnSecondary}"
                        Click="LimpiarFiltros_Click" FontSize="12" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ── Tabla (fila * = ocupa el resto) ───────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMidBrush}"
                CornerRadius="12" ClipToBounds="True">
            <DataGrid x:Name="gridHistorial" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#0F273449"
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      ColumnHeaderHeight="36" RowHeight="42"
                      SelectionMode="Single" CanUserResizeRows="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"   Value="Transparent"/>
                        <Setter Property="Foreground"   Value="{StaticResource TextSecondary}"/>
                        <Setter Property="FontSize"     Value="11"/>
                        <Setter Property="Padding"      Value="12,0"/>
                        <Setter Property="BorderBrush"  Value="{StaticResource SurfaceLightBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background"      Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="FontSize"        Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente"     Binding="{Binding NombreCliente}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="CUIT"        Binding="{Binding CUIT}"          Width="130"/>
                    <DataGridTextColumn Header="Versión"     Binding="{Binding Version}"       Width="90"/>
                    <DataGridTextColumn Header="Emitida"     Binding="{Binding FechaEmision}"  Width="110"/>
                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding Vencimiento}"   Width="110"/>
                    <DataGridTextColumn Header="Días rest."  Binding="{Binding DiasRestantes}" Width="90"/>
                    <DataGridTemplateColumn Header="Estado" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="12,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstadoColor}" Value="green">
                                                    <Setter Property="Background" Value="#1422C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoColor}" Value="orange">
                                                    <Setter Property="Background" Value="#14F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoColor}" Value="red">
                                                    <Setter Property="Background" Value="#14EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoColor}" Value="gray">
                                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding EstadoStr}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoColor}" Value="green">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoColor}" Value="orange">
                                                        <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoColor}" Value="red">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstadoColor}" Value="gray">
                                                        <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Monto"       Binding="{Binding Monto}"         Width="100"/>
                    <DataGridTextColumn Header="HWID"        Binding="{Binding HWID}"          Width="140"/>
                    <DataGridTextColumn Header="Método"      Binding="{Binding Metodo}"        Width="110"/>
                    <DataGridTextColumn Header="Renovación"  Binding="{Binding EsRenovacion}"  Width="100"/>
                    <DataGridTextColumn Header="Módulos"     Binding="{Binding Modulos}"       Width="*" MinWidth="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
