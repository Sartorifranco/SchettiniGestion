<Window x:Class="SchettiniGestion.WPF.ActivationWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Activación de Licencia"

        Width="500" Height="460"

        WindowStartupLocation="CenterScreen"

        ResizeMode="NoResize"

        Background="Transparent"

        WindowStyle="None"

        AllowsTransparency="True">



    <Border CornerRadius="12" Background="{DynamicResource ModuleBackgroundBrush}"

            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12,12,0,0" Padding="24,16"

                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"

                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                        <TextBlock Text="🔑" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Activación de Licencia" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="Ingrese su clave de licencia para activar el sistema" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"

                            Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0"

                            FontSize="16" Cursor="Hand" Click="btnCerrar_Click">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background" Value="Transparent"/>

                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>

                                <Setter Property="BorderThickness" Value="0"/>

                                <Setter Property="Cursor" Value="Hand"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </Grid>

            </Border>



            <StackPanel Grid.Row="1" Margin="28,20,28,0">



                <Border x:Name="borderStatus" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"

                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock x:Name="iconStatus" Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource WarningColor}"/>

                        <StackPanel>

                            <TextBlock x:Name="lblStatusTitle" Text="Licencia no válida" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WarningColor}"/>

                            <TextBlock x:Name="lblStatusDesc" Text="Ingrese una clave de licencia válida para continuar." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

                        </StackPanel>

                    </StackPanel>

                </Border>



                <TextBlock Text="ID de Máquina (envíe este código para obtener su licencia):" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>

                <Grid Margin="0,0,0,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6,0,0,6" Padding="10,8">

                        <TextBlock x:Name="txtMachineId" Text="" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

                    </Border>

                    <Button Grid.Column="1" Content="Copiar" Style="{StaticResource ButtonStyle}"

                            Padding="12,8" Click="btnCopiarMachineId_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}" CornerRadius="0,6,6,0"

                                        Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>



                <TextBlock Text="Clave de Licencia:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>

                <TextBox x:Name="txtLicenciaKey" Style="{StaticResource ModuleTextBoxStyle}"
                         Height="42" FontFamily="Consolas" FontSize="12"
                         ToolTip="Pegue aquí la clave de licencia recibida"/>

                <Button Content="📂 Cargar archivo licencia.key" Margin="0,8,0,0" Padding="12,8"
                        HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                        Click="btnCargarArchivoLicencia_Click"/>

                <TextBlock x:Name="lblError" Text="" Foreground="{StaticResource DangerColor}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>



            </StackPanel>



            <Border Grid.Row="2" Padding="28,14,28,20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondary}"

                               Text="© SCHPOS — Soporte: info@schettini.com.ar"/>

                    <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"

                            Padding="16,9" Click="btnCancelar_Click"/>

                    <Button Grid.Column="3" Content="✔  Activar" Style="{StaticResource ButtonStyle}"

                            Padding="20,9" Click="btnActivar_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

