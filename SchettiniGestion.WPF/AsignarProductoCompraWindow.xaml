<Window x:Class="SchettiniGestion.WPF.AsignarProductoCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignar producto"
        Width="820" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Asignar producto del sistema" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock x:Name="lblLineaDetectada" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="12"
                Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock Text="Buscá por código, código de barras o parte del nombre:"
                           Style="{StaticResource ModalCaptionTextStyle}"/>
                <TextBox x:Name="txtBuscar" Style="{StaticResource ModuleTextBoxStyle}"
                         TextChanged="txtBuscar_TextChanged"/>
                <TextBlock Text="Consejo: si no aparece, probá con una sola palabra. Si el producto es nuevo, crealo con el botón inferior."
                           Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="lblEstadoBusqueda" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="3" x:Name="dgvProductos"
                  Style="{StaticResource ModuleDataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" MouseDoubleClick="dgvProductos_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridTextColumn Header="Costo actual" Binding="{Binding PrecioCosto, StringFormat=C2}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="➕ Crear producto nuevo" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,10" Margin="0,0,8,4" Click="btnCrearProducto_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,4" Click="btnCancelar_Click"/>
                <Button Content="✔ Asignar seleccionado" Style="{StaticResource ButtonStyle}"
                        Margin="0,0,0,4" Click="btnAsignar_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
