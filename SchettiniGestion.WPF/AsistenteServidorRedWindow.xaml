<Window x:Class="SchettiniGestion.WPF.AsistenteServidorRedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente de servidor — SCHPOS"
        Width="680" Height="620"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12,12,0,0"
                    Padding="24,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Asistente de servidor en red" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="txtPasoHeader" Text="Paso 1 de 4" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,20">
                <!-- Paso 0: Bienvenida -->
                <StackPanel x:Name="panelPaso0">
                    <TextBlock Text="Esta PC será el SERVIDOR" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" LineHeight="22"
                               Text="El asistente va a preparar todo para que otras cajas se conecten por la red:&#x0a;&#x0a;1. Instalar SQL Server Express (una sola instancia SQLEXPRESS)&#x0a;2. Abrir el puerto, el firewall y el modo mixto (Windows pedirá permiso)&#x0a;3. Recién cuando SQL acepte logins SQL, migrar datos y crear el usuario schpos&#x0a;&#x0a;Tocá Siguiente en cada paso. Cuando Windows muestre el cartel del escudo, tocá Sí. Después de eso el servicio SQL se para y arranca: sin eso el modo mixto no entra."/>
                </StackPanel>

                <!-- Paso 1: SQL Express -->
                <StackPanel x:Name="panelPaso1" Visibility="Collapsed">
                    <TextBlock Text="SQL Server Express" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                               Text="Es el motor de base de datos que usan todas las PCs. Si no está instalado, se descarga e instala al tocar Siguiente (puede tardar varios minutos). Una sola instancia: SQLEXPRESS. No instales una segunda (SQLEXPRESS01) si no hace falta."/>
                    <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <TextBlock x:Name="txtEstadoExpress" Text="Verificando..." TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                    <TextBlock x:Name="txtLogPaso1" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- Paso 2: Firewall / puertos -->
                <StackPanel x:Name="panelPaso2" Visibility="Collapsed">
                    <TextBlock Text="Puerto y firewall" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                               Text="Al tocar Siguiente, Windows pedirá permiso de administrador (escudo). Tenés que tocar Sí.&#x0a;&#x0a;Eso habilita TCP 1433, el firewall y el modo mixto (SQL + Windows). Después el asistente para y arranca el servicio SQL Server (SQLEXPRESS): sin eso SQL sigue rechazando el usuario schpos aunque el puerto ya responda.&#x0a;&#x0a;Si el cartel no se ve, mirá la barra de tareas."/>
                    <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14">
                        <TextBlock x:Name="txtLogPaso2" Text="Listo para pedir permiso a Windows." TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                </StackPanel>

                <!-- Paso 3: Migración + credenciales -->
                <ScrollViewer x:Name="panelPaso3" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Datos y acceso de clientes" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                                   Text="Solo si el paso anterior dejó SoloWindows = 0: se migran los datos, se crea el usuario schpos (una vez) y se guarda la guía en el Escritorio. Si «Preparar datos» falló antes, se borra el schpos viejo y se reintenta una sola vez — no hace falta tocarlo diez veces."/>
                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <TextBlock x:Name="txtLogPaso3" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>

                        <!-- Credenciales con botones de copiar (visible al finalizar) -->
                        <StackPanel x:Name="pnlCredencialesFinal" Visibility="Collapsed">
                            <TextBlock Text="Para las otras PCs" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Servidor" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="txtServidorFinal" Grid.Column="1" IsReadOnly="True"
                                         Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,8,0"
                                         FontFamily="Consolas" FontSize="13"/>
                                <Button Grid.Column="2" Content="Copiar" MinWidth="72" MinHeight="40"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="btnCopiarServidor_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Puerto" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="txtPuertoFinal" Grid.Column="1" IsReadOnly="True" Text="1433"
                                         Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,8,0"
                                         FontFamily="Consolas" FontSize="13"/>
                                <Button Grid.Column="2" Content="Copiar" MinWidth="72" MinHeight="40"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="btnCopiarPuerto_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Usuario" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="txtUsuarioFinal" Grid.Column="1" IsReadOnly="True" Text="schpos"
                                         Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,8,0"
                                         FontFamily="Consolas" FontSize="13"/>
                                <Button Grid.Column="2" Content="Copiar" MinWidth="72" MinHeight="40"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="btnCopiarUsuario_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Contraseña" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="txtPasswordFinal" Grid.Column="1" IsReadOnly="True"
                                         Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,8,0"
                                         FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                                <Button Grid.Column="2" Content="Copiar" MinWidth="72" MinHeight="40"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="btnCopiarPassword_Click"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="📋 Copiar todo (para WhatsApp / mail)"
                                        Style="{StaticResource ButtonStyle}"
                                        MinHeight="44" Padding="16,8" Margin="0,0,10,0"
                                        Click="btnCopiarTodo_Click"/>
                                <Button Content="📂 Abrir guía"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="44" Padding="16,8"
                                        Click="btnAbrirGuia_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="txtRutaGuia" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="💡 IP del servidor: conviene fija (reserva DHCP en el router o IP estática). Si cambia con DHCP, las otras cajas dejan de conectar hasta actualizar la IP."/>

                            <Border x:Name="bdrAvisoTcp" Visibility="Collapsed"
                                    Background="#3A2E1B" BorderBrush="#F59E0B" BorderThickness="1"
                                    CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                <TextBlock x:Name="txtAvisoTcp" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="#F59E0B" LineHeight="18"/>
                            </Border>
                        </StackPanel>

                        <!-- Texto legacy (durante el proceso, antes de finalizar) -->
                        <TextBlock x:Name="txtCredenciales" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Padding="20,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancelar" Grid.Column="0" Content="Ahora no" Width="110" Height="40"
                            HorizontalAlignment="Left" Click="btnCancelar_Click"/>
                    <Button x:Name="btnAtras" Grid.Column="1" Content="Atrás" Width="100" Height="40"
                            Margin="0,0,10,0" Click="btnAtras_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnSiguiente" Grid.Column="2" Content="Siguiente" Width="140" Height="40"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Click="btnSiguiente_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
