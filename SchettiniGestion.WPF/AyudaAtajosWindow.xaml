<Window x:Class="SchettiniGestion.WPF.AyudaAtajosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atajos de Teclado"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModuleBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="AtajoKey" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
        <Style x:Key="AtajoDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="20,14"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⌨" FontSize="22" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Comandos rápidos — Venta POS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Combinaciones con tecla Alt (recomendado). Escape para volver o cerrar." FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Acciones principales (Alt + tecla)"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + V" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Cobrar / emitir comprobante" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + L" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Limpiar venta y empezar comprobante nuevo" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + P" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Imprimir el último comprobante guardado" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + O" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Abrir u ocultar configuración de la venta (lista, tipo, forma de pago)" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + D" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Descuento general sobre toda la venta (% Total)" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + Q" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Cambiar modo de búsqueda (todo / código / descripción)" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Búsqueda y navegación"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + E" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Enfocar búsqueda de producto" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + C" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Enfocar búsqueda de cliente" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Alt + F" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Limpiar filtro de búsqueda de producto" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Escape" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Cerrar sugerencias, colapsar configuración o limpiar búsqueda activa" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Shift + Esc" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Volver atrás; si no hay nada que cerrar, enfoca la búsqueda de producto" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="↑ / ↓" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Navegar listas de sugerencias (cliente o producto)" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Producto y carrito"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Enter" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="En producto: agrega por código/barras exacto, sugerencia única o abre «Varios». En sugerencias: confirma la fila." Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Enter ×2" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Con ítems en el carrito: dos Enter seguidos en búsqueda de producto inician el cobro" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="Supr" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Quitar ítem del carrito (último tocado o último agregado)" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeader}" Text="Ayuda"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Border Style="{StaticResource AtajoKey}"><TextBlock Text="F1" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="11" TextAlignment="Center"/></Border>
                    <TextBlock Text="Mostrar esta ventana de comandos rápidos" Style="{StaticResource AtajoDesc}" MaxWidth="480"/>
                </StackPanel>

                <Border Background="{DynamicResource SurfaceDark}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                   Text="• Los atajos funcionan en la pestaña «Venta POS» mientras el panel no esté bloqueado por caja."/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="• Un lector de código de barras en modo teclado puede escribir y enviar Enter para agregar el producto."/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="• En Venta POS: botón «⌨ Atajos» arriba del catálogo y «Ver atajos de teclado» debajo de COBRAR."/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="• Tocá un producto del carrito para editar cantidad, descuento o precio de ese ítem."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" Padding="20,10"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Button Content="Cerrar (Escape)" Width="140" HorizontalAlignment="Right"
                    Style="{StaticResource ButtonStyle}" Padding="0,8"
                    Click="btnCerrar_Click"/>
        </Border>
    </Grid>
</Window>
