<UserControl x:Class="SchettiniGestion.WPF.CajaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SchettiniGestion.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="CajaControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="bannerSinApertura" Grid.Row="0" Background="{DynamicResource ComboBoxItemHoverBackground}"
                BorderBrush="{DynamicResource WarningColor}"
                BorderThickness="3,0,0,0" CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="⚠ No hay apertura de caja hoy. Abrí el turno en la pestaña «Apertura de caja» con el fondo fijo antes de operar."
                       Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Caja" Style="{DynamicResource TitleTextStyle}"/>
            <TextBlock TextWrapping="Wrap" Style="{DynamicResource PageSubtitleStyle}"
                       Text="Ingresar / Retirar son movimientos manuales de efectivo (fondo, gastos, retiros). Las ventas se registran solas al cobrar y no se cargan acá."/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SaaSTableCard}" Padding="20" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="40" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <StackPanel>
                        <TextBlock Text="SALDO EN CAJA" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        <Viewbox Stretch="Uniform" MaxHeight="40" HorizontalAlignment="Left">
                            <TextBlock x:Name="lblSaldo" Text="$ 0,00" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Button x:Name="btnIngreso" Click="btnIngreso_Click" Margin="0,0,10,0" Cursor="Hand"
                        Style="{StaticResource SuccessButtonStyle}" MinWidth="150" Padding="20,10">
                    <StackPanel>
                        <TextBlock Text="⬆ INGRESAR" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Efectivo manual (no es venta)" Foreground="White" Opacity="0.88" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnEgreso" Click="btnEgreso_Click" Cursor="Hand"
                        Style="{StaticResource DeleteButtonStyle}" MinWidth="150" Padding="20,10">
                    <StackPanel>
                        <TextBlock Text="⬇ RETIRAR" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gasto / retiro (no es venta)" Foreground="White" Opacity="0.88" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SaaSTableCard}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Movimientos del Día" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                <DataGrid x:Name="dgvMovimientos" Style="{StaticResource ModuleDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding MovimientoID}" Width="60"/>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Fecha, StringFormat={}{0:HH:mm}}" Width="80"/>
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="120" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="120"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>