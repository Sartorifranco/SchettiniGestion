<Window x:Class="SchettiniGestion.WPF.ClienteModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente" Width="580" SizeToContent="Height" MinHeight="0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblTitulo" Text="Nuevo Cliente" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CUIT / CUIL (Enter para buscar ARCA)" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}" MaxLength="13" KeyDown="txtCuit_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Razón Social / Nombre *" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}" MaxLength="200"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Categoría Fiscal" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <ComboBox x:Name="cmbCondicionIVA" Style="{StaticResource ModuleComboBoxStyle}">
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content="Consumidor Final"/>
                        <ComboBoxItem Content="Responsable Inscripto"/>
                        <ComboBoxItem Content="Monotributo"/>
                        <ComboBoxItem Content="Exento"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Teléfono" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Domicilio" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="Email" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <CheckBox x:Name="chkPermiteCtaCte" Content="Permite cuenta corriente" Foreground="{DynamicResource TextPrimary}"
                              FontSize="14" Margin="0,0,0,10" Checked="chkPermiteCtaCte_Changed" Unchecked="chkPermiteCtaCte_Changed"/>
                    <TextBlock Text="Monto Límite Cta. Cte." Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtMontoLimiteCtaCte" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                Padding="14,12" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnEliminar" Content="Eliminar" Style="{StaticResource DeleteButtonStyle}"
                        MinHeight="44" Padding="16,8" Margin="0,0,10,0" Visibility="Collapsed" Click="btnEliminar_Click"/>
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="44" Padding="16,8" Margin="0,0,10,0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Content="✔ Guardar" Style="{StaticResource ButtonStyle}"
                        MinHeight="44" Padding="18,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
