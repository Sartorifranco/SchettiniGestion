<Window x:Class="SchettiniGestion.WPF.ClienteRapidoModalWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Nuevo Cliente Rápido" Width="500" Height="500"

        WindowStartupLocation="CenterOwner"

        ResizeMode="NoResize"

        Background="{DynamicResource ModuleBackgroundBrush}">



    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="Nuevo Cliente Rápido" FontSize="17" FontWeight="Bold"

                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,20"/>



        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Razón Social / Nombre *" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>



                <TextBlock Text="CUIT / DNI" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12" Text="00-00000000-0"/>



                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="12"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Condición IVA *" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                        <ComboBox x:Name="cmbCondicionIVA" Style="{StaticResource ModuleComboBoxStyle}" Margin="0,0,0,12">

                            <ComboBoxItem Content="Consumidor Final" IsSelected="True"/>

                            <ComboBoxItem Content="Responsable Inscripto"/>

                            <ComboBoxItem Content="Monotributista"/>

                            <ComboBoxItem Content="Exento"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Teléfono" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                        <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>

                    </StackPanel>

                </Grid>



                <TextBlock Text="Email" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>



                <TextBlock Text="Dirección" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>

                <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="Lista de precios" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbListaPrecio" Style="{StaticResource ModuleComboBoxStyle}"
                          DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,0,0,4"/>
                <TextBlock Text="Opcional. Si el cliente es mayorista, elegí su lista: el POS la aplica al seleccionarlo."
                           Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

            </StackPanel>

        </ScrollViewer>



        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">

            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnCancelar_Click"/>

            <Button Content="✔ Guardar Cliente" Style="{StaticResource ButtonStyle}" Click="btnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>

