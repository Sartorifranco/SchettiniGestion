<UserControl x:Class="SchettiniGestion.WPF.ClientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="ClientesControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Clientes" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,10"/>
                    <TextBlock Text="Buscar por CUIT o Razón Social" Style="{DynamicResource LabelStyle}"/>
                    <TextBox x:Name="txtFiltroClientes" Style="{DynamicResource ModernTextBox}" TextChanged="txtFiltroClientes_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="btnPlantillaClientes" Content="📥 Plantilla" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,10" Margin="15,0,8,0" Click="btnPlantillaClientes_Click"
                            ToolTip="Descarga CSV o Excel para alta masiva de clientes"/>
                    <Button x:Name="btnImportarClientes" Content="📂 Importar" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,10" Margin="0,0,8,0" Click="btnImportarClientes_Click"
                            ToolTip="Importar clientes desde CSV o Excel"/>
                    <Button x:Name="btnNuevo" Content="➕ Nuevo Cliente" Style="{StaticResource ButtonStyle}"
                            Padding="15,10" Click="btnNuevo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="12,0,12,12">
            <DataGrid x:Name="dgvClientes" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False"
                      HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                      MouseDoubleClick="dgvClientes_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✏️ Editar" Click="MenuItemEditar_Click"/>
                        <MenuItem Header="🗑️ Eliminar" Click="MenuItemEliminar_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CUIT" Binding="{Binding CUIT}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Razón social" Binding="{Binding RazonSocial}" Width="2*" MinWidth="160"/>
                    <DataGridTextColumn Header="Condición" Binding="{Binding CondicionIVA}" Width="Auto" MinWidth="140"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Domicilio" Binding="{Binding Direccion}" Width="1.5*" MinWidth="140"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.3*" MinWidth="140"/>
                    <DataGridCheckBoxColumn Header="Cta. cte." Binding="{Binding PermiteCuentaCorriente}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoDeuda, StringFormat=C2}" Width="Auto" MinWidth="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
