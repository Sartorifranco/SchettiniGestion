<UserControl x:Class="SchettiniGestion.WPF.ClientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Loaded="ClientesControl_Loaded">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*" MinWidth="220" MaxWidth="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="6.5*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Gestión Clientes" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CUIT / CUIL (Enter para buscar ARCA)" Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtCuit" Style="{DynamicResource ModernTextBox}" MaxLength="13" KeyDown="txtCuit_KeyDown" Margin="0,0,0,15"/>

                        <TextBlock Text="RAZÓN SOCIAL / NOMBRE" Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtRazonSocial" Style="{DynamicResource ModernTextBox}" MaxLength="200" Margin="0,0,0,15"/>

                        <TextBlock Text="CATEGORÍA FISCAL" Style="{DynamicResource LabelStyle}"/>
                        <ComboBox x:Name="cmbCondicionIVA" Style="{DynamicResource ModuleComboBoxStyle}" Margin="0,0,0,15">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="Consumidor Final"/>
                            <ComboBoxItem Content="Responsable Inscripto"/>
                            <ComboBoxItem Content="Monotributo"/>
                            <ComboBoxItem Content="Exento"/>
                        </ComboBox>

                        <TextBlock Text="TELÉFONO" Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtTelefono" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="DOMICILIO" Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtDireccion" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="EMAIL" Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtEmail" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,15"/>

                        <CheckBox x:Name="chkPermiteCtaCte" Content="Permite cuenta corriente" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Checked="chkPermiteCtaCte_Changed" Unchecked="chkPermiteCtaCte_Changed"/>
                        <TextBlock Text="MONTO LÍMITE CTA. CTE." Style="{DynamicResource LabelStyle}"/>
                        <TextBox x:Name="txtMontoLimiteCtaCte" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="LISTA DE PRECIOS" Style="{DynamicResource LabelStyle}"/>
                        <ComboBox x:Name="cmbListaPrecio" Style="{DynamicResource ModuleComboBoxStyle}"
                                  DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,0,0,15"/>
                        <TextBlock Text="Si el cliente tiene una lista (ej. mayorista), el POS la aplica al seleccionarlo."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                    <Button x:Name="btnNuevo" Content="✨ NUEVO" Style="{DynamicResource SecondaryButtonStyle}" Click="btnNuevo_Click" Margin="0,0,0,10"/>
                    <Button x:Name="btnGuardar" Content="💾 GUARDAR" Style="{DynamicResource ButtonStyle}" Click="btnGuardar_Click" Margin="0,0,0,10" Height="45"/>
                    <Button x:Name="btnEliminar" Content="🗑️ ELIMINAR" Style="{DynamicResource DeleteButtonStyle}" Click="btnEliminar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Buscar por CUIT o Razón Social" Style="{DynamicResource LabelStyle}"/>
                <TextBox x:Name="txtFiltroClientes" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,10" TextChanged="txtFiltroClientes_TextChanged"/>
                <DataGrid x:Name="dgvClientes" Grid.Row="1" Style="{DynamicResource {x:Type DataGrid}}" SelectionChanged="dgvClientes_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CUIT" Binding="{Binding CUIT}" Width="Auto" MinWidth="100"/>
                        <DataGridTextColumn Header="RAZÓN SOCIAL" Binding="{Binding RazonSocial}" Width="*"/>
                        <DataGridTextColumn Header="CONDICIÓN" Binding="{Binding CondicionIVA}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>