<UserControl x:Class="SchettiniGestion.WPF.CobranzasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundDark}"
             Loaded="Control_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cobranzas" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Estado de cobro por comprobante: cobrada al contado o pendiente en cuenta corriente."
                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <DatePicker x:Name="dpDesde" Grid.Column="1" MinWidth="170" MinHeight="48" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="Hasta" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <DatePicker x:Name="dpHasta" Grid.Column="3" MinWidth="170" MinHeight="48" HorizontalAlignment="Left" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <ComboBox x:Name="cmbEstado" Width="140" Style="{StaticResource ModuleComboBoxStyle}" Margin="0,0,10,0">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Cobrada"/>
                        <ComboBoxItem Content="Pendiente"/>
                    </ComboBox>
                    <Button Content="🔍 Actualizar" Style="{StaticResource ButtonStyle}" Padding="12,8" Click="btnActualizar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" x:Name="dgvCobranzas"
                  Style="{StaticResource ModuleDataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding FacturaID}" Width="55"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Comprobante" Binding="{Binding TipoComprobante}" Width="100"/>
                <DataGridTextColumn Header="Condición" Binding="{Binding CondicionVenta}" Width="110"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="110"/>
                <DataGridTextColumn Header="Cobrado" Binding="{Binding MontoCobrado, StringFormat=C2}" Width="110"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoCobro}" Width="95"/>
                <DataGridTextColumn Header="Medios / detalle" Binding="{Binding MediosCobro}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
