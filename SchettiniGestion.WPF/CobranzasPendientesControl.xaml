<UserControl x:Class="SchettiniGestion.WPF.CobranzasPendientesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundDark}"
             Loaded="Control_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Cobranzas Pendientes" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtFiltro" Style="{StaticResource ModernTextBox}" Width="250"
                         TextChanged="txtFiltro_TextChanged"/>
                <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" Margin="10,0,0,0" Padding="12,6" Click="btnBuscar_Click"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="dgvClientes"
                  Style="{StaticResource {x:Type DataGrid}}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CUIT" Binding="{Binding CUIT}" Width="120"/>
                <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocial}" Width="*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                <DataGridTextColumn Header="Saldo Deuda" Binding="{Binding SaldoDeuda, StringFormat=C2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceDark}" CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="TOTAL DEUDA:" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblTotalDeuda" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
