<Window x:Class="SchettiniGestion.WPF.CobroModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro"
        Width="560"
        Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CardCornerRadius}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Cobro de ventas"
                           FontFamily="{DynamicResource HeadlineFontFamily}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Width="40"
                        Height="40"
                        Click="btnCancelar_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Cerrar (Esc)"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceDark}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20,16"
                    Margin="0,0,0,16"
                    BorderBrush="{DynamicResource PrimaryColor}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Monto a cobrar"
                               FontFamily="{DynamicResource BodyFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTotalACobrar"
                               Grid.Column="1"
                               FontFamily="{DynamicResource HeadlineFontFamily}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryColor}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cobro rápido: un toque = confirma y cierra -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Medio de pago"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,10"/>
                <UniformGrid x:Name="panelCobroRapido" Columns="2"/>
                <Button x:Name="btnMercadoPagoPoint"
                        Content="💳 Point Smart"
                        Background="#009EE3"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        MinHeight="52"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        Click="btnMercadoPagoPoint_Click"/>
                <Button x:Name="btnMercadoPagoQR"
                        Content="📱 Mercado Pago QR"
                        Background="#009EE3"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        MinHeight="48"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        Click="btnMercadoPagoQR_Click"/>
            </StackPanel>

            <!-- Pago mixto / vuelto (opcional) -->
            <Expander Grid.Row="3"
                      Header="Pago mixto o con vuelto (opcional)"
                      IsExpanded="False"
                      Margin="0,0,0,10"
                      Foreground="{DynamicResource TextPrimary}">
                <StackPanel Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbMediosPago"
                                  Style="{StaticResource TouchComboBoxStyle}"
                                  SelectedValuePath="MedioID"
                                  Margin="0,0,8,0"
                                  SelectionChanged="cmbMediosPago_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontSize="15"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="txtMonto"
                                 Grid.Column="1"
                                 Style="{StaticResource ModuleTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 Text="0"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 KeyDown="txtMonto_KeyDown"/>
                        <Button x:Name="btnAgregarPago"
                                Grid.Column="2"
                                Content="+ Agregar"
                                Style="{StaticResource ButtonStyle}"
                                Click="btnAgregarPago_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceDark}"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,10,0,0"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            MinHeight="100"
                            MaxHeight="160">
                        <DataGrid x:Name="dgvCobranzas"
                                  Style="{StaticResource ModuleDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medio" Binding="{Binding nombreMedio}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding MontoFormateado}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,10,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Padding="4,2"
                                                    FontSize="11"
                                                    Click="btnQuitarCobro_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Expander>

            <Border Grid.Row="5"
                    Background="{DynamicResource BackgroundDark}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TOTAL COBRADO" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblTotalCobrado" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="PENDIENTE" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblPendiente" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="VUELTO" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblVuelto" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Height="52"
                        Click="btnCancelar_Click"/>
                <Button x:Name="btnConfirmar"
                        Grid.Column="1"
                        Content="Confirmar pago"
                        Style="{StaticResource ButtonStyle}"
                        Height="52"
                        FontSize="16"
                        Click="btnConfirmar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
