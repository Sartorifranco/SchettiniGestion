<Window x:Class="SchettiniGestion.WPF.CobroModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro"
        Width="580"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Cobro"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        Width="40"
                        Height="40"
                        Click="btnCancelar_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Cerrar"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceDark}"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,16"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TOTAL A COBRAR"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblTotalACobrar"
                               Grid.Column="1"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessColor}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceDark}"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Agregar medio de pago"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbMediosPago"
                                  Style="{StaticResource TouchComboBoxStyle}"
                                  SelectedValuePath="MedioID"
                                  Margin="0,0,8,0"
                                  SelectionChanged="cmbMediosPago_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontSize="15"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="txtMonto"
                                 Grid.Column="1"
                                 Style="{StaticResource ModuleTextBoxStyle}"
                                 Margin="0,0,8,0"
                                 Text="0"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 KeyDown="txtMonto_KeyDown"/>
                        <Button x:Name="btnAgregarPago"
                                Grid.Column="2"
                                Content="+ Agregar"
                                Style="{StaticResource ButtonStyle}"
                                Click="btnAgregarPago_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{DynamicResource SurfaceDark}"
                    CornerRadius="8"
                    Padding="4"
                    Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <DataGrid x:Name="dgvCobranzas"
                          Style="{StaticResource ModuleDataGridStyle}"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Medio de Pago" Binding="{Binding nombreMedio}" Width="*"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding MontoFormateado}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            Padding="4,2"
                                            FontSize="11"
                                            Click="btnQuitarCobro_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="4"
                    Background="{DynamicResource BackgroundDark}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TOTAL COBRADO" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblTotalCobrado" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="PENDIENTE" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblPendiente" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerColor}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="VUELTO" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblVuelto" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="5">
                <Button x:Name="btnMercadoPagoQR"
                        Content="📱 Cobrar con Mercado Pago QR"
                        Background="#009EE3"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="13"
                        MinHeight="44"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        Click="btnMercadoPagoQR_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="btnCancelar_Click"/>
                <Button x:Name="btnConfirmar"
                        Content="✔ Confirmar Cobro"
                        Style="{StaticResource ButtonStyle}"
                        Click="btnConfirmar_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
