<UserControl x:Class="SchettiniGestion.WPF.ComprasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Compras" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{DynamicResource PageSubtitleStyle}"
                   Text="Orden habitual: Orden de compra (opcional) → Factura → Recepción (ingresa stock) → Pagos. Las NC/ND de compras ajustan la deuda con el proveedor (no son facturas de venta ARCA)."/>
        <TabControl Grid.Row="2" x:Name="tabCompras" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,10,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Facturas de Compras -->
            <TabItem Header="📄 Facturas de Compras">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Carga del comprobante del proveedor (manual u OCR). El stock se ingresa en Recepción, no al guardar la factura."/>
                            <TextBox Grid.Row="1" x:Name="txtFiltroFacturas" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroFacturas_TextChanged"/>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="btnNuevaFacturaCompra" Content="➕ Nueva Factura" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevaFacturaCompra_Click"/>
                                <Button x:Name="btnEditarFacturaCompra" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarFacturaCompra_Click"/>
                                <Button x:Name="btnEliminarFacturaCompra" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarFacturaCompra_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvFacturasCompras" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="dgvFacturasCompras_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding CompraID}" Width="60"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoComprobante}" Width="110"/>
                                <DataGridTextColumn Header="OC" Binding="{Binding OrdenCompraID}" Width="55"/>
                                <DataGridCheckBoxColumn Header="Stock" Binding="{Binding StockRecibido}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Recepción de compras -->
            <TabItem Header="📦 Recepción de Compras">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Ingresá el stock de una factura de compra ya cargada. Sin recepción, los productos no aumentan el inventario."/>
                            <TextBox Grid.Row="1" x:Name="txtFiltroRecepciones" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroRecepciones_TextChanged"/>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="btnNuevaRecepcion" Content="➕ Nueva" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevaRecepcion_Click"/>
                                <Button x:Name="btnEditarRecepcion" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarRecepcion_Click"/>
                                <Button x:Name="btnEliminarRecepcion" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarRecepcion_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvRecepciones" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding RecepcionID}" Width="60"/>
                                <DataGridTextColumn Header="Compra" Binding="{Binding CompraID}" Width="80"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Notas de crédito/débito Compras -->
            <TabItem Header="📋 Notas Crédito/Débito Compras">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Ajustes con el proveedor: NC baja la deuda, ND la sube. No emite factura electrónica de venta."/>
                            <TextBox Grid.Row="1" x:Name="txtFiltroNotas" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroNotas_TextChanged"/>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="btnNuevaNota" Content="➕ Nueva" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevaNota_Click"/>
                                <Button x:Name="btnEditarNota" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarNota_Click"/>
                                <Button x:Name="btnEliminarNota" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarNota_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvNotas" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding NotaID}" Width="60"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="100"/>
                                <DataGridTextColumn Header="Nº Comp." Binding="{Binding NumeroComprobante}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Gastos Rápidos -->
            <TabItem Header="💸 Gastos Rápidos">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtFiltroGastos" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroGastos_TextChanged"/>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button x:Name="btnNuevoGasto" Content="➕ Nuevo" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevoGasto_Click"/>
                                <Button x:Name="btnEditarGasto" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarGasto_Click"/>
                                <Button x:Name="btnEliminarGasto" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarGasto_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvGastos" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding GastoID}" Width="60"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Pagos -->
            <TabItem Header="💳 Pagos">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtFiltroPagos" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroPagos_TextChanged"/>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button x:Name="btnNuevoPago" Content="➕ Nuevo" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevoPago_Click"/>
                                <Button x:Name="btnEditarPago" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarPago_Click"/>
                                <Button x:Name="btnEliminarPago" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarPago_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvPagos" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PagoID}" Width="60"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="100"/>
                                <DataGridTextColumn Header="Forma Pago" Binding="{Binding FormaPago}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Órdenes de Compras -->
            <TabItem Header="📑 Órdenes de Compras">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SaaSTableCard}" Padding="15" Margin="0,0,0,10">
                                                <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtFiltroOrdenes" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,8" TextChanged="txtFiltroOrdenes_TextChanged"/>
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <Button x:Name="btnNuevaOrden" Content="➕ Nueva" Style="{DynamicResource ButtonStyle}" Margin="0,0,8,4" Click="btnNuevaOrden_Click"/>
                                <Button x:Name="btnEditarOrden" Content="✏️ Editar" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,4" Click="btnEditarOrden_Click"/>
                                <Button x:Name="btnEliminarOrden" Content="🗑️ Eliminar" Style="{DynamicResource DeleteButtonStyle}" Margin="0,0,0,4" Click="btnEliminarOrden_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="10">
                        <DataGrid x:Name="dgvOrdenes" Style="{DynamicResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="dgvOrdenes_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding OrdenCompraID}" Width="60"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
