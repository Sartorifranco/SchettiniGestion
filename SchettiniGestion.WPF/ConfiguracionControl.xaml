                        <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,6"
                                   Text="Seleccioná un archivo y tocá Eliminar para quitarlo de la carpeta del visor. La etiqueta indica en qué panel se muestra."/>
