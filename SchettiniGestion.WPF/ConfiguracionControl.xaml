                            <TextBox x:Name="txtEtiquetaAltoMm" Width="70" Height="40" FontSize="14"
                                     VerticalContentAlignment="Center" Text="25"/>
                        </StackPanel>
                                <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardarImpresoras_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
