<UserControl x:Class="SchettiniGestion.WPF.ConfiguracionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="ConfiguracionControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ConfigSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="ConfigSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ConfigTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="3,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bdr" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource SurfaceDark}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,6,10,4">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,20">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Configuración del sistema" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Parámetros del negocio, conexión, licencia e impresoras."
                       Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource ConfigTabControlStyle}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ConfigTabItemStyle}"/>
            </TabControl.Resources>

            <TabItem Header="🏢 Negocio y AFIP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,8,8">

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Datos de la Empresa" Style="{StaticResource ConfigSectionTitle}"/>

                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre Fantasía:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtNombreFantasia" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Razón Social:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="CUIT:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Condición IVA:" Style="{StaticResource ModuleLabelStyle}"/>
                                <ComboBox x:Name="cmbCondicionIVAEmpresa" Style="{StaticResource TouchComboBoxStyle}" Height="44" FontSize="14" Margin="0,0,0,0">
                                    <ComboBoxItem Content="Responsable Inscripto"/>
                                    <ComboBoxItem Content="Monotributo"/>
                                    <ComboBoxItem Content="Exento"/>
                                    <ComboBoxItem Content="IVA No Alcanzado"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dirección:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Teléfono:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Email:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <!-- ══════════ LOGO DEL NEGOCIO ══════════ -->
                        <TextBlock Text="Logo del Negocio" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock Text="PNG, JPG o BMP recomendado. Se mostrará en los encabezados de impresión."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview del logo -->
                            <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5"
                                    Margin="0,0,20,0">
                                <Grid>
                                    <TextBlock x:Name="lblLogoPlaceholder" Text="Sin logo" FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="imgLogoPreview" Stretch="Uniform" Margin="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Controles -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="btnCargarLogo" Content="📁  Cargar logo"
                                            Style="{StaticResource ButtonStyle}" Padding="14,10"
                                            Click="btnCargarLogo_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="btnQuitarLogo" Content="✕  Quitar logo"
                                            Style="{StaticResource DeleteButtonStyle}" Padding="14,10"
                                            Click="btnQuitarLogo_Click"/>
                                </StackPanel>

                                <TextBlock Text="Mostrar logo en:" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chkLogoEnA4" Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                          Content="📄  Documentos A4 (facturas, presupuestos, remitos)"/>
                                <CheckBox x:Name="chkLogoEnTicket"
                                          Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                          Content="🧾  Tickets de caja (impresora 80 mm / 58 mm)"/>

                                <TextBlock x:Name="lblLogoRuta" Text="" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Caja y turnos" Style="{StaticResource ConfigSectionTitle}"/>
                        <CheckBox x:Name="chkUsaAperturaCaja"
                                  Content="¿Usa apertura y cierre de caja?"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="Si está activo, el sistema exige abrir la caja con el fondo fijo antes de vender. Si está inactivo, puede ir directo a la venta POS."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionAfip">
                        <TextBlock Text="Facturación Electrónica (AFIP)" Style="{StaticResource ConfigSectionTitle}"/>

                        <!-- Activación Fiscal AFIP/ARCA (CSR + certificado) -->
                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Activación Fiscal AFIP/ARCA" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"
                                           Text="Genere el pedido de certificado (CSR) desde el sistema, súbalo en AFIP/ARCA con su Clave Fiscal y luego importe aquí el .crt emitido. Usa los datos de empresa de arriba (CUIT, Razón Social, Nombre de Fantasía)."/>
                                <TextBlock x:Name="lblEstadoActivacionAfip" Foreground="{DynamicResource SuccessColor}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Button x:Name="btnGenerarCsrAfip" Content="🔐  Generar Pedido de Certificado (CSR)"
                                        Click="btnGenerarCsrAfip_Click"
                                        Style="{StaticResource ButtonStyle}" Padding="16,10"
                                        HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <TextBlock Text="Subir Certificado AFIP (.crt):" Style="{StaticResource ModuleLabelStyle}"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <Button x:Name="btnSubirCertificadoAfip" DockPanel.Dock="Right" Content="📂 Subir .crt"
                                            MinWidth="120" MinHeight="44" Margin="8,0,0,0"
                                            Click="btnSubirCertificadoAfip_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Importar certificado emitido por AFIP/ARCA"/>
                                    <TextBox x:Name="txtCertificadoCrtPath" Style="{StaticResource ModuleTextBoxStyle}"
                                             IsReadOnly="True" VerticalAlignment="Center"
                                             ToolTip="Ruta del certificado .crt guardado en el sistema"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,12"
                                           Text="El certificado debe corresponder al CSR generado en esta misma PC. La clave privada (.key) queda guardada de forma segura en el servidor."/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnProbarConexionAfip" Content="🔌  Probar conexión AFIP"
                                            Click="btnProbarConexionAfip_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                            MinHeight="44" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="pbProbarConexionAfip" Width="120" Height="6"
                                                 IsIndeterminate="True" Visibility="Collapsed"
                                                 Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,0"
                                           Text="Valida el par .key + .crt (o .pfx) contra WSAA en el ambiente configurado (homologación o producción)."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Alternativa: certificado .pfx existente" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Certificado Digital (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <Button x:Name="btnBuscarCertificado" DockPanel.Dock="Right" Content="📂" MinWidth="44" MinHeight="44"
                                            Margin="8,0,0,0" Click="btnBuscarCertificado_Click" Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Buscar certificado .pfx"/>
                                    <TextBox x:Name="txtCertificadoPath" Style="{StaticResource ModuleTextBoxStyle}" IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Contraseña del Certificado (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                                <PasswordBox x:Name="txtPasswordAfip" Style="{StaticResource PasswordBoxStyle}"
                                             PasswordChanged="txtPasswordAfip_PasswordChanged"/>
                                <TextBlock x:Name="lblHintPasswordAfip" Style="{StaticResource FieldHintTextStyle}" Margin="0,4,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Punto de Venta:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtPuntoVenta" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Tipo de cambio USD (para precios en dólares):" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTipoCambioUSD" Style="{StaticResource ModuleTextBoxStyle}"/>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="Ej: 1050 para $1050 por 1 USD"/>

                                <CheckBox x:Name="chkAfipProduccion" Content="Ambiente AFIP: producción (no homologación)"
                                          Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionMercadoPago">
                        <TextBlock Text="Integración Mercado Pago (QR)" Style="{StaticResource ConfigSectionTitle}"/>

                        <TextBlock Text="Access Token:" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtMPToken" Style="{StaticResource ModuleTextBoxStyle}"/>
                        <TextBlock Style="{StaticResource FieldHintTextStyle}"
                                   Text="Debe ser 'Production Access Token' (empieza con APP_USR-)."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="User ID:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtMPUserId" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Pos ID (Caja):" Style="{StaticResource ModuleLabelStyle}"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtMPPosId" Grid.Column="0" Style="{StaticResource ModuleTextBoxStyle}" VerticalAlignment="Center"/>

                                    <Button x:Name="btnBuscarCajas" Grid.Column="1"
                                            ToolTip="Buscar datos y cajas"
                                            Click="btnBuscarCajas_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="48" MinHeight="44" Padding="12,0" Margin="8,0,0,0" Cursor="Hand">
                                        <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="btnCrearCaja" Grid.Column="2"
                                            ToolTip="Crear caja 'SCH01' automáticamente"
                                            Click="btnCrearCaja_Click"
                                            Background="#009EE3" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            MinWidth="96" MinHeight="44" Padding="14,0" Margin="8,0,0,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🪄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Crear" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}"
                                           Text="Use 'Crear' para generar una caja compatible (SCH01)."/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionVisorCliente">
                        <TextBlock Text="Pantalla cliente (segundo monitor)" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="18"
                                   Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Si usa dos monitores y activó el modo en la barra principal, las publicidades rotan en el panel izquierdo (vertical) o en la franja inferior (horizontal) mientras no hay venta en curso."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="18"
                                   Margin="0,0,0,16" MaxWidth="900" HorizontalAlignment="Left" FontStyle="Italic"
                                   ToolTip="Recomendaciones de diseño para publicidades del visor cliente">
                            <Run Text="Recomendación: "/>
                            <Run Text="utilice imágenes o videos en formato vertical u horizontal (ej.: 1080×1080 px o 1080×1920 px). Formatos soportados: JPG, PNG, GIF, MP4 y AVI."/>
                        </TextBlock>

                        <TextBlock Text="Carpeta de promociones:" Style="{StaticResource ModuleLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtVisorPromoCarpeta" Grid.Column="0"
                                     Style="{StaticResource ModuleTextBoxStyle}"
                                     Margin="0,0,10,0"
                                     ToolTip="Ruta completa a la carpeta"/>
                            <Button x:Name="btnBuscarCarpetaPromo" Grid.Column="1"
                                    Content="📁" MinWidth="48" MinHeight="44" Padding="12,0"
                                    Click="btnBuscarCarpetaPromo_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="Elegir carpeta"/>
                        </Grid>

                        <TextBlock Text="Agregar archivo de promoción:" Style="{StaticResource ModuleLabelStyle}"/>
                        <DockPanel LastChildFill="True" Margin="0,0,0,12">
                            <Button x:Name="btnImportarImagen" DockPanel.Dock="Left" Content="Subir archivo"
                                    Click="btnImportarImagen_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,0"
                                    MinHeight="44" MinWidth="120"
                                    ToolTip="Copia imágenes (JPG, PNG, GIF) o videos (MP4, AVI) a la carpeta de publicidades"/>
                            <TextBox x:Name="txtRutaImagenPromocionImportada"
                                     Style="{StaticResource ModuleTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     ToolTip="Archivo seleccionado para copiar al guardar"/>
                        </DockPanel>

                        <TextBlock Text="Segundos entre cambios (imágenes estáticas, 3–120):" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtVisorPromoIntervalo" Style="{StaticResource ModuleTextBoxStyle}" Width="100" HorizontalAlignment="Left" Text="8" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="btnGuardarPromoVisor" Content="💾 Guardar promociones del visor"
                                    Click="btnGuardarPromoVisor_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                    Margin="0,0,10,0"/>
                            <Button x:Name="btnVistaPreviaVisor" Content="👁 Vista Previa de Pantalla"
                                    Click="btnVistaPreviaVisor_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                    ToolTip="Abre una ventana de prueba con el carrusel configurado (no requiere segundo monitor)"/>
                        </StackPanel>
                        </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardar" Content="💾 GUARDAR DATOS DEL NEGOCIO"
                                Click="btnGuardar_Click"
                                Background="#00A86B" Foreground="White" FontWeight="Bold" Height="50" Margin="0,30,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="tabItemRedServidor" Header="📡 Red y Servidor">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Configuración de conexión" Style="{StaticResource ConfigSectionTitle}"/>

                                <TextBlock Text="Esta PC funciona como:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cmbModoPC" Style="{StaticResource ModuleComboBoxStyle}" SelectionChanged="cmbModoPC_SelectionChanged" Margin="0,0,0,16">
                                    <ComboBoxItem Content="SERVIDOR (Principal)" IsSelected="True"/>
                                    <ComboBoxItem Content="CLIENTE (Puesto de Red)"/>
                                </ComboBox>

                                <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Dirección IP del Servidor:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtIpServidor" Style="{StaticResource ModuleTextBoxStyle}" Text="127.0.0.1"/>
                                <TextBlock Text="(Ej: 192.168.0.141 o 127.0.0.1 o .\SQLEXPRESS)" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Text="Puerto SQL:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtPuertoServidor" Style="{StaticResource ModuleTextBoxStyle}" Text="1433"/>

                                <CheckBox x:Name="chkUsarWindowsAuth" Content="Usar autenticación Windows (recomendado para PC principal)" Foreground="{DynamicResource TextSecondary}" Margin="0,15,0,0" Checked="chkUsarWindowsAuth_Changed" Unchecked="chkUsarWindowsAuth_Changed"/>

                                <Border x:Name="pnlCredencialesSQL" Margin="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,15"/>
                                        <TextBlock Text="Usuario SQL (solo si no usa Windows):" Style="{StaticResource ModuleLabelStyle}"/>
                                        <TextBox x:Name="txtUsuarioSQL" Style="{StaticResource ModuleTextBoxStyle}" Text="Sistema"/>
                                        <TextBlock Text="Contraseña SQL:" Style="{StaticResource ModuleLabelStyle}"/>
                                        <PasswordBox x:Name="txtPasswordSQL" Height="35" Style="{StaticResource PasswordBoxStyle}" Padding="5" Margin="0,0,0,15"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardarConexion" Content="💾 GUARDAR Y REINICIAR" 
                                Click="btnGuardarConexion_Click"
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Height="50" Margin="0,4,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource ConfigSectionCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Instrucciones" Style="{StaticResource ConfigSectionTitle}" Foreground="Orange"/>
                        <TextBlock Text="• MODO SERVIDOR: Si esta es la PC principal, deje la IP en 127.0.0.1 o un punto (.)." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="• MODO CLIENTE: Si esta PC se conecta a otra, escriba la IP de la otra computadora (Ej: 192.168.1.100)." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="• AL GUARDAR: El sistema se cerrará automáticamente para aplicar la nueva conexión." Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <TextBlock Text="Datos Técnicos" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,20,0,8"/>
                        <TextBlock Text="Base de Datos: SchPosDB" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Usuario Predeterminado: Sistema" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Puerto Estándar: 1433" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🔑 Licencia">
                <Border Style="{StaticResource ConfigSectionCard}" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Activación de producto" Style="{StaticResource ConfigSectionTitle}"/>

                        <TextBlock Text="Estado Actual:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="lblEstadoLicencia" Text="Verificando..." Foreground="{DynamicResource SuccessColor}" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Vencimiento:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="lblVencimiento" Text="-" Foreground="{DynamicResource TextPrimary}" FontSize="16" Margin="0,0,0,20"/>

                        <TextBlock Text="Clave de Licencia (Pegar aquí):" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtLicenciaKey" Style="{StaticResource ModuleTextBoxStyle}" Height="100" TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="True"/>

                        <Button x:Name="btnActivarLicencia" Content="✅ VALIDAR Y ACTIVAR" 
                                Click="btnActivarLicencia_Click"
                                Background="#E0A800" Foreground="Black" FontWeight="Bold" Height="50" Margin="0,20,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="🧰 Mantenimiento">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,8,8">
                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Generar copia de seguridad" Style="{StaticResource ConfigSectionTitle}" Foreground="{DynamicResource SuccessColor}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"
                                   Text="Guarda todos los datos (clientes, productos, ventas) en un archivo .bak. Guardalo en un pendrive o en la nube."/>
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,16"
                                   Text="⚠ El archivo se genera en el servidor SQL. Elegí una carpeta accesible desde esa PC (ej: C:\Backups o el escritorio del servidor)."/>
                        <Button x:Name="btnGenerarBackup" Content="💾  Generar copia de seguridad"
                                Style="{StaticResource ButtonStyle}" Padding="20,12" HorizontalAlignment="Left"
                                Click="btnGenerarBackup_Click"/>
                        <TextBlock Text="✔ Recomendado: al menos una vez por semana."
                                   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Restaurar copia de seguridad" Style="{StaticResource ConfigSectionTitle}" Foreground="#E57373"/>
                        <Border Background="#FFF3E0" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" FontSize="13">
                                <Run FontWeight="Bold" Foreground="#E65100">⚠ ATENCIÓN:</Run>
                                <Run Foreground="#BF360C"> Restaurar reemplaza TODOS los datos actuales con los del archivo de backup. Esta acción no se puede deshacer. El sistema se cerrará automáticamente al terminar para reconectar.</Run>
                            </TextBlock>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                                   Text="Seleccioná el archivo .bak generado previamente por este sistema para restaurar la base de datos."/>
                        <Button x:Name="btnRestaurarBackup" Content="📂  Restaurar desde archivo .bak"
                                Style="{StaticResource DeleteButtonStyle}" Padding="20,12" HorizontalAlignment="Left"
                                Click="btnRestaurarBackup_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🖨️ Impresoras">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="0,4,8,8">

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Impresoras instaladas" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"
                                   Text="Seleccioná la impresora para cada tipo de documento. Si dejás vacío, el sistema mostrará el diálogo de selección cada vez."/>

                        <TextBlock Text="Impresora de Tickets (POS / Recibos)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"
                                   Text="Usada al cobrar una venta, cierre de caja, etc. Generalmente una impresora térmica de 80 mm."/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbImpresoraTicket" Grid.Column="0"
                                      Style="{StaticResource TouchComboBoxStyle}"
                                      Height="44" FontSize="14" Margin="0,0,8,0"/>
                            <Button x:Name="btnTestTicket" Grid.Column="1"
                                    Content="🖨️ Probar" Padding="14,10"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="btnTestTicket_Click"/>
                        </Grid>

                        <TextBlock Text="Impresora A4 (Facturas, Presupuestos, Remitos)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"
                                   Text="Usada para imprimir documentos tamaño A4."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cmbImpresoraA4" Grid.Column="0"
                                      Style="{StaticResource TouchComboBoxStyle}"
                                      Height="44" FontSize="14" Margin="0,0,8,0"/>
                            <Button x:Name="btnTestA4" Grid.Column="1"
                                    Content="🖨️ Probar" Padding="14,10"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="btnTestA4_Click"/>
                        </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Comportamiento al emitir" Style="{StaticResource ConfigSectionTitle}"/>

                        <CheckBox x:Name="chkPreguntarAntesImprimir"
                                  Content="Preguntar antes de imprimir tras cada venta o documento"
                                  IsChecked="True"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,16"
                                   Text="Si desmarcás esta opción y tenés impresora configurada, el comprobante se enviará directo a la impresora sin preguntar."/>

                        <TextBlock Text="Destino al cobrar (ventas)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"
                                   Text="Elegí cómo se emite el comprobante al finalizar una venta. Si elegís A4, se imprime en formato documento (no ticket estrecho)."/>
                        <ComboBox x:Name="cmbDestinoImpresionVenta"
                                  Style="{StaticResource TouchComboBoxStyle}"
                                  Height="44" FontSize="14" Margin="0,0,0,16"/>

                        <TextBlock Text="Ancho del papel térmico" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbAnchoTicketMm"
                                  Style="{StaticResource TouchComboBoxStyle}"
                                  Height="44" FontSize="14" Margin="0,0,0,16"/>

                        <TextBlock Text="Carpeta para PDF de comprobantes (opcional)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"
                                   Text="Si elegís guardar como PDF, el archivo se guardará aquí. Si queda vacío, se pedirá ubicación cada vez."/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCarpetaArchivosComprobantes" Grid.Column="0"
                                     Height="44" FontSize="14" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"/>
                            <Button x:Name="btnElegirCarpetaComprobantes" Grid.Column="1"
                                    Content="📁 Elegir" Padding="14,10"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="btnElegirCarpetaComprobantes_Click"/>
                        </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Contenido del ticket térmico" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Marcá qué datos querés que aparezcan en el ticket. El logo se configura en la pestaña Negocio y AFIP."/>
                        <WrapPanel Margin="0,0,0,20">
                            <CheckBox x:Name="chkTicketLogo" Content="Logo" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketDireccion" Content="Dirección" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketTelefono" Content="Teléfono" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketCuit" Content="CUIT" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketCliente" Content="Cliente" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketCodigo" Content="Código de producto" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketFormaPago" Content="Forma de pago" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketPieFiscal" Content="Pie fiscal (CAE)" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketGracias" Content="Mensaje de cierre" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketPuntoVenta" Content="Punto de venta" IsChecked="True" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                            <CheckBox x:Name="chkTicketVendedor" Content="Vendedor / cajero que cobró" Margin="0,0,20,8" Foreground="{DynamicResource TextPrimary}"/>
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,0"
                                   Text="El número de punto de venta se configura en la pestaña «Negocio y AFIP». El vendedor/cajero es el «Nombre del personal» del usuario que inició sesión (Usuarios)."/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardarImpresoras" Content="💾 Guardar configuración de impresoras"
                                Style="{StaticResource ButtonStyle}" Padding="20,12" HorizontalAlignment="Left"
                                Click="btnGuardarImpresoras_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="💳 Medios de Pago">
                <Border Style="{StaticResource ConfigSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Medios de pago" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock Text="Configure los medios de pago disponibles para cobros." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>
                        <DataGrid x:Name="dgvMediosPago" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserReorderColumns="True" CanUserResizeColumns="True"
                                  Height="300" Margin="0,0,0,10"
                                  Background="{DynamicResource SurfaceDark}" RowBackground="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444">
                            <DataGrid.Resources>
                                <Style x:Key="MedioPagoHeaderCentered" TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BackgroundDark}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MedioPagoID}" Width="50" MinWidth="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" MinWidth="140"/>
                                <DataGridTemplateColumn Header="Activo" Width="72" MinWidth="72" CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MedioPagoHeaderCentered}"/>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Activo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" Width="64" MinWidth="64">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MedioPagoHeaderCentered}"/>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Acción" Width="100" MinWidth="100" CanUserResize="True">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MedioPagoHeaderCentered}"/>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Guardar" Click="btnGuardarMedioPago_Click" Background="#27AE60" Foreground="White" Padding="5,2" Margin="2"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnNuevoMedioPago" Content="➕ Nuevo medio de pago" Click="btnNuevoMedioPago_Click"
                                    Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>