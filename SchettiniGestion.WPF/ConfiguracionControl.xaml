<UserControl x:Class="SchettiniGestion.WPF.ConfiguracionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="ConfiguracionControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="ConfigSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="ConfigSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="ConfigTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="3,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bdr" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource SurfaceDark}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,6,10,4">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,20">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Configuración del sistema" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Parámetros del negocio, conexión, licencia e impresoras."
                       Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource ConfigTabControlStyle}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ConfigTabItemStyle}"/>
            </TabControl.Resources>

            <TabItem Header="🏢 Negocio y ARCA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,8,8">

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Datos de la Empresa" Style="{StaticResource ConfigSectionTitle}"/>

                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre Fantasía:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtNombreFantasia" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Razón Social:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="CUIT:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Condición IVA:" Style="{StaticResource ModuleLabelStyle}"/>
                                <ComboBox x:Name="cmbCondicionIVAEmpresa" Style="{StaticResource TouchComboBoxStyle}" Height="44" FontSize="14" Margin="0,0,0,0">
                                    <ComboBoxItem Content="Responsable Inscripto"/>
                                    <ComboBoxItem Content="Monotributo"/>
                                    <ComboBoxItem Content="Exento"/>
                                    <ComboBoxItem Content="IVA No Alcanzado"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dirección:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Teléfono:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Email:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                                <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <!-- ══════════ LOGO DEL NEGOCIO ══════════ -->
                        <TextBlock Text="Logo del Negocio" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock Text="PNG, JPG o BMP recomendado. Se mostrará en los encabezados de impresión."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview del logo -->
                            <Border Grid.Column="0" Width="160" Height="120" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5"
                                    Margin="0,0,20,0">
                                <Grid>
                                    <TextBlock x:Name="lblLogoPlaceholder" Text="Sin logo" FontSize="13"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="imgLogoPreview" Stretch="Uniform" Margin="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Controles -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="btnCargarLogo" Content="📁  Cargar logo"
                                            Style="{StaticResource ButtonStyle}" Padding="14,10"
                                            Click="btnCargarLogo_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="btnQuitarLogo" Content="✕  Quitar logo"
                                            Style="{StaticResource DeleteButtonStyle}" Padding="14,10"
                                            Click="btnQuitarLogo_Click"/>
                                </StackPanel>

                                <TextBlock Text="Mostrar logo en:" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chkLogoEnA4" Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                          Content="📄  Documentos A4 (facturas, presupuestos, remitos)"/>
                                <CheckBox x:Name="chkLogoEnTicket"
                                          Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                          Content="🧾  Tickets de caja (impresora 80 mm / 58 mm)"/>

                                <TextBlock x:Name="lblLogoRuta" Text="" FontSize="11" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Grid>
                                <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                            <StackPanel>
                        <TextBlock Text="Caja y turnos" Style="{StaticResource ConfigSectionTitle}"/>
                        <CheckBox x:Name="chkUsaAperturaCaja"
                                  Content="¿Usa apertura y cierre de caja?"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="Si está activo, el sistema exige abrir la caja con el fondo fijo antes de vender. Si está inactivo, puede ir directo a la venta POS."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionAfip">
                        <TextBlock Text="Facturación Electrónica (ARCA)" Style="{StaticResource ConfigSectionTitle}"/>

                        <!-- Activación Fiscal ARCA (CSR + certificado) -->
                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Activación Fiscal ARCA" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"
                                           Text="Genere el pedido de certificado (CSR) desde el sistema, súbalo en ARCA con su Clave Fiscal y luego importe aquí el .crt emitido. Usa los datos de empresa de arriba (CUIT, Razón Social, Nombre de Fantasía)."/>
                                <TextBlock x:Name="lblEstadoActivacionAfip" Foreground="{DynamicResource SuccessColor}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Button x:Name="btnGenerarCsrAfip" Content="🔐  Generar Pedido de Certificado (CSR)"
                                        Click="btnGenerarCsrAfip_Click"
                                        Style="{StaticResource ButtonStyle}" Padding="16,10"
                                        HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <TextBlock Text="Subir Certificado ARCA (.crt):" Style="{StaticResource ModuleLabelStyle}"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <Button x:Name="btnSubirCertificadoAfip" DockPanel.Dock="Right" Content="📂 Subir .crt"
                                            MinWidth="120" MinHeight="44" Margin="8,0,0,0"
                                            Click="btnSubirCertificadoAfip_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Importar certificado emitido por ARCA"/>
                                    <TextBox x:Name="txtCertificadoCrtPath" Style="{StaticResource ModuleTextBoxStyle}"
                                             IsReadOnly="True" VerticalAlignment="Center"
                                             ToolTip="Ruta del certificado .crt guardado en el sistema"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,12"
                                           Text="El certificado debe corresponder al CSR generado en esta misma PC. La clave privada (.key) queda guardada de forma segura en el servidor."/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnProbarConexionAfip" Content="🔌  Probar conexión ARCA"
                                            Click="btnProbarConexionAfip_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                            MinHeight="44" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="pbProbarConexionAfip" Width="120" Height="6"
                                                 IsIndeterminate="True" Visibility="Collapsed"
                                                 Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,0"
                                           Text="Valida el par .key + .crt (o .pfx) contra WSAA en el ambiente configurado (homologación o producción)."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Alternativa: certificado .pfx existente" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Certificado Digital (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                    <Button x:Name="btnBuscarCertificado" DockPanel.Dock="Right" Content="📂" MinWidth="44" MinHeight="44"
                                            Margin="8,0,0,0" Click="btnBuscarCertificado_Click" Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="Buscar certificado .pfx"/>
                                    <TextBox x:Name="txtCertificadoPath" Style="{StaticResource ModuleTextBoxStyle}" IsReadOnly="True"
                                             VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Contraseña del Certificado (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                                <PasswordBox x:Name="txtPasswordAfip" Style="{StaticResource PasswordBoxStyle}"
                                             PasswordChanged="txtPasswordAfip_PasswordChanged"/>
                                <TextBlock x:Name="lblHintPasswordAfip" Style="{StaticResource FieldHintTextStyle}" Margin="0,4,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Punto de Venta:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtPuntoVenta" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Tipo de cambio USD (para precios en dólares):" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTipoCambioUSD" Style="{StaticResource ModuleTextBoxStyle}"/>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}" Text="Ej: 1050 para $1050 por 1 USD"/>

                                <CheckBox x:Name="chkAfipProduccion" Content="Ambiente ARCA: producción (no homologación)"
                                          Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                        </StackPanel>
                        </Border>

                        <Border x:Name="cardSeccionMercadoPagoCuenta" Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionMercadoPagoCuenta">
                        <TextBlock Text="Cuenta Mercado Pago" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,0,12"
                                   Text="Access Token compartido. Se usa para el servicio QR y/o Point Smart según lo contratado en la licencia."/>

                        <TextBlock Text="Access Token:" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtMPToken" Style="{StaticResource ModuleTextBoxStyle}"/>
                        <TextBlock Style="{StaticResource FieldHintTextStyle}"
                                   Text="Debe ser 'Production Access Token' (empieza con APP_USR-)."/>
                        <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,10,0,0" Click="btnGuardar_Click"/>
                        </StackPanel>
                        </Border>

                        <Border x:Name="cardSeccionMercadoPagoQr" Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionMercadoPagoQr">
                        <TextBlock Text="Mercado Pago QR (cobro con código QR)" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,0,12"
                                   Text="Servicio independiente: genera órdenes QR para que el cliente pague con la app de Mercado Pago."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="User ID:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtMPUserId" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Pos ID (Caja):" Style="{StaticResource ModuleLabelStyle}"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtMPPosId" Grid.Column="0" Style="{StaticResource ModuleTextBoxStyle}" VerticalAlignment="Center"/>

                                    <Button x:Name="btnBuscarCajas" Grid.Column="1"
                                            ToolTip="Buscar datos y cajas"
                                            Click="btnBuscarCajas_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            MinWidth="48" MinHeight="44" Padding="12,0" Margin="8,0,0,0" Cursor="Hand">
                                        <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center"/>
                                    </Button>

                                    <Button x:Name="btnCrearCaja" Grid.Column="2"
                                            ToolTip="Crear caja 'SCH01' automáticamente"
                                            Click="btnCrearCaja_Click"
                                            Background="#009EE3" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            MinWidth="96" MinHeight="44" Padding="14,0" Margin="8,0,0,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🪄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Crear" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHintTextStyle}"
                                           Text="Use 'Crear' para generar una caja compatible (SCH01)."/>
                            </StackPanel>
                        </Grid>
                        <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                        </StackPanel>
                        </Border>

                        <Border x:Name="cardSeccionMercadoPagoPoint" Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionMercadoPagoPoint">
                            <TextBlock Text="Mercado Pago Point Smart (terminal)" Style="{StaticResource ConfigSectionTitle}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       Margin="0,0,0,12"
                                       Text="Servicio independiente: envía el importe al Point Smart/Smart 2 y espera la aprobación. El cobro manual con cualquier posnet sigue disponible."/>

                            <TextBlock Text="Terminal vinculada:" Style="{StaticResource ModuleLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbMPPointTerminal" Grid.Column="0"
                                          Style="{StaticResource TouchComboBoxStyle}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          MinHeight="44"/>
                                <Button x:Name="btnBuscarTerminalesPoint" Grid.Column="1"
                                        Content="🔍 Buscar terminales"
                                        Click="btnBuscarTerminalesPoint_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="44" Margin="8,0,0,0"/>
                                <Button x:Name="btnActivarModoPdv" Grid.Column="2"
                                        Content="Activar modo PDV"
                                        Click="btnActivarModoPdv_Click"
                                        Background="#009EE3" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                        MinHeight="44" Padding="16,0" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,6,0,8"
                                       Text="La terminal debe estar vinculada a esta cuenta. Modelos admitidos por la API: Point Smart (NEWLAND N950) y Smart 2 (PAX A910)."/>
                            <CheckBox x:Name="chkMPPointAutomatico"
                                      Content="Ofrecer cobro automático con Point en la ventana de cobro"
                                      IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                            <Button Content="💾 Guardar cambios de esta sección" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right" Margin="0,14,0,0" Click="btnGuardar_Click"/>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConfigSectionCard}">
                        <StackPanel x:Name="panelSeccionVisorCliente">
                        <TextBlock Text="Pantalla cliente (segundo monitor)" Style="{StaticResource ConfigSectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="18"
                                   Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="Activá el modo en la barra principal. Hay dos espacios independientes: imagen promocional (izquierda) y banner (abajo), cada uno con su propio archivo y su propio tiempo entre cambios. El logo del negocio no se muestra en el visor para aprovechar toda el área."/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna IZQUIERDA: imagen promocional vertical -->
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="⬅ Imagen promocional — IZQUIERDA" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <Border Background="#1E3A5F" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#7FC4FF"
                                                   Text="📍 Lo que subas acá se mostrará del lado IZQUIERDO de la pantalla del cliente."/>
                                    </Border>
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,10"
                                               Text="Ideal 1080×1920 px (vertical) o 1080×1080. Acepta imagen y video."/>

                                    <TextBlock Text="Subir imagen o video para la izquierda:" Style="{StaticResource ModuleLabelStyle}"/>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <Button x:Name="btnImportarImagen" DockPanel.Dock="Left" Content="Subir a IZQUIERDA"
                                                Click="btnImportarImagen_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="14,0"
                                                MinHeight="44" MinWidth="150"
                                                ToolTip="Copia JPG, PNG, GIF, MP4 o AVI a la carpeta y lo asigna al panel izquierdo"/>
                                        <TextBox x:Name="txtRutaImagenPromocionImportada"
                                                 Style="{StaticResource ModuleTextBoxStyle}"
                                                 VerticalContentAlignment="Center"
                                                 IsReadOnly="True"
                                                 ToolTip="Archivo seleccionado para copiar al guardar (panel izquierdo)"/>
                                    </DockPanel>

                                    <TextBlock Text="Segundos entre cambios — izquierda (3–120):" Style="{StaticResource ModuleLabelStyle}"/>
                                    <TextBox x:Name="txtVisorPromoIntervalo" Style="{StaticResource ModuleTextBoxStyle}" Width="100" HorizontalAlignment="Left" Text="8"/>
                                </StackPanel>
                            </Border>

                            <!-- Columna DERECHA/ABAJO: banner horizontal -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="⬇ Banner — ABAJO" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <Border Background="#3A2E1E" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#FFC876"
                                                   Text="📍 Lo que subas acá se mostrará en la franja INFERIOR (abajo) de la pantalla del cliente."/>
                                    </Border>
                                    <TextBlock Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,10"
