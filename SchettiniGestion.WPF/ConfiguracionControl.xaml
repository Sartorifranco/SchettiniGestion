                                     BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button x:Name="btnEliminarArchivoVisor" Content="🗑 Eliminar"
                                        Click="btnEliminarArchivoVisor_Click"
                                        Background="#C0392B" Foreground="White" FontWeight="SemiBold"
                                        Padding="14,10" MinHeight="44" Margin="0,0,0,8"
                                        ToolTip="Elimina el archivo seleccionado de la carpeta"/>
                                <Button x:Name="btnRefrescarArchivosVisor" Content="↻ Actualizar"
                                        Click="btnRefrescarArchivosVisor_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,10" MinHeight="44"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="btnGuardarPromoVisor" Content="💾 Guardar promociones del visor"
                                    Click="btnGuardarPromoVisor_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                    Margin="0,0,10,0"/>
                            <Button x:Name="btnVistaPreviaVisor" Content="👁 Vista Previa de Pantalla"
                                    Click="btnVistaPreviaVisor_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                                    ToolTip="Abre una ventana de prueba con el carrusel configurado (no requiere segundo monitor)"/>
                        </StackPanel>
                        </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardar" Content="💾 GUARDAR DATOS DEL NEGOCIO"
                                Click="btnGuardar_Click"
                                Background="#00A86B" Foreground="White" FontWeight="Bold" Height="50" Margin="0,30,0,0">
