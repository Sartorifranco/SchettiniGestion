                            <Button x:Name="btnTestEtiquetas" Grid.Column="1"
                                    Content="🖨️ Probar" Padding="14,10"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="btnTestEtiquetas_Click"/>
                        </Grid>
                        <TextBlock Text="Medida de la etiqueta" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbMedidaEtiqueta" Style="{StaticResource TouchComboBoxStyle}"
                                  Height="44" FontSize="14" Margin="0,0,0,8"
                                  SelectionChanged="cmbMedidaEtiqueta_SelectionChanged"/>
                        <StackPanel x:Name="pnlMedidaEtiquetaCustom" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,4">
