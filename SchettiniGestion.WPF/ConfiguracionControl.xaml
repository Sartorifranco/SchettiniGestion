<UserControl x:Class="SchettiniGestion.WPF.ConfiguracionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="ConfiguracionControl_Loaded">

    <Grid Margin="20">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#AAA"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="🏢 Negocio y AFIP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0">
                        <TextBlock Text="Datos de la Empresa" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" FontWeight="Bold"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nombre Fantasía:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtNombreFantasia" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Razón Social:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="CUIT:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dirección:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Teléfono:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Email:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderColor}" Margin="0,20"/>

                        <TextBlock Text="Facturación Electrónica (AFIP)" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" FontWeight="Bold"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Certificado Digital (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                                <DockPanel>
                                    <Button x:Name="btnBuscarCertificado" Content="📂" Width="40" Click="btnBuscarCertificado_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <TextBox x:Name="txtCertificadoPath" Style="{StaticResource ModuleTextBoxStyle}" IsReadOnly="True"/>
                                </DockPanel>

                                <TextBlock Text="Contraseña del Certificado:" Style="{StaticResource ModuleLabelStyle}"/>
                                <PasswordBox x:Name="txtPasswordAfip" Height="35" Style="{StaticResource PasswordBoxStyle}" Padding="5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Punto de Venta:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtPuntoVenta" Style="{StaticResource ModuleTextBoxStyle}"/>

                                <TextBlock Text="Tipo de cambio USD (para precios en dólares):" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtTipoCambioUSD" Style="{StaticResource ModuleTextBoxStyle}"/>
                                <TextBlock Text="Ej: 1050 para $1050 por 1 USD" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,-5,0,0"/>

                                <CheckBox x:Name="chkAfipProduccion" Content="Ambiente AFIP: producción (no homologación)" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderColor}" Margin="0,20"/>

                        <TextBlock Text="Integración Mercado Pago (QR)" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" FontWeight="Bold"/>

                        <TextBlock Text="Access Token:" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtMPToken" Style="{StaticResource ModuleTextBoxStyle}"/>
                        <TextBlock Text="Debe ser 'Production Access Token' (empieza con APP_USR-)" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,-5,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="User ID:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtMPUserId" Style="{StaticResource ModuleTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Pos ID (Caja):" Style="{StaticResource ModuleLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtMPPosId" Grid.Column="0" Style="{StaticResource ModuleTextBoxStyle}"/>

                                    <Button x:Name="btnBuscarCajas" Grid.Column="1" Content="🔍" 
                                            ToolTip="Buscar datos y cajas"
                                            Click="btnBuscarCajas_Click"
                                            Background="#334155" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                                            Width="35" Height="35" Margin="5,0,0,5" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button x:Name="btnCrearCaja" Grid.Column="2" Content="🪄 Crear" 
                                            ToolTip="Crear caja 'SCH01' automáticamente"
                                            Click="btnCrearCaja_Click"
                                            Background="#009EE3" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                            Width="60" Height="35" Margin="5,0,0,5" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Use 'Crear' para generar una caja compatible (SCH01)." Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,-5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{DynamicResource BorderColor}" Margin="0,24,0,16"/>
                        <TextBlock Text="Pantalla cliente (segundo monitor)" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Si usa dos monitores y activó el modo en la barra principal, aquí puede indicar una carpeta con archivos para rotar en la pantalla del cliente mientras no hay venta en curso. Deje la carpeta vacía para mostrar solo el logo. Formatos: JPG, PNG, BMP, GIF animado y videos cortos (MP4, WMV, AVI)."/>

                        <TextBlock Text="Carpeta de promociones (opcional):" Style="{StaticResource ModuleLabelStyle}"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="btnBuscarCarpetaPromo" DockPanel.Dock="Right" Content="📁" Width="44" Margin="8,0,0,0"
                                    Click="btnBuscarCarpetaPromo_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Elegir carpeta"/>
                            <TextBox x:Name="txtVisorPromoCarpeta" Style="{StaticResource ModuleTextBoxStyle}" ToolTip="Ruta completa a la carpeta"/>
                        </DockPanel>

                        <TextBlock Text="Segundos entre cambios (imágenes estáticas, 3–120):" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtVisorPromoIntervalo" Style="{StaticResource ModuleTextBoxStyle}" Width="100" HorizontalAlignment="Left" Text="8" Margin="0,0,0,12"/>

                        <Button x:Name="btnGuardarPromoVisor" Content="💾 Guardar promociones del visor" Click="btnGuardarPromoVisor_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <Button x:Name="btnGuardar" Content="💾 GUARDAR DATOS DEL NEGOCIO" 
                                Click="btnGuardar_Click"
                                Background="#00A86B" Foreground="White" FontWeight="Bold" Height="50" Margin="0,30,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📡 Red y Servidor">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="CONFIGURACIÓN DE CONEXIÓN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                        <TextBlock Text="Esta PC funciona como:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbModoPC" Style="{StaticResource ModuleComboBoxStyle}" SelectionChanged="cmbModoPC_SelectionChanged" Margin="0,0,0,20">
                            <ComboBoxItem Content="SERVIDOR (Principal)" IsSelected="True"/>
                            <ComboBoxItem Content="CLIENTE (Puesto de Red)"/>
                        </ComboBox>

                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="5" Padding="15" BorderBrush="#444" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Dirección IP del Servidor:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtIpServidor" Style="{StaticResource ModuleTextBoxStyle}" Text="127.0.0.1"/>
                                <TextBlock Text="(Ej: 192.168.0.141 o 127.0.0.1 o .\SQLEXPRESS)" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Text="Puerto SQL:" Style="{StaticResource ModuleLabelStyle}"/>
                                <TextBox x:Name="txtPuertoServidor" Style="{StaticResource ModuleTextBoxStyle}" Text="1433"/>

                                <CheckBox x:Name="chkUsarWindowsAuth" Content="Usar autenticación Windows (recomendado para PC principal)" Foreground="{DynamicResource TextSecondary}" Margin="0,15,0,0" Checked="chkUsarWindowsAuth_Changed" Unchecked="chkUsarWindowsAuth_Changed"/>

                                <Border x:Name="pnlCredencialesSQL" Margin="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,15"/>
                                        <TextBlock Text="Usuario SQL (solo si no usa Windows):" Style="{StaticResource ModuleLabelStyle}"/>
                                        <TextBox x:Name="txtUsuarioSQL" Style="{StaticResource ModuleTextBoxStyle}" Text="Sistema"/>
                                        <TextBlock Text="Contraseña SQL:" Style="{StaticResource ModuleLabelStyle}"/>
                                        <PasswordBox x:Name="txtPasswordSQL" Height="35" Style="{StaticResource PasswordBoxStyle}" Padding="5" Margin="0,0,0,15"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnGuardarConexion" Content="💾 GUARDAR Y REINICIAR" 
                                Click="btnGuardarConexion_Click"
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Height="50" Margin="0,20,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Instrucciones:" FontSize="18" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,10"/>
                        <TextBlock Text="• MODO SERVIDOR: Si esta es la PC principal, deje la IP en 127.0.0.1 o un punto (.)." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="• MODO CLIENTE: Si esta PC se conecta a otra, escriba la IP de la otra computadora (Ej: 192.168.1.100)." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="• AL GUARDAR: El sistema se cerrará automáticamente para aplicar la nueva conexión." Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <TextBlock Text="Datos Técnicos:" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,20,0,5"/>
                        <TextBlock Text="Base de Datos: SchPosDB" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Usuario Predeterminado: Sistema" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Puerto Estándar: 1433" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🔑 Licencia">
                <Grid Margin="0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="ACTIVACIÓN DE PRODUCTO" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                        <TextBlock Text="Estado Actual:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="lblEstadoLicencia" Text="Verificando..." Foreground="{DynamicResource SuccessColor}" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Vencimiento:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="lblVencimiento" Text="-" Foreground="{DynamicResource TextPrimary}" FontSize="16" Margin="0,0,0,20"/>

                        <TextBlock Text="Clave de Licencia (Pegar aquí):" Style="{StaticResource ModuleLabelStyle}"/>
                        <TextBox x:Name="txtLicenciaKey" Style="{StaticResource ModuleTextBoxStyle}" Height="100" TextWrapping="Wrap" VerticalContentAlignment="Top" AcceptsReturn="True"/>

                        <Button x:Name="btnActivarLicencia" Content="✅ VALIDAR Y ACTIVAR" 
                                Click="btnActivarLicencia_Click"
                                Background="#E0A800" Foreground="Black" FontWeight="Bold" Height="50" Margin="0,20,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🧰 Mantenimiento">
                <Grid Margin="0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="SEGURIDAD DE DATOS" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                        <TextBlock Text="Copias de Seguridad (Backups)" FontSize="16" Foreground="{DynamicResource SuccessColor}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Genere una copia de todos sus datos (Clientes, Productos, Ventas) para guardarla en un lugar seguro (Pendrive, Nube, etc)." 
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Button x:Name="btnGenerarBackup" Content="💾 GENERAR COPIA DE SEGURIDAD" 
                                Click="btnGenerarBackup_Click"
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Height="50" Margin="0,20,0,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="* Se recomienda hacer esto al menos una vez por semana." 
                                   Foreground="{DynamicResource TextSecondary}" FontStyle="Italic" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="💳 Medios de Pago">
                <Grid Margin="0">
                    <StackPanel>
                        <TextBlock Text="MEDIOS DE PAGO" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>
                        <TextBlock Text="Configure los medios de pago disponibles para cobros." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgvMediosPago" AutoGenerateColumns="False" CanUserAddRows="False" 
                                  Height="300" Margin="0,0,0,10"
                                  Background="{DynamicResource SurfaceDark}" RowBackground="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding MedioPagoID}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                                <DataGridTextColumn Header="Orden" Binding="{Binding Orden}" Width="60"/>
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Guardar" Click="btnGuardarMedioPago_Click" Background="#27AE60" Foreground="White" Padding="5,2" Margin="2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnNuevoMedioPago" Content="➕ Nuevo medio de pago" Click="btnNuevoMedioPago_Click"
                                    Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>