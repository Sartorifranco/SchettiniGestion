<Window x:Class="SchettiniGestion.WPF.ConfigurarEtiquetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar etiquetas" Width="920" Height="650"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Configurar etiquetas" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource HeaderForegroundBrush}"/>
            <TextBlock x:Name="txtImpresora" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="📐 Tamaño y orientación">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tipo de etiqueta" Style="{StaticResource ModuleLabelStyle}"/>
                        <ComboBox x:Name="cmbPreset" Style="{StaticResource ModuleComboBoxStyle}"
                                  SelectionChanged="cmbPreset_SelectionChanged" Margin="0,0,0,14"/>

                        <TextBlock Text="Medida física del rollo (ancho × alto, mm)"
                                   Style="{StaticResource ModuleLabelStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtAncho" Style="{StaticResource ModuleTextBoxStyle}"
                                     TextChanged="Medida_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="×" FontSize="18" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="txtAlto" Grid.Column="2" Style="{StaticResource ModuleTextBoxStyle}"
                                     TextChanged="Medida_TextChanged"/>
                            <Button Grid.Column="3" Content="⇄ Intercambiar"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                    Click="btnIntercambiar_Click"/>
                        </Grid>

                        <TextBlock Text="Cómo leer el contenido" Style="{StaticResource ModuleLabelStyle}"/>
                        <ComboBox x:Name="cmbOrientacion" Style="{StaticResource ModuleComboBoxStyle}"
                                  SelectionChanged="cmbOrientacion_SelectionChanged" Margin="0,0,0,14">
                            <ComboBoxItem Content="Sin girar (recomendado)"/>
                            <ComboBoxItem Content="Girado 90°"/>
                        </ComboBox>

                        <TextBlock Text="Modo de impresión" Style="{StaticResource ModuleLabelStyle}"/>
                        <ComboBox x:Name="cmbModo" Style="{StaticResource ModuleComboBoxStyle}">
                            <ComboBoxItem Content="Rollo"/>
                            <ComboBoxItem Content="A4"/>
                            <ComboBoxItem Content="Cartel"/>
                            <ComboBoxItem Content="Gondola"/>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Vista previa" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="txtMedidaPreview" Margin="0,4,0,16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Grid Height="260">
                                <Border x:Name="previewEtiqueta" Background="White" CornerRadius="5"
                                        BorderBrush="#3498DB" BorderThickness="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel x:Name="previewContenido"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Producto" Foreground="Black" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="▮▮▮▮▮▮▮▮▮▮" Foreground="Black" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="$ 1.234,50" Foreground="Black" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="La orientación sólo gira el contenido. El tamaño físico siempre debe coincidir con el rollo."
                                       TextWrapping="Wrap" FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="🏷️ Contenido">
                <StackPanel Margin="22" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Datos que aparecerán en cada etiqueta"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,18"/>
                    <CheckBox x:Name="chkNombre" Content="Nombre del producto" Margin="0,0,0,14"/>
                    <CheckBox x:Name="chkDescripcion" Content="Descripción adicional" Margin="0,0,0,14"/>
                    <CheckBox x:Name="chkPrecio" Content="Precio" Margin="0,0,0,14"/>
                    <CheckBox x:Name="chkCodigo" Content="Código interno" Margin="0,0,0,14"/>
                    <CheckBox x:Name="chkBarras" Content="Código de barras" Margin="0,0,0,14"/>
                    <CheckBox x:Name="chkMarca" Content="Marca" Margin="0,0,0,14"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="📄 Hoja A4">
                <Grid Margin="22" MaxWidth="700" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Columnas" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtColumnas" Grid.Column="1" Style="{StaticResource ModuleTextBoxStyle}"/>
                    <TextBlock Grid.Row="1" Text="Separación horizontal (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtGapH" Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleTextBoxStyle}"/>
                    <TextBlock Grid.Row="2" Text="Separación vertical (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtGapV" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleTextBoxStyle}"/>

                    <TextBlock Grid.Column="3" Text="Margen izquierdo (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtMargenIzq" Grid.Column="4" Style="{StaticResource ModuleTextBoxStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Margen superior (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtMargenSup" Grid.Row="1" Grid.Column="4" Style="{StaticResource ModuleTextBoxStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Margen derecho (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtMargenDer" Grid.Row="2" Grid.Column="4" Style="{StaticResource ModuleTextBoxStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Margen inferior (mm)" Style="{StaticResource ModuleLabelStyle}"/>
                    <TextBox x:Name="txtMargenInf" Grid.Row="3" Grid.Column="4" Style="{StaticResource ModuleTextBoxStyle}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="🖨️ Probar impresión"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                    Click="btnGuardarProbar_Click"/>
            <Button DockPanel.Dock="Right" Content="💾 Guardar configuración"
                    Style="{StaticResource ButtonStyle}" Padding="18,10"
                    Click="btnGuardar_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,10"
                    Margin="0,0,10,0" Click="btnCancelar_Click"/>
        </DockPanel>
    </Grid>
</Window>
