<UserControl x:Class="SchettiniGestion.WPF.ConfiguracionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SchettiniGestion.WPF"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{StaticResource ModuleBackgroundBrush}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración del Sistema" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" BorderThickness="0" Background="#333A44" CornerRadius="5,5,0,0" Margin="2,0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="15,10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#007ACC" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Border" Property="Background" Value="#2E333A" />
                                        <Setter Property="Foreground" Value="#AAA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="🏢 Datos del Negocio">
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="0,5,5,5" Padding="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre de Fantasía:" Style="{StaticResource ModuleLabelStyle}"/>
                            <TextBox x:Name="txtNombre" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Razón Social:" Style="{StaticResource ModuleLabelStyle}"/>
                            <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="CUIT:" Style="{StaticResource ModuleLabelStyle}"/>
                            <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Dirección:" Style="{StaticResource ModuleLabelStyle}"/>
                            <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,15"/>

                            <TextBlock Text="Teléfono:" Style="{StaticResource ModuleLabelStyle}"/>
                            <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="Logo del Ticket:" Style="{StaticResource ModuleLabelStyle}" HorizontalAlignment="Center"/>
                            <Border BorderBrush="#555" BorderThickness="1" CornerRadius="5" Height="200" Width="200" Margin="0,10,0,20" Background="#333">
                                <Image x:Name="imgLogo" Stretch="Uniform"/>
                            </Border>
                            <Button Content="📷 Seleccionar Logo" Style="{StaticResource ActionButtonStyle}" Width="200" Click="btnSeleccionarLogo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="🏛️ AFIP / Facturación Electrónica">
                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="0,5,5,5" Padding="30">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                        <TextBlock Text="Configuración para Factura Electrónica (ARCA)" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                        <TextBlock Text="Punto de Venta (AFIP):" Style="{StaticResource ModuleLabelStyle}"/>
                        <xctk:IntegerUpDown x:Name="numPuntoVenta" Style="{StaticResource ModuleIntegerUpDownStyle}" Minimum="1" Value="1" Margin="0,0,0,15" Width="150" HorizontalAlignment="Left"/>

                        <TextBlock Text="Certificado Digital (.pfx):" Style="{StaticResource ModuleLabelStyle}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtCertificadoPath" Style="{StaticResource ModuleTextBoxStyle}" IsReadOnly="True" Background="#333"/>
                            <Button Grid.Column="1" Content="📂 Buscar" Style="{StaticResource ActionButtonStyle}" Width="80" Margin="10,0,0,0" Click="btnBuscarCertificado_Click"/>
                        </Grid>
                        <TextBlock Text="* El certificado se copiará a la carpeta del sistema por seguridad." Foreground="Gray" FontSize="12" Margin="0,-10,0,15"/>

                        <TextBlock Text="Contraseña del Certificado:" Style="{StaticResource ModuleLabelStyle}"/>
                        <PasswordBox x:Name="txtPasswordAfip" Style="{StaticResource ModulePasswordBoxStyle}" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="💾 Guardar Toda la Configuración" 
                                    Style="{StaticResource ActionButtonStyle}" 
                                    Background="#00A86B" Height="50" Width="250" FontSize="16"
                                    Click="btnGuardar_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>