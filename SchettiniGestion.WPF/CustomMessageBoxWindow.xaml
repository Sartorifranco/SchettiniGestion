<Window x:Class="SchettiniGestion.WPF.CustomMessageBoxWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Mensaje" Width="520" MinHeight="180" MaxHeight="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">



    <Window.Resources>

        <Style x:Key="MsgYesStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MsgNoStyle" TargetType="Button" BasedOn="{StaticResource DeleteButtonStyle}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MsgOkStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>



    <Border Background="{DynamicResource PanelBackgroundBrush}"

            BorderBrush="{DynamicResource BorderColor}"

            BorderThickness="1"

            CornerRadius="10">



        <Grid Margin="24,20,24,24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <TextBlock x:Name="lblTitulo" Text="Título"

                       FontSize="22" FontWeight="Bold"

                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>



            <TextBlock x:Name="lblMensaje" Grid.Row="1"

                       Text="Mensaje de confirmación..."

                       FontSize="18" Foreground="{DynamicResource TextSecondary}"

                       TextWrapping="Wrap"

                       VerticalAlignment="Center"

                       HorizontalAlignment="Center"

                       TextAlignment="Center"/>



            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabNavigation="Cycle">



                <Button x:Name="btnYes" Content="Sí" Click="btnYes_Click"

                        Width="150" Height="50" FontSize="18" FontWeight="Bold"

                        Style="{StaticResource MsgYesStyle}"

                        BorderThickness="0" Margin="10,0"/>



                <Button x:Name="btnNo" Content="No" Click="btnNo_Click"

                        Width="150" Height="50" FontSize="18" FontWeight="Bold"

                        Style="{StaticResource MsgNoStyle}"

                        BorderThickness="0" Margin="10,0"/>



                <Button x:Name="btnOk" Content="Aceptar" Click="btnOk_Click"

                        Width="150" Height="50" FontSize="18" FontWeight="Bold"

                        Style="{StaticResource MsgOkStyle}"

                        BorderThickness="0" Margin="10,0" Visibility="Collapsed"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>

