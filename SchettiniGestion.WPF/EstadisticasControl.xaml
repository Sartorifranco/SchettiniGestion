<UserControl x:Class="SchettiniGestion.WPF.EstadisticasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundDark}"
             Loaded="EstadisticasControl_Loaded">

    <UserControl.Resources>
        <!-- Botón de filtro rápido tipo "pastilla" -->
        <Style x:Key="PillFilterButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Encabezado de sección con acento de color e ícono -->
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Tarjeta base para KPIs y gráficos -->
        <Style x:Key="StatCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="StatGridText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="StatGridNumber" TargetType="TextBlock" BasedOn="{StaticResource StatGridText}">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel MaxWidth="1500">

            <!-- ═══════════════ ENCABEZADO ═══════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PrimaryColor}" Width="4" CornerRadius="2" Margin="0,2,14,2"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="📊 Panel de Estadísticas" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="El pulso de tu negocio: ventas, rentabilidad y oportunidades, todo en un solo lugar."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════ BARRA DE PERÍODO ═══════════════ -->
            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Hoy" Tag="Hoy" Click="btnFiltroRapido_Click" Style="{StaticResource PillFilterButton}"/>
                        <Button Content="7 días" Tag="Semana" Click="btnFiltroRapido_Click" Style="{StaticResource PillFilterButton}"/>
                        <Button Content="Este mes" Tag="Mes" Click="btnFiltroRapido_Click" Style="{StaticResource PillFilterButton}"/>
                        <Button Content="Este año" Tag="Anio" Click="btnFiltroRapido_Click" Style="{StaticResource PillFilterButton}" Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESDE" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dtpDesde" MinWidth="150" MinHeight="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="HASTA" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dtpHasta" MinWidth="150" MinHeight="44"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="📊 Generar" Style="{StaticResource ButtonStyle}"
                            MinWidth="120" MinHeight="44" VerticalAlignment="Bottom"
                            Click="btnGenerar_Click"/>
                </Grid>
            </Border>

            <!-- ═══════════════ KPIs PRINCIPALES ═══════════════ -->
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SuccessColor}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="💰 TOTAL VENDIDO" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblTotalVendido" Text="$ 0,00"
                                       Foreground="{StaticResource SuccessColor}"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="lblVsPeriodo" Text="vs período anterior: —" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PrimaryColor}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="🧾 COMPROBANTES" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblCantidad" Text="0"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="Cantidad de tickets/facturas" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PrimaryColor}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="🎟️ TICKET PROMEDIO" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblTicketPromedio" Text="$ 0,00"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="Clave para subir el ticket" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#3B82F6" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="📈 GANANCIA ESTIMADA" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblMargen" Text="$ 0,00"
                                       Foreground="#3B82F6"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="lblMargenPct" Text="Margen —%" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource DangerColor}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="⚠️ STOCK EN ALERTA" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblStockBajo" Text="0"
                                       Foreground="{StaticResource DangerColor}"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="Productos en/bajo mínimo" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BorderColor}" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="🕓 PERÍODO ANTERIOR" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblPeriodoAnterior" Text="$ 0,00"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Text="Misma duración hacia atrás" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ═══════════════ SECCIÓN: TENDENCIAS ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="{StaticResource PrimaryColor}" Width="4" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="📈 Tendencias de venta" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatCardBorder}" MinHeight="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ventas por día (tendencia)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="chartVentasDia" Grid.Row="1" LegendLocation="None" Hoverable="True"
                                            Padding="8,0,18,14"/>
                        <TextBlock x:Name="lblSinVentasDia" Grid.Row="1" Text="Sin ventas en el período"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCardBorder}" MinHeight="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Horarios pico" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="chartVentasHora" Grid.Row="1" LegendLocation="None" Hoverable="True"
                                            Padding="8,0,18,14"/>
                        <TextBlock x:Name="lblSinHoras" Grid.Row="1" Text="Sin datos por hora"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════ SECCIÓN: RENTABILIDAD ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#3B82F6" Width="4" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="🏆 Ranking de productos" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardBorder}" MinHeight="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top 10 por facturación ($)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="chartTopProductos" Grid.Row="1" LegendLocation="None" Hoverable="True"
                                            Padding="8,0,22,14"/>
                        <TextBlock x:Name="lblSinTop" Grid.Row="1" Text="Sin productos vendidos"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardBorder}" MinHeight="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top 10 por ganancia ($)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="chartTopMargen" Grid.Row="1" LegendLocation="None" Hoverable="True"
                                            Padding="8,0,22,14"/>
                        <TextBlock x:Name="lblSinMargen" Grid.Row="1" Text="Sin datos de margen"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════ SECCIÓN: QUÉ CONVIENE VENDER ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="{StaticResource SuccessColor}" Width="4" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="🎯 ¿Qué te conviene vender?" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource StatCardBorder}" MinHeight="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Análisis ABC de productos" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Grid.Row="1" x:Name="lblAbcResumen" Margin="0,6,0,10" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                                   Text="Estrella = los que más venden (aprox. 8 de cada 10 pesos). Importante = el medio. Resto = venden poco; revisá si conviene tenerlos."/>
                        <DataGrid x:Name="dgvAbc" Grid.Row="2"
                                  Style="{StaticResource ModuleDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Clasificación" Binding="{Binding TipoComercial}" Width="125"
                                                    ElementStyle="{StaticResource StatGridText}"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"
                                                    MinWidth="260" ElementStyle="{StaticResource StatGridText}"/>
                                <DataGridTextColumn Header="Facturación" Binding="{Binding TotalVendido, StringFormat=C0}" Width="130"
                                                    ElementStyle="{StaticResource StatGridNumber}"/>
                                <DataGridTextColumn Header="Ganancia" Binding="{Binding Margen, StringFormat=C0}" Width="125"
                                                    ElementStyle="{StaticResource StatGridNumber}"/>
                                <DataGridTextColumn Header="% acumulado" Binding="{Binding PctAcumulado, StringFormat={}{0:N0}%}" Width="125"
                                                    ElementStyle="{StaticResource StatGridNumber}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource StatCardBorder}" MinHeight="310">
                    <StackPanel>
                        <TextBlock Text="Por medio de pago" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <lvc:PieChart x:Name="chartMediosPago" Height="255" MaxWidth="540"
                                      HorizontalAlignment="Center" LegendLocation="Bottom"
                                      InnerRadius="55" Hoverable="True" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="lblSinMedios" Text="Sin cobros en el período"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════ SECCIÓN: OPORTUNIDADES DE STOCK ═══════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="{StaticResource WarningColor}" Width="4" CornerRadius="2" Margin="0,0,10,0"/>
                <TextBlock Text="⚠️ Oportunidades: productos sin movimiento" Style="{StaticResource SectionHeaderText}"/>
            </StackPanel>
            <Border Style="{StaticResource StatCardBorder}" MinHeight="280"
                    BorderBrush="{StaticResource WarningColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Productos sin movimiento (con stock)" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="30 días" Tag="30" Click="btnMuertos_Click"
                                    Style="{StaticResource PillFilterButton}" MinHeight="36" Padding="12,0"/>
                            <Button Content="60 días" Tag="60" Click="btnMuertos_Click"
                                    Style="{StaticResource PillFilterButton}" MinHeight="36" Padding="12,0"/>
                            <Button Content="90 días" Tag="90" Click="btnMuertos_Click"
                                    Style="{StaticResource PillFilterButton}" MinHeight="36" Padding="12,0" Margin="0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" x:Name="lblMuertosResumen" Margin="0,8,0,10" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Candidatos a liquidar o dejar de reponer. Capital = stock × costo."/>
                    <DataGrid x:Name="dgvMuertos" Grid.Row="2"
                              Style="{StaticResource ModuleDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90"/>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="60"/>
                            <DataGridTextColumn Header="Capital $" Binding="{Binding CapitalInmovilizado, StringFormat=C0}" Width="100"/>
                            <DataGridTextColumn Header="Última venta" Binding="{Binding UltimaVenta, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="lblSinMuertos" Grid.Row="2" Text="Ningún producto con stock sin ventas en el período"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
