<UserControl x:Class="SchettiniGestion.WPF.EtiquetasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Impresión de etiquetas" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource HeaderForegroundBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Buscá productos, indicá cuántas etiquetas de cada uno y qué datos mostrar. La impresora y la medida se configuran en Configuración → Impresoras. El rollo debe coincidir con esa medida (ej. 50×25)."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="5" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                    <Button DockPanel.Dock="Right" Content="Buscar" Width="100" Height="40"
                            Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"
                            Click="btnBuscar_Click"/>
                    <TextBox x:Name="txtBuscar" Style="{StaticResource ModuleTextBoxStyle}" Height="40"
                             VerticalContentAlignment="Center"
                             KeyDown="txtBuscar_KeyDown"
                             ToolTip="Código, barras o nombre"/>
                </DockPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <TextBlock x:Name="lblTamano" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <Button Content="Imprimir seleccionados" Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,10" MinHeight="40" Click="btnImprimir_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="Qué mostrar en la etiqueta:" Style="{StaticResource ModuleLabelStyle}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <CheckBox x:Name="chkDesc" Content="Descripción" IsChecked="True" Margin="0,0,16,6"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="chkPrecio" Content="Precio" IsChecked="True" Margin="0,0,16,6"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="chkCodigo" Content="Código interno" Margin="0,0,16,6"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="chkBarras" Content="Código de barras" IsChecked="True" Margin="0,0,16,6"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="chkMarca" Content="Marca" Margin="0,0,16,6"
                                  Foreground="{DynamicResource TextPrimary}"/>
                        <Button Content="Guardar opciones" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" Margin="8,0,0,6" Click="btnGuardarOpciones_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgvProductos" Grid.Row="2"
                  Style="{StaticResource ModuleDataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" SelectionMode="Extended"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Sel." Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Barras" Binding="{Binding CodigoBarra}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=C2}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Seleccionar visibles" Style="{StaticResource ActionButtonStyle}"
                    Padding="12,8" Margin="0,0,8,0" Click="btnSelTodos_Click"/>
            <Button Content="Quitar selección" Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,8" Margin="0,0,8,0" Click="btnSelNinguno_Click"/>
            <TextBlock x:Name="lblResumen" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </Grid>
</UserControl>
