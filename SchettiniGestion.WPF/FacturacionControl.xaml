<UserControl x:Class="SchettiniGestion.WPF.FacturacionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SchettiniGestion.WPF"
             xmlns:conv="clr-namespace:SchettiniGestion.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1024"
             Loaded="FacturacionControl_Loaded"
             SizeChanged="FacturacionControl_SizeChanged"
             Background="{DynamicResource ModuleBackgroundBrush}">

    <UserControl.Resources>
        <conv:PathToImageConverter x:Key="PathToImageConverter"/>
        <Style x:Key="WhiteTouchCombo" TargetType="ComboBox" BasedOn="{StaticResource TouchComboBoxStyle}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8,40,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WhiteTouchText" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="gridRoot" Margin="12">
        <TabControl x:Name="tabFacturacion" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="border" Background="{DynamicResource SurfaceDark}" CornerRadius="{DynamicResource TabItemCornerRadius}" Padding="15,10" Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderColor}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Venta POS">
                <Grid x:Name="pnlVentaPOS" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" MinWidth="240"/>
                        <ColumnDefinition Width="1.1*" MinWidth="380" MaxWidth="640"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ CATÁLOGO (centro-izquierda) ═══ -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Catálogo de productos"
                                       Style="{DynamicResource TitleTextStyle}"
                                       Margin="0,0,0,4"/>
                            <Border x:Name="bdrArcaPendiente" Visibility="Collapsed"
                                    Padding="10,6"
                                    Background="{DynamicResource ComboBoxItemHoverBackground}"
                                    BorderBrush="{DynamicResource WarningColor}" BorderThickness="3,0,0,0"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <TextBlock x:Name="txtArcaPendiente" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="48"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Buscar (nombre, código o barras)"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Cant."
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>

                            <TextBox x:Name="txtBuscarProducto" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                                     Style="{StaticResource ModuleTextBoxStyle}" Height="48" FontSize="18"
                                     TextChanged="txtBuscarProducto_TextChanged"
                                     LostFocus="txtBuscar_LostFocus" PreviewKeyDown="txtBuscar_PreviewKeyDown"/>
                            <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                                    Background="{DynamicResource SurfaceDark}" CornerRadius="{DynamicResource ControlCornerRadius}" Height="48"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="-" Click="btnRestar_Click" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="22" FontWeight="Bold"/>
                                    <TextBox x:Name="txtCantidad" Grid.Column="1" Text="1" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" FontWeight="Bold" PreviewTextInput="NumberValidationTextBox" Tag="numeric"/>
                                    <Button Grid.Column="2" Content="+" Click="btnSumar_Click" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="22" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <Button x:Name="btnAgregarProducto" Grid.Row="1" Grid.Column="2" Content="+"
                                    Click="btnAgregarProducto_Click" Width="56" Height="48"
                                    Background="{DynamicResource PrimaryColor}" Foreground="White" FontWeight="Bold" FontSize="28"
                                    ToolTip="Agregar seleccionado" Padding="0" BorderThickness="0"/>
                            <Button x:Name="btnAyudaAtajos" Grid.Row="1" Grid.Column="3" Content="⌨ Atajos"
                                    Click="btnAyudaAtajos_Click" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="100" Height="48" Padding="12,0" Margin="8,0,0,0"
                                    ToolTip="Ver todos los atajos de teclado (F1)" FontSize="13" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="lblModoBusqueda"
                                       Text="Modo: todo (Alt+Q cambiar)"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,4,0,0"/>
                            <Popup x:Name="popupProducto" PlacementTarget="{Binding ElementName=txtBuscarProducto}" StaysOpen="False">
                                    <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="2" MaxHeight="360">
                                        <ListBox x:Name="lstSugerenciasProducto" MaxWidth="480" MaxHeight="350" FontSize="16"
                                                 Style="{StaticResource TouchSuggestionListBoxStyle}" Focusable="False" IsTabStop="False"
                                                 MouseUp="lstSugerenciasProducto_MouseUp" PreviewKeyDown="lstSugerencias_PreviewKeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinWidth="280">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Codigo}" Foreground="{DynamicResource ComboBoxDropDownForeground}" Opacity="0.75"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Descripcion}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource ComboBoxDropDownForeground}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PrecioVenta, StringFormat=C2}"
                                                                   Foreground="{StaticResource SuccessColor}" FontWeight="Bold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                        </Grid>

                        <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="bdrFavoritos" Grid.Row="0" Visibility="Collapsed"
                                Background="{DynamicResource SurfaceDark}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Favoritos — tocá para vender · ★ para quitar"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="icFavoritos">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="108" Margin="0,0,8,0" Padding="8" Cursor="Hand"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                        MouseLeftButtonUp="FavoritoCard_Click">
                                                    <StackPanel>
                                                        <Grid Height="56" Margin="0,0,0,6">
                                                            <Border CornerRadius="6" Background="{DynamicResource SurfaceDark}">
                                                                <Image Source="{Binding ImagenPath, Converter={StaticResource PathToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                                            </Border>
                                                            <Button Content="★" Click="FavoritoEstrella_Click"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Width="26" Height="26" Padding="0" FontSize="13"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#F59E0B" Cursor="Hand"
                                                                    ToolTip="Quitar de favoritos"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Descripcion}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextWrapping="Wrap" MaxHeight="32"/>
                                                        <TextBlock Text="{Binding PrecioLista, StringFormat=C2}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessColor}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                            <Border x:Name="bdrPromosHoy" Grid.Row="1" Visibility="Collapsed"
                                    Background="#1A27AE60" BorderBrush="#27AE60" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Promos activas hoy" FontSize="11" FontWeight="Bold"
                                               Foreground="#2ECC71" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="txtPromosHoy" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="btnVistaCatalogoLista" Content="Lista" Click="btnVistaCatalogoLista_Click"
                                        Style="{StaticResource ButtonStyle}" Padding="14,6" Margin="0,0,6,0"/>
                                <Button x:Name="btnVistaCatalogoCards" Content="Cards" Click="btnVistaCatalogoCards_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,12,0"/>
                                <TextBlock x:Name="lblCantidadCatalogo" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                            </StackPanel>

                            <DataGrid x:Name="dgvCatalogo" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                                      RowHeight="48" FontSize="14" SelectionMode="Single" HorizontalScrollBarVisibility="Auto"
                                      MouseLeftButtonUp="dgvCatalogo_MouseLeftButtonUp">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundDark}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="40" MinWidth="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding EstrellaFavorito}" Click="FavoritoEstrella_Click"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        FontSize="16" Foreground="#F59E0B" Padding="0"
                                                        ToolTip="Favorito en el POS (acceso rápido)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cód" Binding="{Binding Codigo}" MinWidth="130" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="8,0"/>
                                                <Setter Property="TextTrimming" Value="None"/>
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Setter Property="ToolTip" Value="{Binding Codigo}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="78" MinWidth="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#27AE60" CornerRadius="4" Padding="6,3"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        ToolTip="{Binding PromoTooltip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EnPromo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="EN PROMO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" MinWidth="140" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="8,0"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Descripcion}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioLista, StringFormat=C2}" MinWidth="96" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="8,0"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockTexto}" MinWidth="120" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Padding" Value="8,0"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="TextTrimming" Value="None"/>
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Setter Property="ToolTip" Value="{Binding StockTexto}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                <Setter Property="Background" Value="#44C0392B"/>
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <ScrollViewer x:Name="svCatalogoCards" Grid.Row="3" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icCatalogo">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6" Width="168" Padding="10" CornerRadius="{DynamicResource CardCornerRadius}" Cursor="Hand"
                                                    MouseLeftButtonUp="CatalogoCard_Click"
                                                    BorderThickness="2"
                                                    ToolTip="{Binding PromoTooltip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceDark}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#C0392B"/>
                                                                <Setter Property="Background" Value="#33C0392B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EnPromo}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#27AE60"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid Height="72" Margin="0,0,0,8">
                                                        <Border CornerRadius="6" Background="{DynamicResource ModuleBackgroundBrush}">
                                                            <Image Source="{Binding ImagenPath, Converter={StaticResource PathToImageConverter}}" Stretch="Uniform" Margin="4"/>
                                                        </Border>
                                                        <Button Content="{Binding EstrellaFavorito}" Click="FavoritoEstrella_Click"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Width="28" Height="28" Padding="0" FontSize="14"
                                                                Background="#AA000000" BorderThickness="0" Foreground="#F59E0B"
                                                                Cursor="Hand" Margin="2"
                                                                ToolTip="Marcar o quitar favorito"/>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="#27AE60" CornerRadius="4" Padding="5,2" Margin="0,2,2,0"
                                                                ToolTip="{Binding PromoTooltip}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EnPromo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="EN PROMO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Codigo}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding Descripcion}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" Margin="0,2,0,4"/>
                                                    <TextBlock Text="{Binding PrecioLista, StringFormat=C2}" Foreground="{StaticResource SuccessColor}" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding StockTexto}" FontSize="12" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFE57373"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ═══ RESUMEN DE VENTA (derecha) ═══ -->
                    <Border x:Name="bdrResumenVenta" Grid.Column="1" Background="{DynamicResource SurfaceDark}"
                            CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,10"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            local:CornerClip.Enable="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="pnlAccionesResumen" Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock x:Name="txtTituloResumen" Text="Resumen de la venta" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="btnDescuentoGlobal" Content="% Total" MinWidth="88" Margin="0,0,8,8"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            ToolTip="Descuento o bonificación sobre toda la venta" Click="btnDescuentoGlobal_Click"
                                            Background="#3498DB"/>
                                    <Button x:Name="btnBorrarVenta" Content="🗑 Borrar" MinWidth="88" Margin="0,0,8,8"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            ToolTip="Borrar venta" Click="btnBorrarVenta_Click"
                                            Background="#C0392B"/>
                                    <Button x:Name="btnGuardarConfigPredeterminada" Content="⚙ Config" MinWidth="88" Margin="0,0,8,8"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            ToolTip="Mostrar u ocultar configuración de la venta" Click="btnToggleConfigVenta_Click"
                                            Background="{DynamicResource HoverBackground}"/>
                                    <Button x:Name="btnPausarVenta" Content="Pausar F5" MinWidth="100" Margin="0,0,8,8"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            ToolTip="Dejar esta venta en pausa y atender otra (F5)" Click="btnPausarVenta_Click"
                                            Background="#8E44AD"/>
                                    <Button x:Name="btnRecuperarPausa" Content="Pausas F6" MinWidth="100" Margin="0,0,0,8"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            ToolTip="Recuperar una venta pausada (F6)" Click="btnRecuperarPausa_Click"
                                            Background="#6C3483"/>
                                </WrapPanel>
                                <TextBlock x:Name="txtAyudaResumen" Visibility="Collapsed"
                                           Text="% Total = descuento a toda la venta · Tocá un producto abajo para editar ese ítem"
                                           FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border x:Name="brdLetraComprobante" Grid.Column="1"
                                        Width="58" Height="58" CornerRadius="12" VerticalAlignment="Top"
                                        Background="#117A65" BorderBrush="#0E6655" BorderThickness="1"
                                        ToolTip="La letra cambia al elegir cliente (y su condición IVA) o al cambiar Factura / Ticket / NC. Monotributo del local = C. RI a RI = A. CF, monotributo o exento = B.">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="lblLetraComprobante" Text="B" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="lblLetraDetalle" Text="Factura" FontSize="10"
                                                   Foreground="#D6EAF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="pnlDatosVenta" Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="Cliente" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBuscarCliente" Grid.Column="0" Style="{StaticResource ModuleTextBoxStyle}" Height="42" FontSize="15"
                                             TextChanged="txtBuscarCliente_TextChanged"
                                             LostFocus="txtBuscar_LostFocus" PreviewKeyDown="txtBuscar_PreviewKeyDown"
                                             ToolTip="Buscá por nombre, CUIT o código. Enter selecciona."/>
                                    <Button x:Name="btnCrearCliente" Grid.Column="1" Content="➕" Click="btnCrearCliente_Click"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            Background="#27AE60" Height="42" Width="42" Padding="0" Margin="8,0,0,0" ToolTip="Crear cliente rápido"/>
                                    <Popup x:Name="popupCliente" PlacementTarget="{Binding ElementName=txtBuscarCliente}" StaysOpen="False">
                                        <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="4">
                                            <StackPanel>
                                                <ListBox x:Name="lstSugerenciasCliente" Width="360" MaxHeight="220" FontSize="15"
                                                         Style="{StaticResource TouchSuggestionListBoxStyle}"
                                                         MouseUp="lstSugerenciasCliente_MouseUp" PreviewKeyDown="lstSugerencias_PreviewKeyDown">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding RazonSocial}" Padding="8,6"
                                                                       Foreground="{DynamicResource ComboBoxDropDownForeground}"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button x:Name="btnCrearClientePopup" Content="➕ Crear cliente nuevo" Click="btnCrearCliente_Click"
                                                        Style="{StaticResource PosTintButtonStyle}"
                                                        Background="#27AE60" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock x:Name="lblClienteSeleccionado" Text="Consumidor Final" Foreground="{DynamicResource SuccessColor}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Comprobante" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbTipoComprobante" SelectedIndex="0" Style="{StaticResource WhiteTouchCombo}"
                                                  SelectionChanged="cmbTipoComprobante_SelectionChanged"
                                                  ToolTip="Factura A/B/C según cliente e IVA. Ticket = no fiscal. NC/ND desde acá = nota libre; para NC vinculada a una factura usá Ventas → NC.">
                                            <ComboBoxItem Content="Factura"/>
                                            <ComboBoxItem Content="Ticket"/>
                                            <ComboBoxItem Content="Remito"/>
                                            <ComboBoxItem Content="Pedido"/>
                                            <ComboBoxItem Content="Presupuesto"/>
                                            <ComboBoxItem Content="Nota de Crédito"/>
                                            <ComboBoxItem Content="Nota de Débito"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel x:Name="pnlCondicionPago" Grid.Column="2">
                                        <TextBlock Text="Pago" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmbCondicionVenta" SelectedIndex="0" SelectionChanged="cmbCondicionVenta_SelectionChanged" Style="{StaticResource WhiteTouchCombo}">
                                            <ComboBoxItem Content="Contado"/>
                                            <ComboBoxItem Content="Tarjeta"/>
                                            <ComboBoxItem Content="Cta. Cte."/>
                                            <ComboBoxItem Content="Mercado Pago"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="txtAyudaTipoComprobante" Visibility="Collapsed"
                                           FontSize="11" Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="NC/ND desde el POS es nota libre. Para acreditar una factura emitida: Ventas → NC (vinculada)."/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Expander x:Name="expConfigVenta" Header="Lista y efectivo" IsExpanded="False"
                                          Visibility="Collapsed"
                                          Style="{StaticResource CartItemExpanderStyle}"
                                          Expanded="expConfigVenta_Expanded" Collapsed="expConfigVenta_Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Lista de precios" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cmbListaPrecios" DisplayMemberPath="Nombre" SelectedValuePath="ListaID"
                                                  SelectionChanged="cmbListaPrecios_SelectionChanged"
                                                  Style="{StaticResource WhiteTouchCombo}" Margin="0,0,0,8"/>
                                        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="La lista define el precio de venta del catálogo. Cambiala solo si el cliente usa otra tarifa."/>

                                        <StackPanel x:Name="pnlCalculoEfectivo">
                                            <TextBlock Text="Abonado ($)" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                            <TextBox x:Name="txtMontoPagado" Style="{StaticResource WhiteTouchText}"
                                                     TextChanged="txtMontoPagado_TextChanged" PreviewTextInput="NumberValidationTextBox" Tag="numeric"/>
                                            <Grid Margin="0,10,0,0">
                                                <TextBlock Text="Vuelto:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblVuelto" Text="$ 0,00" Foreground="{DynamicResource WarningColor}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        <Button Content="💾 Guardar como predeterminado" Click="btnGuardarConfigPredeterminada_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="12,8"
                                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                                ToolTip="Guarda lista, comprobante y forma de pago para próximas ventas"/>
                                    </StackPanel>
                                </Expander>

                                <ScrollViewer x:Name="svCarrito" VerticalScrollBarVisibility="Auto"
                                              Background="Transparent" Padding="0,0,4,0">
                                    <StackPanel>
                                        <Border x:Name="bdrAvisoPromo" Visibility="Collapsed" Background="#1A27AE60"
                                                BorderBrush="#27AE60" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                            <TextBlock x:Name="txtAvisoPromo" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#2ECC71"/>
                                        </Border>
                                        <TextBlock x:Name="lblCantidadItems" Text="0 productos en el pedido"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="icCarrito">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Style="{StaticResource CartItemExpanderStyle}" IsExpanded="False"
                                                          Expanded="ExpanderCarrito_Expanded" Collapsed="ExpanderCarrito_Collapsed">
                                                    <Expander.Header>
                                                        <Grid MinHeight="44" Margin="0,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                                                <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,4,0,0">
                                                                    <Run Text="{Binding Cantidad, Mode=OneWay}"/>
                                                                    <Run Text=" × "/>
                                                                    <Run Text="{Binding PrecioUnitario, StringFormat=C2, Mode=OneWay}"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="{Binding AjusteLineaTexto, Mode=OneWay}" Foreground="#9B59B6"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=C2}"
                                                                       Foreground="{StaticResource SuccessColor}" FontWeight="Bold" FontSize="16"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                            <Button Content="−" Width="48" Height="48" Click="btnCarritoRestar_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}" Padding="0"
                                                                    Background="{DynamicResource HoverBackground}"
                                                                    Foreground="{DynamicResource TextPrimary}" FontSize="22" Margin="0,0,14,0"/>
                                                            <TextBlock Text="{Binding Cantidad}" Foreground="{DynamicResource TextPrimary}"
                                                                       VerticalAlignment="Center" FontSize="22" FontWeight="Bold" MinWidth="36" TextAlignment="Center"/>
                                                            <Button Content="+" Width="48" Height="48" Click="btnCarritoSumar_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}" Padding="0"
                                                                    Background="{DynamicResource HoverBackground}"
                                                                    Foreground="{DynamicResource TextPrimary}" FontSize="22" Margin="14,0,0,0"/>
                                                        </StackPanel>
                                                        <UniformGrid Columns="2">
                                                            <Button Content="Dto. este ítem" MinHeight="48" Margin="0,0,6,6" Click="btnDescuentoItem_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}" Background="#3498DB"/>
                                                            <Button Content="Recargo +" MinHeight="48" Margin="6,0,0,6" Click="btnRecargoItem_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}" Background="#9B59B6"/>
                                                            <Button Content="Editar precio" MinHeight="48" Margin="0,0,6,0" Click="btnEditarItem_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}"
                                                                    IsEnabled="{Binding PermiteModificarPrecioVenta}"
                                                                    Background="#D97706"/>
                                                            <Button Content="Quitar" MinHeight="48" Margin="6,0,0,0" Click="btnEliminarItem_Click" Tag="{Binding}"
                                                                    Style="{StaticResource PosTintButtonStyle}" Background="#C0392B"/>
                                                        </UniformGrid>
                                                        <TextBlock Text="Solo afecta a este producto (no al resto del pedido)" FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Controles ocultos (compatibilidad) — fuera del flujo visual -->
                            <DataGrid x:Name="dgvFactura" Grid.Row="2" Visibility="Collapsed" Height="0" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="svCardsFactura" Grid.Row="2" Visibility="Collapsed" Height="0" IsHitTestVisible="False">
                                <ItemsControl x:Name="icCardsFactura"/>
                            </ScrollViewer>
                            <Button x:Name="btnVistaLista" Grid.Row="2" Visibility="Collapsed" Click="btnVistaLista_Click"/>
                            <Button x:Name="btnVistaCards" Grid.Row="2" Visibility="Collapsed" Click="btnVistaCards_Click"/>

                            <Grid x:Name="pnlTotalesDetalle" Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal:" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock x:Name="lblSubtotal" Grid.Column="1" Text="$ 0,00" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Descuentos:" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock x:Name="lblDescuentos" Grid.Column="1" Text="$ 0,00" Foreground="{DynamicResource DangerColor}" FontSize="12"/>
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recargos:" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock x:Name="lblRecargos" Grid.Column="1" Text="$ 0,00" Foreground="#9B59B6" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Neto:" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock x:Name="lblNeto" Grid.Column="1" Text="$ 0,00" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IVA:" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                    <TextBlock x:Name="lblIVA" Grid.Column="1" Text="$ 0,00" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                </Grid>
                                <Separator Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource BorderColor}" Margin="0,6,0,0"/>
                            </Grid>

                            <StackPanel x:Name="pnlTotalesAccion" Grid.Row="4">
                                <TextBlock Text="TOTAL A PAGAR" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,2"/>
                                <Viewbox x:Name="viewboxTotal" Stretch="Uniform" MaxHeight="44" Margin="0,0,0,10">
                                    <TextBlock x:Name="lblTotal" Text="$ 0,00" Foreground="{DynamicResource SuccessColor}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Viewbox>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnGuardarFactura" Grid.Column="0" Content="✅ COBRAR" Click="btnGuardarFactura_Click"
                                            Style="{StaticResource SuccessButtonStyle}" FontSize="16" MinHeight="52"/>
                                    <Button x:Name="btnCancelarFactura" Grid.Column="2" Content="✕" Click="btnCancelarFactura_Click"
                                            Style="{StaticResource PosTintButtonStyle}"
                                            Background="#C0392B" FontSize="18" MinHeight="52" MinWidth="52" Padding="0" ToolTip="Cancelar venta"/>
                                </Grid>
                                <Button x:Name="btnAyudaAtajosResumen" Content="Ver atajos de teclado (F1)"
                                        Click="btnAyudaAtajos_Click" Margin="0,6,0,0" Visibility="Collapsed"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Foreground="{StaticResource PrimaryColor}" FontSize="12" FontWeight="SemiBold"
                                        HorizontalAlignment="Center" ToolTip="Abrir referencia completa de atajos"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="btnPagoQR" Visibility="Collapsed" Click="btnPagoQR_Click"/>

                    <Border x:Name="bdrBloqueoApertura" Grid.ColumnSpan="2" Visibility="Collapsed"
                            Background="#CC0D1117" Panel.ZIndex="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24">
                            <TextBlock Text="🔒 Ventas bloqueadas" FontSize="22" FontWeight="Bold"
                                       Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="txtBloqueoApertura" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="15" LineHeight="22"
                                       Margin="0,0,0,20"/>
                            <Button x:Name="btnAbrirCajaDesdePos"
                                    Content="🔓  ABRIR CAJA"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    FontSize="18" FontWeight="Bold"
                                    MinHeight="56" MinWidth="260" Padding="24,14"
                                    HorizontalAlignment="Center"
                                    Click="btnAbrirCajaDesdePos_Click"
                                    ToolTip="Registrar el fondo fijo e iniciar el turno"/>
                            <TextBlock Text="También podés hacerlo desde Caja → Apertura de caja."
                                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Presupuestos">
                <local:FacturacionPresupuestosTab/>
            </TabItem>
            <TabItem Header="Remitos">
                <local:FacturacionRemitosTab/>
            </TabItem>
            <TabItem Header="Pedidos">
                <local:FacturacionPedidosTab/>
            </TabItem>
            <TabItem Header="Notas crédito/débito ventas">
                <local:FacturacionNotasCreditoDebitoTab/>
            </TabItem>
            <TabItem Header="Historial de ventas">
                <local:VentasControl/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>