<UserControl x:Class="SchettiniGestion.WPF.FacturacionNotasCreditoDebitoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Control_Loaded">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtFiltro" Style="{StaticResource ModernTextBox}" Width="280" TextChanged="txtFiltro_TextChanged"/>
                <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0" Padding="10,6" Click="btnBuscar_Click"/>
                <Button Content="🖨 Imprimir" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="10,6" Click="btnImprimir_Click"/>
                <Button Content="🗑 Eliminar" Style="{StaticResource DeleteButtonStyle}" Margin="8,0,0,0" Padding="10,6" Click="btnEliminar_Click"/>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="dgvNotas"
                  Style="{StaticResource {x:Type DataGrid}}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding NotaID}" Width="60"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding RazonSocial}" Width="*"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="160"/>
                <DataGridTextColumn Header="Nº Comp." Binding="{Binding NumeroComprobante}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
