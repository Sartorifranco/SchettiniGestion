<Window x:Class="SchettiniGestion.WPF.ImportarFacturaCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar factura PDF"
        Width="980" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Revisar importación de factura"
                       FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}"
                       Text="El reconocimiento es una ayuda: verificá proveedor, tipo, cantidades y costos antes de confirmar. “Sin match” significa que todavía debés elegir el producto del sistema; esos renglones se omiten si no los asignás."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceDark}" CornerRadius="7" Padding="12,10" Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="lblProveedor" Text="Proveedor: (sin detectar)"
                               Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblCabecera" Text=""
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="lblAdvertencia" Text="" Foreground="#E6A23C" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tipo comprobante" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <ComboBox x:Name="cmbTipoComprobante" Style="{StaticResource ModuleComboBoxStyle}">
                        <ComboBoxItem Content="Factura A"/>
                        <ComboBoxItem Content="Factura B"/>
                        <ComboBoxItem Content="Factura C"/>
                        <ComboBoxItem Content="Ticket"/>
                        <ComboBoxItem Content="Remito"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="dgvLineas"
                  Style="{StaticResource ModuleDataGridStyle}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FontSize="13"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cód. origen" Binding="{Binding CodigoPdf}" Width="90"/>
                <DataGridTextColumn Header="Descripción detectada" Binding="{Binding DescripcionPdf}" Width="*"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding CostoFmt}" Width="90"/>
                <DataGridTextColumn Header="Producto sistema" Binding="{Binding DescripcionProducto}" Width="220"/>
                <DataGridTextColumn Header="Match" Binding="{Binding OrigenMatch}" Width="70"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Elegir…" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="6,2" FontSize="11"
                                    Click="btnElegirProducto_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="lblResumen"
                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnCancelar_Click"/>
            <Button Content="✔ Confirmar e importar" Style="{StaticResource ButtonStyle}" Click="btnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
