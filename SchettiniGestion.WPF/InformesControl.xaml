<UserControl x:Class="SchettiniGestion.WPF.InformesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ModuleBackgroundBrush}"
             Loaded="Control_Loaded">
    <Grid Margin="20">
        <TabControl x:Name="tabInformesHub" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,10,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📋 Informes tabulares">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Informes" Style="{DynamicResource TitleTextStyle}" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Style="{StaticResource SaaSTableCard}" Padding="14,12" Margin="0,0,0,14">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,8" MinWidth="200">
                                <TextBlock Text="Tipo de Informe" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbTipoInforme" Style="{StaticResource ModuleComboBoxStyle}" MinWidth="200" MaxWidth="280" SelectionChanged="cmbTipoInforme_SelectionChanged">
                                    <ComboBoxItem Content="Ventas por Período" IsSelected="True"/>
                                    <ComboBoxItem Content="Libro IVA Ventas"/>
                                    <ComboBoxItem Content="Libro IVA Compras"/>
                                    <ComboBoxItem Content="Productos Más Vendidos"/>
                                    <ComboBoxItem Content="Ranking Clientes"/>
                                    <ComboBoxItem Content="Valorización de Stock"/>
                                    <ComboBoxItem Content="Ventas por Vendedor"/>
                                    <ComboBoxItem Content="Faltantes en Pedidos"/>
                                    <ComboBoxItem Content="Cuenta Corriente Proveedores"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Desde" Style="{StaticResource LabelStyle}"/>
                                <DatePicker x:Name="dpDesde" MinWidth="150" MinHeight="44"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Hasta" Style="{StaticResource LabelStyle}"/>
                                <DatePicker x:Name="dpHasta" MinWidth="150" MinHeight="44"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button Content="📊 Generar" Style="{StaticResource ButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="btnGenerar_Click"/>
                                <Button Content="📄 CSV" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,0" Click="btnExportar_Click"/>
                                <Button Content="📕 PDF" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="btnExportarPdf_Click"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SaaSTableCard}" Padding="12,0,12,12">
                    <DataGrid x:Name="dgvInforme"
                              Style="{StaticResource {x:Type DataGrid}}"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="tabGraficos" Header="📈 Gráficos y KPIs">
                <ContentControl x:Name="hostEstadisticas" Margin="0,6,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
