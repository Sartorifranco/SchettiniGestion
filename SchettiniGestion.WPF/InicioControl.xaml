<UserControl x:Class="SchettiniGestion.WPF.InicioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundDark}"
             Loaded="InicioControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Resumen del día"
                           Style="{DynamicResource HeadlineTextStyle}"/>
                <Button Content="Actualizar" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Padding="16,0"
                        Click="btnActualizar_Click"/>
            </Grid>
            <TextBlock x:Name="lblFechaHoy" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,18"/>

            <!-- KPIs principales -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1,1,1,1" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,10,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ventas de hoy" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblVentasHoy" Text="$ 0,00" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessColor}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="lblVsAyer" Text="vs ayer: —" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,10,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Operaciones" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblCantVentas" Text="0" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="lblTicketPromedio" Text="Ticket prom. $ 0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,10,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ganancia estimada" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblGananciaHoy" Text="$ 0,00" FontSize="26" FontWeight="Bold"
                                   Foreground="#3B82F6" Margin="0,6,0,0"/>
                        <TextBlock x:Name="lblMargenPct" Text="Margen —%" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Saldo de caja" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblCaja" Text="$ 0,00" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource WarningColor}" Margin="0,6,0,0"/>
                        <TextBlock Text="Efectivo / movimientos" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- KPIs operativos -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Stock en alerta" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblStockBajo" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource DangerColor}" Margin="0,4,0,0"/>
                        <TextBlock Text="En o bajo el mínimo" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Catálogo" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblProductos" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Productos cargados" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Clientes" Style="{StaticResource LabelStyle}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="lblClientes" Text="0" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Registrados" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top productos hoy -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceDark}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" MinHeight="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top productos hoy" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgvTopHoy" Grid.Row="1"
                                  Style="{StaticResource ModuleDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Unid." Binding="{Binding UnidadesVendidas}" Width="50"/>
                                <DataGridTextColumn Header="$" Binding="{Binding TotalVendido, StringFormat=C0}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="lblSinTopHoy" Grid.Row="1" Text="Sin ventas hoy"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Medios de pago hoy -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceDark}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" MinHeight="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cómo te pagaron hoy" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgvMediosHoy" Grid.Row="1"
                                  Style="{StaticResource ModuleDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medio" Binding="{Binding Medio}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="lblSinMediosHoy" Grid.Row="1" Text="Sin cobros registrados"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Alertas stock -->
                <Border Grid.Column="4" Background="{DynamicResource SurfaceDark}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14" MinHeight="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Reponer ya (stock bajo)" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgvStockBajo" Grid.Row="1"
                                  Style="{StaticResource ModuleDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="55"/>
                                <DataGridTextColumn Header="Mín." Binding="{Binding StockMinimo}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="lblSinStockBajo" Grid.Row="1" Text="Sin alertas de stock"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Text="Tip: para el análisis completo (evolución, horarios pico, comparativos) usá el menú «Gráficos y Estadísticas»."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
