<UserControl x:Class="SchettiniGestion.WPF.InicioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundDark}"
             Loaded="InicioControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resumen del Día" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="0,0,0,20">

            <Border Background="{StaticResource SurfaceDark}" CornerRadius="10" Margin="0,0,10,0" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="VENTAS HOY" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextSecondary}"/>
                        <Viewbox Height="40" HorizontalAlignment="Left" Margin="0,5,0,0">
                            <TextBlock x:Name="lblVentasHoy" Text="$ 0,00" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </Viewbox>
                        <TextBlock x:Name="lblCantVentas" Text="0 operaciones" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource SurfaceDark}" CornerRadius="10" Margin="10,0,10,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="GANANCIA ESTIMADA" Style="{StaticResource LabelStyle}"/>
                    <Viewbox Height="40" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <TextBlock x:Name="lblGananciaHoy" Text="$ 0,00" FontWeight="Bold" Foreground="#3B82F6"/>
                    </Viewbox>
                    <TextBlock Text="Margen promedio" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceDark}" CornerRadius="10" Margin="10,0,10,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="SALDO CAJA" Style="{StaticResource LabelStyle}"/>
                    <Viewbox Height="40" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <TextBlock x:Name="lblCaja" Text="$ 0,00" FontWeight="Bold" Foreground="{StaticResource WarningColor}"/>
                    </Viewbox>
                    <TextBlock Text="Efectivo disponible" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceDark}" CornerRadius="10" Margin="10,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="CATÁLOGO" Style="{StaticResource LabelStyle}"/>
                    <Viewbox Height="40" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <TextBlock x:Name="lblProductos" Text="0" FontWeight="Bold" Foreground="White"/>
                    </Viewbox>
                    <TextBlock Text="Productos activos" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Gráficos y Estadísticas próximamente..." Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>