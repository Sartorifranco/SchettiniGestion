<Window x:Class="SchettiniGestion.WPF.LineaFacturaCompraManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar ítem faltante"
        Width="560" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Agregar un ítem que el OCR no detectó"
                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock Margin="0,5,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Copiá los datos tal como aparecen en la factura. Luego podrás asignarlo a un producto existente o crear uno nuevo."/>

            <TextBlock Text="Código del proveedor (opcional)" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtCodigo" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10"/>

            <TextBlock Text="Descripción *" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtDescripcion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cantidad *" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtCantidad" Text="1" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Costo unitario *" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtCosto" Text="0" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderColor}" Margin="0,16,0,14"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="btnCancelar_Click"/>
            <Button Content="Agregar y asignar producto" Style="{StaticResource ButtonStyle}"
                    Click="btnAgregar_Click"/>
        </StackPanel>
    </Grid>
</Window>
