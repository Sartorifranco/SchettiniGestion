<Window x:Class="SchettiniGestion.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Iniciar Sesión" Height="540" Width="840"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="LoginFieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource LoginFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LoginFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource LoginFieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LoginFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{DynamicResource HeadlineFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="bdrLoginCard" Background="{DynamicResource LoginFormBackgroundBrush}"
            CornerRadius="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="bdrLoginAside" Grid.Column="0" Background="{DynamicResource LoginAsideBackgroundBrush}"
                    CornerRadius="16,0,0,16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
                    <Image Width="200" Height="130"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Source="/SCHPOS;component/Resources/schpos-logo.ico"/>
                    <TextBlock x:Name="txtMarcaAside" Text="SCHPOS" FontSize="22" FontWeight="Bold"
                               FontFamily="{DynamicResource HeadlineFontFamily}"
                               Foreground="{DynamicResource LoginBrandTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtSubmarcaAside" Text="GESTIÓN POS" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="1" Content="✕" Click="btnSalir_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                    Style="{StaticResource SecondaryButtonStyle}" Width="30" Height="30"/>

            <StackPanel x:Name="pnlLoginForm" Grid.Column="1" VerticalAlignment="Center" Margin="28,20,28,20">
                <TextBlock x:Name="txtBienvenido" Text="Bienvenido"
                           FontFamily="{DynamicResource HeadlineFontFamily}"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtCredenciales" Text="Ingrese sus credenciales para continuar."
                           FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18"/>

                <TextBlock x:Name="lblUsuario" Text="Usuario" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtUsuario" Style="{StaticResource LoginFieldBox}" Margin="0,0,0,4" KeyDown="txtUsuario_KeyDown"/>
                <TextBlock Text="Usuario del sistema (ej. cajero o admin)." FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                <TextBlock x:Name="lblPassword" Text="Contraseña" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource LoginPasswordBox}" Margin="0,0,0,4" KeyDown="txtPassword_KeyDown"/>
                <TextBlock Text="La preferencia del teclado táctil se guarda aunque cierre el sistema." FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>

                <Button x:Name="btnIngresar" Content="Ingresar" Click="btnIngresar_Click"
                        Style="{StaticResource ButtonStyle}" Height="44" FontSize="16" Margin="0,0,0,8"/>
                <Button x:Name="btnSalir" Content="Salir del sistema" Click="btnSalir_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Height="36"/>
            </StackPanel>

            <Button x:Name="btnTecladoLogin" Grid.Column="0" Click="btnTecladoLogin_Click"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                    MinHeight="40" MinWidth="120" Padding="12,8"
                    Cursor="Hand" Background="{DynamicResource SurfaceDark}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    Foreground="{DynamicResource TextSecondary}"
                    ToolTip="Activar o apagar el teclado táctil. La elección se recuerda al reiniciar.">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⌨" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLabelTecladoLogin" Text="Teclado OFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Grid x:Name="hostTecladoVirtual" Grid.ColumnSpan="2"
                  VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                  Panel.ZIndex="1000" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
