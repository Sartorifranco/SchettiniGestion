                                      Data="M775.879,109.232c-12.541,26.458-23.209,51.369-35.951,75.169c-13.104,24.479-36.051,34.511-62.783,34.669c-73.379,0.427-146.762,0.171-220.15-0.076c-25.9-0.09-35.315,5.634-45.805,28.952c-0.97,2.14-4.111,4.697-6.257,4.71c-44.159,0.272-88.314,0.204-134.372,0.204c2.826-10.645,4.797-20.357,7.968-29.661c19.313-56.646,54.73-96.87,115.123-110.699c9.702-2.225,19.913-3.097,29.894-3.11c114.599-0.221,229.195-0.152,343.802-0.159C769.33,109.232,771.314,109.232,775.879,109.232z"/>
                                <Path Fill="{StaticResource TextPrimary}" StrokeThickness="0"
                                      Data="M227.164,571.84c10.711-31.193,20.805-60.859,31.232-90.403c0.75-2.121,3.924-4.798,5.984-4.814c42.769-0.281,85.538-0.213,129.526-0.213c-6.156,20.119-12.01,39.13-17.785,58.159c-3.1,10.239-5.684,20.662-9.335,30.693c-1.007,2.751-5.017,6.273-7.674,6.303C315.616,571.955,272.123,571.84,227.164,571.84z"/>
                                <Path Fill="{StaticResource TextPrimary}" StrokeThickness="0"
                                      Data="M511.371,763.315c-11.119,16.787-47.681,64.383-46.997,64.818c1.477,0.948,119.05-83.42,118.921-84.532c-0.055-0.522-67.157-2.033-67.157-2.033c13.589-17.523,45.974-59.321,43.638-59.397c-1.822-0.056-118.219,77.578-118.102,78.685C441.728,761.398,511.371,763.315,511.371,763.315z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="SCHPOS" FontSize="32" FontWeight="Black" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="GESTIÓN POS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40">
                <TextBlock Text="Bienvenido" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Ingrese sus credenciales para continuar." FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,30"/>

                <TextBlock Text="USUARIO" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtUsuario" Style="{StaticResource ModernTextBox}" Height="45" FontSize="16" Margin="0,0,0,20" KeyDown="txtUsuario_KeyDown"/>

                <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource PasswordBoxStyle}" Height="45" FontSize="16" Margin="0,0,0,30" KeyDown="txtPassword_KeyDown"/>

                <Button x:Name="btnIngresar" Content="INGRESAR ➔" Click="btnIngresar_Click" Style="{StaticResource ButtonStyle}" Height="50" FontSize="16" Margin="0,0,0,15"/>

                <Button x:Name="btnSalir" Content="Salir del Sistema" Click="btnSalir_Click" Style="{StaticResource SecondaryButtonStyle}" Height="40"/>
            </StackPanel>

            <Button Content="✕" Click="btnSalir_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                    Style="{StaticResource SecondaryButtonStyle}" Width="30" Height="30"/>
        </Grid>
    </Border>
</Window>
