<Window x:Class="SchettiniGestion.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#1E1E1E" AllowsTransparency="True">

    <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="5">
        <Grid>
            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="SCHETTINI" Foreground="White" FontSize="24" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="GESTIÓN" Foreground="#007ACC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Usuario:" Foreground="#AAA" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUser" Style="{StaticResource DarkTextBoxStyle}" Text="admin"/>

                <TextBlock Text="Contraseña:" Foreground="#AAA" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPass" Style="{StaticResource DarkPasswordBoxStyle}"/>

                <Button x:Name="btnIngresar" Content="INGRESAR" Click="btnIngresar_Click" IsDefault="True"
                        Height="45" Margin="0,30,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Salir" Click="btnSalir_Click" Background="Transparent" Foreground="#555" BorderThickness="0" Margin="0,10,0,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>