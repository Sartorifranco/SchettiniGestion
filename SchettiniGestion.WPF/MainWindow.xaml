<Window x:Class="SchettiniGestion.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchettiniGestion"
        Height="520" Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.Resources>

        <!-- Input de texto del login -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#141828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#242F5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E56E5"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox del login -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#141828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#242F5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E56E5"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón principal (Ingresar) -->
        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E56E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1648CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1040B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario (Teclado) -->
        <Style x:Key="LoginSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5A6FA8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#8BA0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón cerrar (X) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5A8A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Capa exterior: espacio para la sombra -->
    <Border Margin="14">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="26" Color="Black" Opacity="0.70"/>
        </Border.Effect>

        <!-- Capa interior: esquinas redondeadas + clip -->
        <Border CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Panel formulario -->
                    <ColumnDefinition Width="*"/>
                    <!-- Separador -->
                    <ColumnDefinition Width="1"/>
                    <!-- Panel logo -->
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================
                     PANEL IZQUIERDO — Formulario de login
                     ============================================ -->
                <Border Grid.Column="0" Background="#080B14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Encabezado -->
                        <Border Grid.Row="0" Padding="50,32,50,0">
                            <TextBlock Text="SCHETTINI TEC"
                                       Foreground="#1E3060"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                        </Border>

                        <!-- Formulario centrado -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="50,0,50,0">

                            <TextBlock Text="Bienvenido"
                                       Foreground="#4A5A8A"
                                       FontSize="14"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Iniciar Sesión"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,0,0,32"/>

                            <!-- Separador azul decorativo -->
                            <Rectangle Height="2" Width="40" Fill="#1E56E5"
                                       HorizontalAlignment="Left"
                                       RadiusX="1" RadiusY="1"
                                       Margin="0,0,0,28"/>

                            <!-- Usuario -->
                            <TextBlock Text="USUARIO"
                                       Foreground="#4A5A8A"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7"/>
                            <TextBox x:Name="txtUsuario"
                                     Style="{StaticResource LoginTextBoxStyle}"
                                     KeyDown="Input_KeyDown"/>

                            <!-- Contraseña -->
                            <TextBlock Text="CONTRASEÑA"
                                       Foreground="#4A5A8A"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,7"/>
                            <PasswordBox x:Name="txtPassword"
                                         Style="{StaticResource LoginPasswordBoxStyle}"
                                         KeyDown="Input_KeyDown"/>

                            <!-- Botón Ingresar -->
                            <Button x:Name="btnIngresar"
                                    Content="INGRESAR"
                                    Style="{StaticResource LoginPrimaryButton}"
                                    Margin="0,28,0,0"
                                    Click="btnIngresar_Click"/>

                            <!-- Botón Teclado -->
                            <Button x:Name="btnTeclado"
                                    Content="⌨  Teclado en pantalla"
                                    Style="{StaticResource LoginSecondaryButton}"
                                    Margin="0,10,0,0"
                                    Click="btnTeclado_Click"/>

                        </StackPanel>

                        <!-- Pie -->
                        <Border Grid.Row="2" Padding="50,0,50,22">
                            <TextBlock Text="v1.0 · Sistema de Punto de Venta"
                                       Foreground="#1A2440"
                                       FontSize="11"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- Línea separadora -->
                <Rectangle Grid.Column="1" Fill="#0F1630"/>

                <!-- ============================================
                     PANEL DERECHO — Logo y marca
                     ============================================ -->
                <Border Grid.Column="2" Background="#040917">
                    <Grid>

                        <!-- Gradiente sutil de fondo -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#040917" Offset="0"/>
                                    <GradientStop Color="#0A1230" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Botón cerrar -->
                        <Button x:Name="btnClose"
                                Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,12,0"
                                Click="btnClose_Click"/>

                        <!-- Logo + branding centrados -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="28,0">

                            <!-- Logo -->
                            <Border HorizontalAlignment="Center"
                                    Width="155" Height="155"
                                    CornerRadius="78"
                                    ClipToBounds="True"
                                    Margin="0,0,0,0">
                                <Image Source="Resources/logo.png"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Línea decorativa -->
                            <Rectangle Height="2" Width="48" Fill="#1E56E5"
                                       HorizontalAlignment="Center"
                                       RadiusX="1" RadiusY="1"
                                       Margin="0,26,0,20"/>

                            <!-- Nombre -->
                            <TextBlock Text="SCHETTINI TEC"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <!-- Subtítulo -->
                            <TextBlock Text="Sistema de Gestión"
                                       Foreground="#3A4A7A"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                        <!-- Puntos decorativos (esquina inferior derecha) -->
                        <ItemsControl HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,14,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="3" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#1E3575" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                            <Ellipse Width="4" Height="4" Fill="#111D40" Margin="3"/>
                        </ItemsControl>

                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>

</Window>
