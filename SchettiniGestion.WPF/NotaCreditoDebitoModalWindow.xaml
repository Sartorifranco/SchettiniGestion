<Window x:Class="SchettiniGestion.WPF.NotaCreditoDebitoModalWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Nota de Crédito / Débito" Width="460" SizeToContent="Height" MinHeight="0"

        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"

        Background="{DynamicResource ModuleBackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitulo" Text="Nueva Nota de Crédito/Débito" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryColor}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="NC = crédito del proveedor (baja la deuda). ND = débito (sube la deuda). Es registro interno de compras, no factura electrónica de venta."/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Proveedor *" Style="{StaticResource ModalCaptionTextStyle}"/>

            <Grid Margin="0,0,0,10">

                <TextBox x:Name="txtBuscarProveedor" Style="{StaticResource ModuleTextBoxStyle}" Margin="0"

                         TextChanged="txtBuscarProveedor_TextChanged"/>

                <Popup x:Name="popupProveedores" PlacementTarget="{Binding ElementName=txtBuscarProveedor}" Placement="Bottom" StaysOpen="False">

                    <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" MaxHeight="150">

                        <ListBox x:Name="lstProveedores" Background="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"

                                 DisplayMemberPath="RazonSocial" MouseUp="lstProveedores_MouseUp"/>

                    </Border>

                </Popup>

            </Grid>

            <Grid>

                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Tipo *" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <ComboBox x:Name="cmbTipo" Style="{StaticResource ModuleComboBoxStyle}" Margin="0,0,0,10">

                        <ComboBoxItem Content="NC" IsSelected="True"/>

                        <ComboBoxItem Content="ND"/>

                    </ComboBox>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Monto *" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <TextBox x:Name="txtMonto" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10" Text="0"/>

                </StackPanel>

            </Grid>

            <TextBlock Text="Descripción" Style="{StaticResource ModalCaptionTextStyle}"/>

            <TextBox x:Name="txtDescripcion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Nº Comprobante" Style="{StaticResource ModalCaptionTextStyle}"/>

            <TextBox x:Name="txtNroComprobante" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnCancelar_Click"/>

            <Button Content="✔ Guardar" Style="{StaticResource ButtonStyle}" Click="btnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>

