<Window x:Class="SchettiniGestion.WPF.NotaCreditoVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar Nota de Crédito" Width="980" Height="720"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Generar Nota de Crédito desde venta" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,12" FontSize="12"
                   Text="Elegí TOTAL para anular todo el comprobante o PARCIAL para seleccionar renglones/cantidades o ingresar un importe manual. La nota queda vinculada a la factura original para auditoría."/>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblFactura" Text="Factura #00000000" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,28,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblCliente" Text="Cliente: -" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,28,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblTotal" Text="Total: $ 0,00" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="rbTotal" Content="TOTAL NC (importe completo)" IsChecked="True" GroupName="modoNc"
                         Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                         Padding="8,6" Margin="0,0,14,0" MinHeight="44" VerticalContentAlignment="Center"
                         Cursor="Hand" Checked="Modo_Checked"/>
            <RadioButton x:Name="rbParcial" Content="PARCIAL NC (ítems/cantidades o importe)" GroupName="modoNc"
                         Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                         Padding="8,6" MinHeight="44" VerticalContentAlignment="Center"
                         Cursor="Hand" Checked="Modo_Checked"/>
        </StackPanel>

        <DataGrid Grid.Row="4" x:Name="dgvItems" Style="{StaticResource ModuleDataGridStyle}"
                  AutoGenerateColumns="False" CanUserAddRows="False" FontSize="14" Margin="0,0,0,14"
                  CellEditEnding="dgvItems_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Sel." Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vend." Binding="{Binding CantidadVendida}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cant. NC" Binding="{Binding CantidadNota, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitarioFmt}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Subtotal NC" Binding="{Binding SubtotalNotaFmt}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Importe parcial manual:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="txtMontoManual" Style="{StaticResource ModuleTextBoxStyle}"
                     ToolTip="Opcional. Si se completa, reemplaza la suma de ítems seleccionados."
                     TextChanged="txtMontoManual_TextChanged"/>
            <TextBlock Grid.Column="3" x:Name="lblResumen" Text="Monto a acreditar: $ 0,00" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="6" Margin="0,0,0,16">
            <TextBlock Text="Observaciones / motivo (opcional)" Style="{StaticResource ModalCaptionTextStyle}" FontSize="13"/>
            <TextBlock Text="Se guarda junto con el detalle de origen para dejar trazabilidad de la nota."
                       Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="txtObservaciones" Style="{StaticResource ModuleTextBoxStyle}" Height="64"
                     AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,10,0" Click="btnCancelar_Click"/>
            <Button Content="✔ Generar Nota de Crédito" Style="{StaticResource ButtonStyle}" MinWidth="230" Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
