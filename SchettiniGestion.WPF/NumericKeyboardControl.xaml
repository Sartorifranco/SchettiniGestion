<UserControl x:Class="SchettiniGestion.WPF.NumericKeyboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="250">

    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="{DynamicResource VKKeyFontSize}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}"/>
                <Setter Property="Background" Value="{DynamicResource VKKeyBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource VKKeyCornerRadius}"
                                    BorderBrush="{DynamicResource VKKeyBorder}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Content="7" Click="BtnNum_Click"/>
        <Button Grid.Row="0" Grid.Column="1" Content="8" Click="BtnNum_Click"/>
        <Button Grid.Row="0" Grid.Column="2" Content="9" Click="BtnNum_Click"/>

        <Button Grid.Row="1" Grid.Column="0" Content="4" Click="BtnNum_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Content="5" Click="BtnNum_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Content="6" Click="BtnNum_Click"/>

        <Button Grid.Row="2" Grid.Column="0" Content="1" Click="BtnNum_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Content="2" Click="BtnNum_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Content="3" Click="BtnNum_Click"/>

        <Button Grid.Row="3" Grid.Column="0" Content="C" Background="{DynamicResource DangerColor}" Foreground="White" Click="BtnClear_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Content="0" Click="BtnNum_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Background="{DynamicResource WarningColor}" Foreground="#1A1A1A" Click="BtnBackspace_Click"/>
    </Grid>
</UserControl>
