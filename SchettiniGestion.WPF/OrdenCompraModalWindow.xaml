<Window x:Class="SchettiniGestion.WPF.OrdenCompraModalWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Orden de Compra" Width="720" Height="600"

        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"

        Background="{DynamicResource ModuleBackgroundBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblTitulo" Text="Nueva Orden de Compra" FontSize="16" FontWeight="Bold"

                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,14"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceDark}" CornerRadius="7" Padding="14,10" Margin="0,0,0,10"

                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="200"/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Proveedor *" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <Grid>

                        <TextBox x:Name="txtBuscarProveedor" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10"

                                 TextChanged="txtBuscarProveedor_TextChanged"/>

                        <Popup x:Name="popupProveedores" PlacementTarget="{Binding ElementName=txtBuscarProveedor}" Placement="Bottom" StaysOpen="False">

                            <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" MaxHeight="150">

                                <ListBox x:Name="lstProveedores" Background="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"

                                         DisplayMemberPath="RazonSocial" MouseUp="lstProveedores_MouseUp"/>

                            </Border>

                        </Popup>

                    </Grid>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Fecha Entrega Estimada" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <DatePicker x:Name="dtpFechaEntrega" Margin="0,0,0,10"/>

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <TextBlock Text="Estado" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <ComboBox x:Name="cmbEstado" Style="{StaticResource ModuleComboBoxStyle}" Margin="0,0,0,6" MinHeight="36">

                        <ComboBoxItem Content="Pendiente" IsSelected="True"/>

                        <ComboBoxItem Content="Parcial"/>

                        <ComboBoxItem Content="Recibida"/>

                        <ComboBoxItem Content="Anulada"/>

                    </ComboBox>

                    <TextBlock Text="Total estimado" Style="{StaticResource ModalCaptionTextStyle}" Margin="0,4,0,0"/>

                    <TextBlock x:Name="lblTotal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" Margin="0,2,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" CornerRadius="7" Padding="14,10" Margin="0,0,0,10"

                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="90"/><ColumnDefinition Width="14"/><ColumnDefinition Width="120"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Producto" Style="{StaticResource ModalCaptionTextStyle}"/>

                    <Grid>

                        <TextBox x:Name="txtBuscarProducto" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10"

                                 TextChanged="txtBuscarProducto_TextChanged"/>

                        <Popup x:Name="popupProductos" PlacementTarget="{Binding ElementName=txtBuscarProducto}" Placement="Bottom" StaysOpen="False">

                            <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" MaxHeight="150">

                                <ListBox x:Name="lstProductos" Background="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"

                                         DisplayMemberPath="Descripcion" MouseUp="lstProductos_MouseUp"/>

                            </Border>

                        </Popup>

                    </Grid>

                </StackPanel>

                <StackPanel Grid.Column="2"><TextBlock Text="Cantidad" Style="{StaticResource ModalCaptionTextStyle}"/><TextBox x:Name="txtCantidad" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10" Text="1"/></StackPanel>

                <StackPanel Grid.Column="4"><TextBlock Text="Costo Est." Style="{StaticResource ModalCaptionTextStyle}"/><TextBox x:Name="txtCosto" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,10" Text="0"/></StackPanel>

                <Button Grid.Column="6" Content="+ Agregar" Style="{StaticResource ButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,0,10" Click="btnAgregarItem_Click"/>

            </Grid>

        </Border>

        <DataGrid Grid.Row="3" x:Name="dgvItems" AutoGenerateColumns="False"

                  Style="{StaticResource ModuleDataGridStyle}"

                  CanUserAddRows="False" IsReadOnly="True" FontSize="13" Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>

                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>

                <DataGridTextColumn Header="Costo Est." Binding="{Binding CostoFmt}" Width="110"/>

                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalFmt}" Width="110"/>

                <DataGridTemplateColumn Header="" Width="40">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="✕" Style="{StaticResource DeleteButtonStyle}" Padding="4,2" FontSize="11" Click="btnQuitarItem_Click"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">

            <TextBlock Text="Observaciones" Style="{StaticResource ModalCaptionTextStyle}"/>

            <TextBox x:Name="txtObservaciones" Style="{StaticResource ModuleTextBoxStyle}" Margin="0" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnCancelar_Click"/>

            <Button Content="✔ Guardar Orden" Style="{StaticResource ButtonStyle}" Click="btnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>

