<Window x:Class="SchettiniGestion.WPF.PointCobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobro con Point" Width="520" Height="410"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1" CornerRadius="14" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="12" Padding="16,7">
                    <Image Source="/SCHPOS;component/Resources/mercadopago-logo.png"
                           Width="190" Height="70" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Cobro con Point Smart" FontSize="23" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="lblMonto" FontSize="42" FontWeight="Bold"
                           Foreground="#009EE3" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblEstado" Text="Preparando terminal..."
                           Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,10"/>
                <ProgressBar x:Name="prgEspera" IsIndeterminate="True" Height="7" Width="320"
                             Foreground="#009EE3" Background="{DynamicResource SurfaceDark}"/>
                <TextBlock Text="El cliente debe completar el pago en el Point."
                           Foreground="{DynamicResource TextSecondary}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>

            <Button x:Name="btnCancelar" Grid.Row="2" Content="Cancelar cobro"
                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"
                    MinWidth="150" Click="btnCancelar_Click"/>
        </Grid>
    </Border>
</Window>
