<UserControl x:Class="SchettiniGestion.WPF.PreciosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BackgroundDark}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="220" MaxWidth="420"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Actualizar Precios" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="🔍 BUSCAR (Cód/Nombre)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtBuscar" Style="{StaticResource ModernTextBox}" KeyUp="txtBuscar_KeyUp" GotFocus="TextBox_GotFocus" Margin="0,0,0,10"/>

                    <TextBlock Text="PRODUCTO" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtDescripcion" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="COSTO" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtCosto" Style="{StaticResource ModernTextBox}" PreviewTextInput="SoloNumeros" GotFocus="TextBox_GotFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRECIO VENTA" Style="{StaticResource LabelStyle}" Foreground="{StaticResource SuccessColor}"/>
                            <TextBox x:Name="txtPrecioVenta" Style="{StaticResource ModernTextBox}" PreviewTextInput="SoloNumeros" GotFocus="TextBox_GotFocus" FontWeight="Bold" BorderBrush="{StaticResource SuccessColor}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="btnGuardar" Content="💾 GUARDAR CAMBIO" Click="btnGuardar_Click" Style="{StaticResource ButtonStyle}" Margin="0,15,0,0" Height="45"/>
                </StackPanel>

                <Viewbox Grid.Row="3" VerticalAlignment="Bottom" Stretch="Uniform">
                    <Grid Width="300" Height="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="7" Grid.Row="0" Grid.Column="0" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="8" Grid.Row="0" Grid.Column="1" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="9" Grid.Row="0" Grid.Column="2" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>

                        <Button Content="4" Grid.Row="1" Grid.Column="0" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="5" Grid.Row="1" Grid.Column="1" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="6" Grid.Row="1" Grid.Column="2" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>

                        <Button Content="1" Grid.Row="2" Grid.Column="0" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="2" Grid.Row="2" Grid.Column="1" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="3" Grid.Row="2" Grid.Column="2" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>

                        <Button Content="C" Grid.Row="3" Grid.Column="0" Click="BtnClear_Click" Style="{StaticResource SecondaryButtonStyle}" Background="{StaticResource DangerColor}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="0" Grid.Row="3" Grid.Column="1" Click="BtnNum_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                        <Button Content="⌫" Grid.Row="3" Grid.Column="2" Click="BtnBorrar_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="3" Focusable="False" FontSize="24"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Listado de Productos" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="10,10,0,5"/>

                <DataGrid x:Name="gridProductos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0"
                          SelectionChanged="gridProductos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="COSTO" Binding="{Binding PrecioCosto, StringFormat=C2}" Width="Auto"/>
                        <DataGridTextColumn Header="VENTA" Binding="{Binding PrecioVenta, StringFormat=C2}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>