<Window x:Class="SchettiniGestion.WPF.PrimerUsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración Inicial — SCHPOS"
        Width="660" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Tarjeta de modo con efecto seleccionado -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceDark}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12,12,0,0"
                    Padding="24,16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource PrimaryColor}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Configuración Inicial — SCHPOS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="¿Cómo vas a usar SCHPOS en tu negocio?" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Contenido -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,20,28,0">

                    <!-- PASO 1: Elegir modo -->
                    <TextBlock Text="Paso 1 — Elegí cómo usar SCHPOS" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                    <!-- Tarjeta: Solo esta PC -->
                    <RadioButton x:Name="rbSoloPC" Style="{StaticResource ModeCard}" IsChecked="True"
                                 Checked="rbModo_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💻" FontSize="26" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Solo en esta PC" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Un único equipo, sin red. Ideal para negocios con una sola caja." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- Tarjeta: Esta PC es el Servidor -->
                    <RadioButton x:Name="rbServidor" Style="{StaticResource ModeCard}" Checked="rbModo_Checked" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🖥️" FontSize="26" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Esta PC es el SERVIDOR de la red" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Los datos se guardan aquí y otras PCs se conectan a esta." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="Requiere SQL Server Express instalado en esta PC." FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <!-- Tarjeta: Conectarme a servidor -->
                    <RadioButton x:Name="rbCliente" Style="{StaticResource ModeCard}" Checked="rbModo_Checked" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐" FontSize="26" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Conectarme a otro servidor (soy cliente)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Ya hay un SERVIDOR configurado en la red. Solo necesito la IP." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </RadioButton>

                    <TextBlock x:Name="txtNotaConexionRed" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"
                               Text="La conexión en red (servidor + varias PCs) requiere activar la licencia con el extra «Conexión en RED». Luego podés configurarla en Configuración › Red y Servidor."/>

                    <!-- Panel: Solo PC / Servidor (Express local) -->
                    <StackPanel x:Name="panelExpress" Visibility="Collapsed" Margin="0,4,0,0">
                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,12"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Instancia SQL Server a usar:" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtInstanciaServidor" Style="{StaticResource ModuleTextBoxStyle}"
                                             Text=".\SQLEXPRESS" Height="38" FontSize="13" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="🔍 Detectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,9" Click="btnDetectarInstancias_Click"/>
                                </Grid>
                                <TextBlock Text="Ejemplos: .\SQLEXPRESS  •  localhost\SQLEXPRESS  •  .\MSSQLSERVER"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Aviso SQL Express no encontrado -->
                        <Border x:Name="panelAvisoExpress" Visibility="Collapsed"
                                Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10"
                                BorderBrush="#E67E22" BorderThickness="2,0,0,0" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="⚠️  SQL Server Express no detectado" FontWeight="SemiBold"
                                           Foreground="#E67E22" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Text="Para usar en red necesitás SQL Server Express (gratuito). Descargalo desde:"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource PrimaryColor}" Cursor="Hand"
                                           Text="https://aka.ms/sqlexpress" Margin="0,4,0,0"
                                           MouseLeftButtonDown="LinkDescarga_Click"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                                           Text="Después de instalarlo, volvé a abrir SCHPOS y elegí 'Esta PC es el SERVIDOR'."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Panel: Cliente de red -->
                    <StackPanel x:Name="panelCliente" Visibility="Collapsed" Margin="0,4,0,0">
                        <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,12"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="IP o nombre del servidor:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtIPServidor" Style="{StaticResource ModuleTextBoxStyle}"
                                             Height="44" FontSize="16" VerticalContentAlignment="Center"
                                             Tag="network"
                                             Text="" xml:space="preserve"
                                             GotFocus="txtIPServidor_GotFocus"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Puerto (opcional):" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtPuertoCliente" Style="{StaticResource ModuleTextBoxStyle}"
                                                 Height="44" FontSize="14" VerticalContentAlignment="Center"
                                                 Text="1433" Tag="numeric"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                           Text="Ejemplo: 192.168.1.100  •  192.168.1.100\SQLEXPRESS  •  SERVIDOR"/>
                                <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextSecondary}" FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Text="💡 Si usás instancia nombrada (ej. IP\SQLEXPRESS), el puerto puede ser dinámico. Dejá el campo Puerto vacío para que SQL Browser lo resuelva, o ingresá el puerto exacto desde SQL Server Configuration Manager."/>

                                <!-- Auth -->
                                <Separator Margin="0,10,0,10" Background="{DynamicResource BorderColor}"/>
                                <TextBlock Text="Autenticación:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <RadioButton x:Name="rbWinAuth" Content="Windows (sin contraseña)" IsChecked="True"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             Checked="rbAuth_Checked" Margin="0,0,0,6"/>
                                <RadioButton x:Name="rbSqlAuth" Content="Usuario y contraseña SQL"
                                             Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                             Checked="rbAuth_Checked"/>

                                <StackPanel x:Name="panelSqlAuth" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Usuario:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtUsuarioCliente" Style="{StaticResource ModuleTextBoxStyle}"
                                                     Height="40" FontSize="13" VerticalContentAlignment="Center" Text="sa"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Contraseña:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="txtPasswordCliente" Style="{StaticResource ModulePasswordBoxStyle}"
                                                         Height="40" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Separador -->
                    <Separator Margin="0,8,0,12" Background="{DynamicResource BorderColor}"/>

                    <!-- Estado del test -->
                    <Border x:Name="borderTest" Background="{DynamicResource SurfaceDark}" CornerRadius="8"
                            Padding="14,10" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="iconTest" Text="⚪" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="lblTestTitle" Text="Listo para probar" FontWeight="Bold"
                                           FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="lblTestDesc" Text="Presioná 'Probar conexión' para verificar."
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="28,14,28,20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="🔌  Probar conexión" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,10" Click="btnTestear_Click"/>
                    <Button Grid.Column="3" x:Name="btnContinuar" Content="✔  Continuar" Style="{StaticResource ButtonStyle}"
                            Padding="20,10" IsEnabled="False" Click="btnContinuar_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
