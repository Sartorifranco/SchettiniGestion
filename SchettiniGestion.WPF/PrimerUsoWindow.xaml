<Window x:Class="SchettiniGestion.WPF.PrimerUsoWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Configuración Inicial — Schettini Gestión"

        Width="620" Height="560"

        WindowStartupLocation="CenterScreen"

        ResizeMode="NoResize"

        Background="Transparent"

        WindowStyle="None"

        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="StepBtn" TargetType="RadioButton">

            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,7">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceDark}"/>

                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Border CornerRadius="12" Background="{DynamicResource ModuleBackgroundBrush}"

            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12,12,0,0" Padding="24,16"

                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"

                    MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="⚙" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource PrimaryColor}"/>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Configuración Inicial" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Configure la conexión a la base de datos para comenzar" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

                    </StackPanel>

                </StackPanel>

            </Border>



            <StackPanel Grid.Row="1" Margin="28,20,28,0">



                <TextBlock Text="Tipo de instalación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,16"

                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

                    <StackPanel>

                        <RadioButton x:Name="rbLocalDB" Style="{StaticResource StepBtn}" IsChecked="True"

                                     Checked="rbTipo_Checked">

                            <StackPanel>

                                <TextBlock Text="💻  PC única (recomendado para instalaciones nuevas)" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock Text="Usa SQL Server LocalDB — se instala automáticamente, sin configuración." FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton x:Name="rbExpress" Style="{StaticResource StepBtn}" Checked="rbTipo_Checked">

                            <StackPanel>

                                <TextBlock Text="🗄  SQL Server Express local (ya instalado)" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock Text="Para quien ya tiene SQL Server Express en esta PC." FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton x:Name="rbCustom" Style="{StaticResource StepBtn}" Checked="rbTipo_Checked">

                            <StackPanel>

                                <TextBlock Text="🌐  Servidor de red / personalizado" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock Text="Para instalaciones en red con servidor dedicado." FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>

                            </StackPanel>

                        </RadioButton>

                    </StackPanel>

                </Border>



                <StackPanel x:Name="panelCustom" Visibility="Collapsed">

                    <TextBlock Text="Cadena de conexión:" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>

                    <TextBox x:Name="txtConexion" Style="{StaticResource ModuleTextBoxStyle}" Height="70" TextWrapping="Wrap"

                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"

                             Text="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=SchPosDB;Integrated Security=True;Encrypt=False;"/>

                    <TextBlock Text="Ejemplo: Data Source=SERVIDOR\SQLEXPRESS;Initial Catalog=SchPosDB;User Id=sa;Password=xxx;Encrypt=False;"

                               FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                </StackPanel>



                <Border x:Name="borderTest" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,16,0,0"

                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock x:Name="iconTest" Text="⚪" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextSecondary}"/>

                        <StackPanel>

                            <TextBlock x:Name="lblTestTitle" Text="Listo para probar la conexión" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock x:Name="lblTestDesc" Text="Presione 'Probar conexión' para verificar antes de continuar." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

                        </StackPanel>

                    </StackPanel>

                </Border>



                <Border x:Name="panelInfoLocalDB" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0"

                        BorderBrush="{StaticResource SuccessColor}" BorderThickness="2,0,0,0">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="ℹ" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource SuccessColor}"/>

                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"

                                   Text="LocalDB viene incluido con .NET Framework y Visual Studio Runtime. Si el test falla, instale 'SQL Server LocalDB' desde la página de Microsoft (gratuito)."/>

                    </StackPanel>

                </Border>



            </StackPanel>



            <Border Grid.Row="2" Padding="28,14,28,20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="8"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="🔌  Probar conexión" Style="{StaticResource SecondaryButtonStyle}"

                            Padding="16,9" Click="btnTestear_Click"/>

                    <Button Grid.Column="3" x:Name="btnContinuar" Content="✔  Continuar" Style="{StaticResource ButtonStyle}"

                            Padding="20,9" IsEnabled="False" Click="btnContinuar_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>

