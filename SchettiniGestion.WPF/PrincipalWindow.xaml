<Window x:Class="SchettiniGestion.WPF.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SchettiniGestion · Versión Lite"
        Icon="Resources/logo.png"
        MinWidth="880"
        MinHeight="560"
        Height="768"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ModuleBackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="LiteNavButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource MenuSidebarHoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiteDangerOutlineButton" TargetType="Button" BasedOn="{StaticResource LiteNavButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceDark}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,12">
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            CornerRadius="12"
                            Padding="10"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <Image Source="Resources/logo.png"
                               Height="52"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Versión Lite"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,0,12,0">
                    <StackPanel>
                        <TextBlock Text="MENÚ"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="4,0,0,10"/>
                        <Button x:Name="btnInicio"
                                Content="🏠  Inicio"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnInicio_Click"/>
                        <Button x:Name="btnVentasFacturacion"
                                Content="🛒  Ventas y facturación"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnVentasFacturacion_Click"/>
                        <Button x:Name="btnProductos"
                                Content="📦  Productos (stock)"
                                Style="{StaticResource LiteNavButton}"
                                Click="productosMenuItem_Click"/>
                        <Button x:Name="btnClientes"
                                Content="👥  Clientes"
                                Style="{StaticResource LiteNavButton}"
                                Click="clientesMenuItem_Click"/>
                        <Button x:Name="btnCaja"
                                Content="💵  Caja"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnCaja_Click"/>
                        <Button x:Name="btnUsuariosPermisos"
                                Content="👤  Usuarios y permisos"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnUsuariosPermisos_Click"/>
                        <Button x:Name="btnConfiguracion"
                                Content="⚙️  Configuración"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnConfiguracion_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="12,10,12,16">
                    <Button x:Name="btnCerrarSesion"
                            Content="🚪  Cerrar sesión"
                            Style="{StaticResource LiteNavButton}"
                            Click="btnCerrarSesion_Click"/>
                    <Button x:Name="btnSalirSistema"
                            Content="Salir del sistema"
                            Style="{StaticResource LiteDangerOutlineButton}"
                            Margin="0,4,0,0"
                            Click="btnSalirSistema_Click"/>
                    <TextBlock Text="v1.0 · MVP"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceDark}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <Run Text="Panel principal"/>
                        <Run Text=" · " Foreground="{DynamicResource BorderColor}"/>
                        <Run Text="SchettiniGestion" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Pantalla:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbModoPantalla"
                                      MinHeight="40"
                                      MinWidth="220"
                                      MaxWidth="420"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"
                                      SelectionChanged="cmbModoPantalla_SelectionChanged"
                                      ToolTip="Pantalla única: solo el monitor del cajero. Dos pantallas: visor del cliente en el segundo monitor (si está conectado).">
                                <ComboBoxItem Content="Pantalla única (un monitor)" Tag="0"/>
                                <ComboBoxItem Content="Cajero + pantalla cliente (dos monitores)" Tag="1"/>
                            </ComboBox>

                            <Button x:Name="btnTema"
                                    Click="btnTema_Click"
                                    MinHeight="44"
                                    MinWidth="132"
                                    Margin="0,0,10,0"
                                    Padding="12,8"
                                    Cursor="Hand"
                                    ToolTip="Cambiar tema claro/oscuro (toda la aplicación)"
                                    Background="{DynamicResource HoverBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtIconoTema" Text="&#9728;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="txtTema" Text="Tema oscuro" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTeclado"
                                    Click="btnTeclado_Click"
                                    MinHeight="44"
                                    Padding="12,8"
                                    Margin="0,0,16,0"
                                    Cursor="Hand"
                                    Background="{DynamicResource HoverBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource TextPrimary}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌨" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Teclado" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Ellipse Width="36" Height="36" Fill="{StaticResource PrimaryColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtUsuarioLogueado"
                                           Text="Usuario"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                                <TextBlock x:Name="txtRolLogueado"
                                           Text="En línea"
                                           Foreground="{StaticResource SuccessColor}"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    Padding="12,12,16,16">
                <ContentControl x:Name="mainContentArea"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>
</Window>
