<Window x:Class="SchettiniGestion.WPF.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SCHPOS"
        MinWidth="960"
        MinHeight="600"
        Height="768"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ModuleBackgroundBrush}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <QuadraticEase x:Key="LogoEase" EasingMode="EaseInOut"/>
        <Style x:Key="LiteNavButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource MenuSidebarHoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiteNavButtonActive" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{DynamicResource HoverBackground}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                BorderThickness="3,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiteDangerOutlineButton" TargetType="Button" BasedOn="{StaticResource LiteNavButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="colMenuLateral" Width="290" MinWidth="72" MaxWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="bdrMenuLateral" Grid.Column="0"
                Background="{DynamicResource SurfaceDark}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,16,12,8">
                    <StackPanel x:Name="pnlLogoMenu" Margin="0,0,48,0">
                        <!-- Logo sin recuadro: S + rayo más grande, con pulso suave del rayo -->
                        <Viewbox x:Name="vbLogoMenu" Stretch="Uniform" MaxHeight="78" Margin="4,4,4,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform x:Name="logoScale" ScaleX="1" ScaleY="1"/>
                            </Viewbox.RenderTransform>
                            <Viewbox.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Respiración muy sutil del logo completo -->
                                            <DoubleAnimation Storyboard.TargetName="logoScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="1" To="1.04" Duration="0:0:2.4"
                                                             AutoReverse="True"
                                                             EasingFunction="{StaticResource LogoEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="logoScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="1" To="1.04" Duration="0:0:2.4"
                                                             AutoReverse="True"
                                                             EasingFunction="{StaticResource LogoEase}"/>
                                            <!-- El rayo parpadea un poco más (presencia, sin ruido) -->
                                            <DoubleAnimation Storyboard.TargetName="pathRayoLogo"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.55" To="1" Duration="0:0:1.6"
                                                             AutoReverse="True"
                                                             EasingFunction="{StaticResource LogoEase}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Viewbox.Triggers>
                            <Canvas Width="1000" Height="1000">
                                <Path Fill="{DynamicResource TextPrimary}" StrokeThickness="0"
                                      Data="M399.565,632.348c13.896-52.446,27.503-103.808,41.473-156.532c25.221,0,50.974-0.014,76.724,0c16.758,0.006,33.525,0.316,50.279,0.017c25.131-0.45,41.236-18.275,38.875-42.188c-1.117-11.36-7.129-18.76-17.697-21.915c-5.996-1.786-12.504-2.547-18.783-2.565c-59.672-0.153-119.344-0.035-179.016-0.014c-59.863,0.018-107.28-36.393-119.41-92.252c-2.301-10.599-2.63-21.62-3.98-33.382c11.36,0,20.988-0.007,30.615,0c104.585,0.048,209.181,0.018,313.769,0.186c35.531,0.065,68.391,7.979,95,33.661c29.24,28.228,38.078,63.776,36.531,102.689c-1.576,39.816-10.797,77.574-34.637,110.483c-24.316,33.566-58.232,51.262-98.662,55.018c-27.268,2.539-54.883,1.52-82.338,1.666c-6.016,0.036-8.872,1.855-10.453,7.773c-2.839,10.666-6.357,21.166-10.076,31.56c-0.822,2.304-3.637,5.535-5.557,5.554C468.428,632.443,434.638,632.348,399.565,632.348z"/>
                                <Path Fill="{DynamicResource TextPrimary}" StrokeThickness="0"
                                      Data="M775.879,109.232c-12.541,26.458-23.209,51.369-35.951,75.169c-13.104,24.479-36.051,34.511-62.783,34.669c-73.379,0.427-146.762,0.171-220.15-0.076c-25.9-0.09-35.315,5.634-45.805,28.952c-0.97,2.14-4.111,4.697-6.257,4.71c-44.159,0.272-88.314,0.204-134.372,0.204c2.826-10.645,4.797-20.357,7.968-29.661c19.313-56.646,54.73-96.87,115.123-110.699c9.702-2.225,19.913-3.097,29.894-3.11c114.599-0.221,229.195-0.152,343.802-0.159C769.33,109.232,771.314,109.232,775.879,109.232z"/>
                                <Path Fill="{DynamicResource TextPrimary}" StrokeThickness="0"
                                      Data="M227.164,571.84c10.711-31.193,20.805-60.859,31.232-90.403c0.75-2.121,3.924-4.798,5.984-4.814c42.769-0.281,85.538-0.213,129.526-0.213c-6.156,20.119-12.01,39.13-17.785,58.159c-3.1,10.239-5.684,20.662-9.335,30.693c-1.007,2.751-5.017,6.273-7.674,6.303C315.616,571.955,272.123,571.84,227.164,571.84z"/>
                                <Path x:Name="pathRayoLogo"
                                      Fill="{DynamicResource TextPrimary}" StrokeThickness="0" Opacity="0.85"
                                      Data="M511.371,763.315c-11.119,16.787-47.681,64.383-46.997,64.818c1.477,0.948,119.05-83.42,118.921-84.532c-0.055-0.522-67.157-2.033-67.157-2.033c13.589-17.523,45.974-59.321,43.638-59.397c-1.822-0.056-118.219,77.578-118.102,78.685C441.728,761.398,511.371,763.315,511.371,763.315z"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                    <Button x:Name="btnToggleMenuLateral" Content="◀" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="44" Height="44" Click="btnToggleMenuLateral_Click"
                            ToolTip="Ocultar / mostrar menú"
                            Background="{DynamicResource HoverBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="scrollMenuNav" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,0,12,0">
                    <StackPanel>
                        <TextBlock x:Name="txtMenuTitulo" Text="MENÚ"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="4,0,0,10"/>
                        <Button x:Name="btnInicio"
                                Content="🏠  Resumen del día"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnInicio_Click"/>
                        <Button x:Name="btnVentasFacturacion"
                                Content="🛒  Ventas y facturación"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnVentasFacturacion_Click"/>
                        <Button x:Name="btnProductos"
                                Content="🛍️  Productos (catálogo)"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnProductos_Click"/>
                        <Button x:Name="btnEtiquetas"
                                Content="🏷️  Etiquetas"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnEtiquetas_Click"/>
                        <Button x:Name="btnGestionStock"
                                Content="📦  Stock y movimientos"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnGestionStock_Click"/>
                        <Button x:Name="btnListasPrecios"
                                Content="🏷️  Listas de precios"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnListasPrecios_Click"/>
                        <Button x:Name="btnPromociones"
                                Content="🎯  Promociones"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnPromociones_Click"/>
                        <Button x:Name="btnClientes"
                                Content="👥  Clientes"
                                Style="{StaticResource LiteNavButton}"
                                Click="clientesMenuItem_Click"/>
                        <Button x:Name="btnCaja"
                                Content="💵  Caja / tesorería"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnCaja_Click"/>
                        <Button x:Name="btnEstadisticas"
                                Content="📊  Gráficos y Estadísticas"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnEstadisticas_Click"/>
                        <Button x:Name="btnUsuariosPermisos"
                                Content="👤  Usuarios / Subusuarios"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnUsuariosPermisos_Click"/>
                        <Button x:Name="btnConfiguracion"
                                Content="⚙️  Configuración del sistema"
                                Style="{StaticResource LiteNavButton}"
                                Click="btnConfiguracion_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="pnlMenuInferior" Grid.Row="2" Margin="12,10,12,16">
                    <Button x:Name="btnCerrarSesion"
                            Content="🚪  Cerrar sesión"
                            Style="{StaticResource LiteNavButton}"
                            Click="btnCerrarSesion_Click"/>
                    <Button x:Name="btnSalirSistema"
                            Content="Salir del sistema"
                            Style="{StaticResource LiteDangerOutlineButton}"
                            Margin="0,4,0,0"
                            Click="btnSalirSistema_Click"/>
                    <TextBlock x:Name="txtVersionFooter" Text="v2.4.1"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="bdrHeaderPrincipal" Grid.Row="0"
                    Background="{DynamicResource SurfaceDark}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="rowBreadcrumb" Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtBreadcrumbHeader" Grid.Row="0"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <Run Text="Panel principal"/>
                        <Run Text=" · " Foreground="{DynamicResource BorderColor}"/>
                        <Run Text="SCHPOS" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Pantalla:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbModoPantalla"
                                      Style="{StaticResource TouchComboBoxStyle}"
                                      MinHeight="44"
                                      MinWidth="220"
                                      MaxWidth="420"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"
                                      SelectionChanged="cmbModoPantalla_SelectionChanged"
                                      ToolTip="Pantalla única: solo el monitor del cajero (recomendado en una sola PC). Dos pantallas: visor del cliente en el segundo monitor si está conectado. Las promociones (carpeta de imágenes/videos) se configuran en Configuración › Negocio.">
                                <ComboBoxItem Content="Pantalla única (un monitor)" Tag="0"/>
                                <ComboBoxItem Content="Cajero + pantalla cliente (dos monitores)" Tag="1"/>
                            </ComboBox>

                            <Button x:Name="btnTema"
                                    Click="btnTema_Click"
                                    MinHeight="44"
                                    MinWidth="132"
                                    Margin="0,0,10,0"
                                    Padding="12,8"
                                    Cursor="Hand"
                                    ToolTip="Cambiar tema claro/oscuro (toda la aplicación)"
                                    Background="{DynamicResource HoverBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtIconoTema" Text="&#9728;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="txtTema" Text="Tema oscuro" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTeclado"
                                    Click="btnTeclado_Click"
                                    MinHeight="44"
                                    Padding="12,8"
                                    Margin="0,0,16,0"
                                    Cursor="Hand"
                                    Background="{DynamicResource HoverBackground}"
                                    BorderBrush="{DynamicResource VKAccentBar}"
                                    BorderThickness="2"
                                    Foreground="{DynamicResource TextPrimary}"
                                    ToolTip="Activar / desactivar teclado táctil">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtIconoTeclado" Text="⌨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtLabelTeclado" Text="Teclado ON" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Ellipse Width="36" Height="36" Fill="{StaticResource PrimaryColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtUsuarioLogueado"
                                           Text="Usuario"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                                <TextBlock x:Name="txtRolLogueado"
                                           Text="En línea"
                                           Foreground="{StaticResource SuccessColor}"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="bdrContenidoPrincipal"
                    Grid.Row="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    Padding="8,4,10,8"
                    ClipToBounds="True">
                <ContentControl x:Name="mainContentArea"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>
</Window>
