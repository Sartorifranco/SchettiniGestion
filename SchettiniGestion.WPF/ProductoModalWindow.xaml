<Window x:Class="SchettiniGestion.WPF.ProductoModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchettiniGestion.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Producto" Height="720" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="txtTitulo" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Códigos -->
                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Código"/>
                        <TextBox x:Name="txtCodigo" Width="140" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Código de Barra"/>
                        <TextBox x:Name="txtCodigoBarra" Width="180" Padding="4"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Código Externo"/>
                        <TextBox x:Name="txtCodigoExterno" Width="140" Padding="4"/>
                    </StackPanel>
                    <CheckBox x:Name="chkGenerarCodigoBarra" Content="Generar CB automático" VerticalAlignment="Bottom" Margin="0,0,12,4"/>
                </WrapPanel>

                <!-- Descripción -->
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Descripción"/>
                    <TextBox x:Name="txtDescripcion" Padding="4"/>
                </StackPanel>

                <!-- Categorías y proveedor -->
                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Categoría"/>
                        <ComboBox x:Name="cmbCategoria" Width="160" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Sub-rubro"/>
                        <ComboBox x:Name="cmbSubRubro" Width="160" IsEditable="True"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Proveedor"/>
                        <ComboBox x:Name="cmbProveedor" Width="200" IsEditable="True"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Precios -->
                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="IVA"/>
                        <ComboBox x:Name="cmbTipoIVA" Width="100">
                            <ComboBoxItem Content="21.0"/>
                            <ComboBoxItem Content="10.5"/>
                            <ComboBoxItem Content="0.0"/>
                            <ComboBoxItem Content="27.0"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Moneda"/>
                        <ComboBox x:Name="cmbTipoMoneda" Width="90">
                            <ComboBoxItem Content="ARS" IsSelected="True"/>
                            <ComboBoxItem Content="USD"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Costo"/>
                        <xctk:DecimalUpDown x:Name="numCosto" Width="120" Minimum="0" FormatString="N2"
                                            ValueChanged="CalcularPrecio_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Ganancia %"/>
                        <xctk:DecimalUpDown x:Name="numGanancia" Width="100" Minimum="0" FormatString="N2"
                                            ValueChanged="CalcularPrecio_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Precio Venta"/>
                        <xctk:DecimalUpDown x:Name="numPrecioFinal" Width="120" Minimum="0" FormatString="N2"
                                            ValueChanged="CalcularPrecio_ValueChanged"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Listas de precio -->
                <TextBlock x:Name="txtSinListas" Text="(Sin listas de precio configuradas)" Foreground="Gray" Margin="0,0,0,4" Visibility="Collapsed"/>
                <ItemsControl x:Name="pnlListasPrecio" Margin="0,0,0,6"/>

                <!-- Stock -->
                <StackPanel x:Name="pnlStockCantidades" Margin="0,0,0,6">
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Stock Actual"/>
                            <xctk:DecimalUpDown x:Name="numStockDisponible" Width="100" Minimum="0" FormatString="N0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Stock Mínimo"/>
                            <xctk:DecimalUpDown x:Name="numStockMinimo" Width="100" Minimum="0" FormatString="N0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Stock Ideal"/>
                            <xctk:DecimalUpDown x:Name="numStockIdeal" Width="100" Minimum="0" FormatString="N0"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- Opciones -->
                <WrapPanel Margin="0,0,0,6">
                    <CheckBox x:Name="chkPermiteModificarPrecioVenta" Content="Permite modificar precio en venta" Margin="0,0,16,4"/>
                    <CheckBox x:Name="chkEsStockeable" Content="Stockeable" Margin="0,0,16,4"/>
                    <CheckBox x:Name="chkAceptaStockNegativo" Content="Acepta stock negativo" Margin="0,0,16,4"/>
                    <CheckBox x:Name="chkUsaVariantes" Content="Usa variantes" Margin="0,0,16,4"/>
                    <CheckBox x:Name="chkEsCombo" Content="Es combo" Margin="0,0,16,4"/>
                </WrapPanel>

                <!-- Variantes -->
                <StackPanel x:Name="pnlVariantes" Margin="0,0,0,6" Visibility="Collapsed">
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Color"/>
                            <TextBox x:Name="txtVarianteColor" Width="120" Padding="4"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Talle"/>
                            <TextBox x:Name="txtVarianteTalle" Width="100" Padding="4"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Unidad Medida"/>
                            <TextBox x:Name="txtVarianteUnidadMedida" Width="120" Padding="4"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- Combo -->
                <StackPanel x:Name="pnlCombo" Margin="0,0,0,6" Visibility="Collapsed">
                    <TextBlock Text="Componentes (uno por línea: codigo,cantidad)"/>
                    <TextBox x:Name="txtComponentes" AcceptsReturn="True" Height="80" Padding="4" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Imagen -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="80" Height="80" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,12,0">
                        <Image x:Name="imgProducto" Stretch="Uniform"/>
                    </Border>
                    <Button Content="Cambiar imagen" Width="120" Height="30" VerticalAlignment="Center"
                            Click="btnCambiarImagen_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btnDuplicar" Content="Duplicar" Width="90" Height="32" Margin="0,0,8,0"
                    Click="btnDuplicar_Click" Visibility="Collapsed"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="90" Height="32" Margin="0,0,8,0"
                    Click="btnEliminar_Click" Visibility="Collapsed"/>
            <Button x:Name="btnCrearYOtro" Content="Guardar y Crear otro" Width="140" Height="32" Margin="0,0,8,0"
                    Click="btnCrearYOtro_Click"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="90" Height="32"
                    Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
