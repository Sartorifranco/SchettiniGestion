<UserControl x:Class="SchettiniGestion.WPF.ProductosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SchettiniGestion.WPF"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource ModuleBackgroundBrush}"
             Loaded="ProductosControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestión de Productos" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="5" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Código Interno:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <TextBox x:Name="txtCodigo" Style="{StaticResource ModuleTextBoxStyle}" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Código de Barras:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <TextBox x:Name="txtCodigoBarra" Style="{StaticResource ModuleTextBoxStyle}" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Descripción / Nombre:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <TextBox x:Name="txtDescripcion" Style="{StaticResource ModuleTextBoxStyle}" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Rubro / Categoría:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <ComboBox x:Name="cmbCategoria" Style="{StaticResource ModuleComboBoxStyle}" FontSize="16" IsEditable="True">
                        <ComboBoxItem Content="Almacén"/>
                        <ComboBoxItem Content="Bebidas"/>
                        <ComboBoxItem Content="Limpieza"/>
                        <ComboBoxItem Content="Kiosco"/>
                        <ComboBoxItem Content="Varios"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tipo de IVA:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <ComboBox x:Name="cmbTipoIVA" Style="{StaticResource ModuleComboBoxStyle}" FontSize="16" Margin="0,0,0,10">
                        <ComboBoxItem Content="21% (General)" IsSelected="True"/>
                        <ComboBoxItem Content="10.5% (Reducido)"/>
                        <ComboBoxItem Content="27% (Servicios)"/>
                        <ComboBoxItem Content="0% (Exento)"/>
                    </ComboBox>

                    <TextBlock Text="Costo ($):" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <xctk:DecimalUpDown x:Name="numCosto" Style="{StaticResource ModuleNumericUpDownStyle}" FontSize="16" FormatString="N2" Margin="0,0,0,10"
                                        ValueChanged="CalcularPrecio_ValueChanged"/>

                    <TextBlock Text="% Ganancia:" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <xctk:DecimalUpDown x:Name="numGanancia" Style="{StaticResource ModuleNumericUpDownStyle}" FontSize="16" Value="30" Minimum="0" Margin="0,0,0,10"
                                        ValueChanged="CalcularPrecio_ValueChanged"/>

                    <TextBlock Text="Imp. Internos ($):" Style="{StaticResource ModuleLabelStyle}" FontSize="16"/>
                    <xctk:DecimalUpDown x:Name="numImpInterno" Style="{StaticResource ModuleNumericUpDownStyle}" FontSize="16" FormatString="N2" Margin="0,0,0,10"
                                        ValueChanged="CalcularPrecio_ValueChanged"/>

                    <TextBlock Text="PRECIO FINAL:" Style="{StaticResource ModuleLabelStyle}" FontSize="16" Foreground="#4CAF50"/>
                    <xctk:DecimalUpDown x:Name="numPrecioFinal" Style="{StaticResource ModuleNumericUpDownStyle}" FontSize="18" FontWeight="Bold" FormatString="C2" Background="#E8F5E9"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="5" Height="120" Margin="0,0,0,10">
                        <Image x:Name="imgProducto" Stretch="Uniform" Source="pack://application:,,,/SchettiniGestion.WPF;component/Resources/no-image.png"/>
                    </Border>
                    <Button x:Name="btnSeleccionarImagen" Content="📷 Subir Foto" Style="{StaticResource ActionButtonStyle}" Click="btnSeleccionarImagen_Click" Margin="0,0,0,20"/>

                    <Button x:Name="btnImportarExcel" Content="📗 Importar Excel" 
                            Style="{StaticResource ActionButtonStyle}" 
                            Background="#1D6F42" Height="45" FontSize="16" Margin="0,0,0,10"
                            Click="btnImportarExcel_Click"/>
                    <Button x:Name="btnNuevo" Content="➕ Nuevo" Style="{StaticResource ActionButtonStyle}" Height="45" FontSize="16" Click="btnNuevo_Click"/>
                    <Button x:Name="btnGuardar" Content="💾 Guardar" Style="{StaticResource ActionButtonStyle}" Height="45" FontSize="16" Background="#00A86B" Click="btnGuardar_Click"/>
                    <Button x:Name="btnEliminar" Content="❌ Eliminar" Style="{StaticResource DeleteButtonStyle}" Height="45" FontSize="16" Click="btnEliminar_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgvProductos" Grid.Row="2" Style="{StaticResource ModuleDataGridStyle}" 
                  AutoGenerateColumns="False" SelectionChanged="dgvProductos_SelectionChanged" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Rubro" Binding="{Binding Categoria}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Costo" Binding="{Binding PrecioCosto, StringFormat=C2}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Venta" Binding="{Binding PrecioVenta, StringFormat=C2}" Width="100" IsReadOnly="True" FontWeight="Bold"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>