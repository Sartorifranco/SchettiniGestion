<UserControl x:Class="SchettiniGestion.WPF.ProductosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="ProductosControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Buscar por: Código, Código barras, Descripción, Rubro, SubRubro, Marca, Proveedor" Style="{StaticResource LabelStyle}" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtFiltro" Style="{StaticResource ModernTextBox}" TextChanged="txtFiltro_TextChanged"/>
                    <CheckBox x:Name="chkMostrarInactivos"
                              Content="Mostrar productos deshabilitados"
                              Margin="0,8,0,0"
                              Foreground="{DynamicResource TextSecondary}"
                              Checked="chkMostrarInactivos_Checked"
                              Unchecked="chkMostrarInactivos_Checked"/>
                    <TextBlock Style="{StaticResource FieldHintTextStyle}"
                               Text="Los deshabilitados no aparecen en el catálogo del POS, pero se conservan para historial y pueden reactivarse."
                               Margin="0,2,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button x:Name="btnNuevo" Content="➕ Nuevo Producto" Style="{StaticResource ButtonStyle}" Padding="15,10" Margin="0,0,10,0" Click="btnNuevo_Click"/>
                    <Button x:Name="btnExportarProductos" Content="📤 Exportar Productos" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" Margin="0,0,6,0" Click="btnExportarProductos_Click" ToolTip="Exporta todos los productos para actualización masiva de costos y estados"/>
                    <Button x:Name="btnImportarActualizacion" Content="📥 Importar Actualización" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" Margin="0,0,10,0" Click="btnImportarActualizacion_Click" ToolTip="Importa cambios de costo, IVA, impuestos y estados operativos"/>
                    <Button x:Name="btnDescargarPlantilla" Content="📥 Plantilla CSV" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" Margin="0,0,6,0" Click="btnDescargarPlantilla_Click" ToolTip="Plantilla para alta masiva de productos nuevos"/>
                    <Button x:Name="btnDescargarPlantillaXlsx" Content="📊 Plantilla Excel" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" Margin="0,0,6,0" Click="btnDescargarPlantillaXlsx_Click" ToolTip="Plantilla para alta masiva de productos nuevos"/>
                    <Button x:Name="btnImportarExcel" Content="📂 Importar Alta Masiva" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8" Click="btnImportarExcel_Click" ToolTip="Alta masiva de productos nuevos (CSV / Excel)"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" CornerRadius="8" Padding="1">
            <Grid>
                <DataGrid x:Name="dgvProductos" Style="{StaticResource ModuleDataGridStyle}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="dgvProductos_SelectionChanged"
                          MouseDoubleClick="dgvProductos_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✏️ Editar" Click="MenuItemEditar_Click"/>
                        <MenuItem Header="📋 Duplicar" Click="MenuItemDuplicar_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="COD" Binding="{Binding Codigo}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="RUBRO" Binding="{Binding Categoria}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="SUB-RUBRO" Binding="{Binding SubRubro}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="MARCA" Binding="{Binding Marca}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding Proveedor}" Width="Auto" MinWidth="100"/>
                    <DataGridCheckBoxColumn Header="ACTIVO" Binding="{Binding Activo}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="COSTO COMPRA FINAL" Binding="{Binding CostoCompraFinal, StringFormat=C2}" Width="Auto" MinWidth="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StockNumericCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding CostoCompraFinal}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ÚLT. MODIFICACIÓN" Binding="{Binding FechaModificacion, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto" MinWidth="140"/>
                </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="pnlCargandoProductos" Visibility="Collapsed"
                        Background="#CC1E1E1E" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="7" IsIndeterminate="True"/>
                        <TextBlock Text="Cargando productos…" Margin="0,12,0,0"
                                   Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
