<Window x:Class="SchettiniGestion.WPF.ProveedorModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedor" Width="560" SizeToContent="Height" MinHeight="0"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblTitulo" Text="Nuevo Proveedor" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CUIT / CUIL" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtCuit" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Razón Social *" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtRazonSocial" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Domicilio" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtDireccion" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Categoría Fiscal" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <ComboBox x:Name="cmbCategoriaFiscal" Style="{StaticResource ModuleComboBoxStyle}">
                        <ComboBoxItem Content=""/>
                        <ComboBoxItem Content="RI"/>
                        <ComboBoxItem Content="Mono"/>
                        <ComboBoxItem Content="Exento"/>
                        <ComboBoxItem Content="Cons final"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Persona de Contacto (Vendedor)" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtPersonaContacto" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Teléfono" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtTelefono" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Página Web" Style="{StaticResource ModalCaptionTextStyle}"/>
                    <TextBox x:Name="txtPaginaWeb" Style="{StaticResource ModuleTextBoxStyle}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Email" Style="{StaticResource ModalCaptionTextStyle}"/>
            <TextBox x:Name="txtEmail" Style="{StaticResource ModuleTextBoxStyle}" Margin="0,0,0,4"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                Padding="14,12" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnEliminar" Content="Eliminar" Style="{StaticResource DeleteButtonStyle}"
                        MinHeight="44" Padding="16,8" Margin="0,0,10,0" Visibility="Collapsed" Click="btnEliminar_Click"/>
                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="44" Padding="16,8" Margin="0,0,10,0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Content="✔ Guardar" Style="{StaticResource ButtonStyle}"
                        MinHeight="44" Padding="18,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
