<Window x:Class="SchettiniGestion.WPF.QrCajaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR de la caja Mercado Pago" Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ModuleBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="QR estático de la caja" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource HeaderForegroundBrush}"/>
            <TextBlock x:Name="lblAyuda" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Imprimí este código y dejalo fijo en el mostrador. Al cobrar con Mercado Pago, el cliente lo escanea y ve el monto de su compra."/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
            <Image x:Name="imgQr" Stretch="Uniform"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Guardar imagen" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btnGuardar_Click"/>
            <Button Content="Imprimir" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="btnImprimir_Click"/>
            <Button Content="Cerrar" Style="{StaticResource SuccessButtonStyle}" Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
