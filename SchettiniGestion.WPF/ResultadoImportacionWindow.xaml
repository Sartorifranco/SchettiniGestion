<Window x:Class="SchettiniGestion.WPF.ResultadoImportacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado de importación"
        Width="480"
        MinHeight="280"
        MaxHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblTitulo"
                       Text="Resultado de importación"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,16"/>

            <StackPanel x:Name="pnlResumenExitoso" Grid.Row="1" Margin="0,0,0,8">
                <Grid x:Name="pnlFilaCreados" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✔ Nuevos productos creados"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="lblCreados"
                               Grid.Column="1"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessColor}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔄 Productos actualizados"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="lblActualizados"
                               Grid.Column="1"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"/>
                </Grid>

                <Grid x:Name="pnlSinCambios" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⏭ Filas sin cambios"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="lblSinCambios"
                               Grid.Column="1"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Grid>

                <Grid x:Name="pnlErrores" Margin="0,0,0,4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠ Errores / omitidos"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="lblErrores"
                               Grid.Column="1"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningColor}"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="pnlErrorFatal" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="❌ La importación no se aplicó"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DangerColor}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="txtErrorFatal"
                           Text=""
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border x:Name="pnlDetalleErrores"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,8,0,12"
                    MaxHeight="160">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtDetalleErrores"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <Button x:Name="btnAceptar"
                    Grid.Row="3"
                    Content="Aceptar"
                    HorizontalAlignment="Center"
                    MinWidth="160"
                    MinHeight="48"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Style="{StaticResource ButtonStyle}"
                    Click="btnAceptar_Click"/>
        </Grid>
    </Border>
</Window>
