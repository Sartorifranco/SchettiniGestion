<UserControl x:Class="SchettiniGestion.WPF.StockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundDark}"
             Loaded="StockControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Stock" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

        <TabControl x:Name="tabMain" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bdr" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,10,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📋 Consulta stock">
                <TabControl Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                    <TabItem Header="Stock General">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Filtro (código, producto, talle, color, código externo, marca, rubro, subrubro, proveedor)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="txtFiltroGeneral" Style="{StaticResource ModernTextBox}" TextChanged="txtFiltroGeneral_TextChanged" Margin="0,0,0,5"/>
                                    <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Padding="12,6" Click="btnBuscarGeneral_Click"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="dgvStockGeneral" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                Style="{StaticResource {x:Type DataGrid}}" HeadersVisibility="Column"
                                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="80"/>
                                    <DataGridTextColumn Header="SubRubro" Binding="{Binding SubRubro}" Width="80"/>
                                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="70"/>
                                    <DataGridTextColumn Header="Talle" Binding="{Binding Talle}" Width="60"/>
                                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="60"/>
                                    <DataGridTextColumn Header="Stock Real" Binding="{Binding StockReal}" Width="80"/>
                                    <DataGridTextColumn Header="Reservado" Binding="{Binding StockReservado}" Width="80"/>
                                    <DataGridTextColumn Header="Disponible" Binding="{Binding StockDisponible}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Movimientos">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fecha desde" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpMovDesde" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Fecha hasta" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpMovHasta" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Filtro (código, producto, talle, color, etc.)" Style="{StaticResource LabelStyle}" Margin="0,10,0,0"/>
                                    <TextBox x:Name="txtFiltroMov" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Tipo de movimiento" Style="{StaticResource LabelStyle}"/>
                                    <WrapPanel Margin="0,5,0,10">
                                        <CheckBox x:Name="chkMovCompra" Content="Compra" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovRecepcion" Content="Recepcion Compra" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovNotaCredito" Content="Nota Crédito" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovNotaDebito" Content="Nota Débito" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovAjuste" Content="Ajuste Stock" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovIngreso" Content="Ingreso" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovEgreso" Content="Egreso" Foreground="{DynamicResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="chkMovVenta" Content="Venta" Foreground="{DynamicResource TextSecondary}"/>
                                    </WrapPanel>
                                    <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Padding="12,6" Click="btnBuscarMovimientos_Click"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="dgvMovimientos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                Style="{StaticResource {x:Type DataGrid}}" HeadersVisibility="Column"
                                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="120"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Stock Reservado">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fecha desde" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpResDesde" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Fecha hasta" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpResHasta" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Canal reserva" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtResCanal" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ID Orden" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtResOrden" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="ID Publicación" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtResPublicacion" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Estado" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="cmbResEstado" Style="{StaticResource ModuleComboBoxStyle}" IsEditable="True">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="Activa"/>
                                                <ComboBoxItem Content="Anulada"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cód/Producto/Talle/Color" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtResFiltro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" Padding="12,6" Click="btnBuscarReservas_Click"/>
                                        <Button Content="➕ Nueva reserva" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="10,0,0,0" Click="btnNuevaReserva_Click"/>
                                        <Button x:Name="btnAnularReserva" Content="❌ Anular reserva" Style="{StaticResource DeleteButtonStyle}" Padding="12,6" Margin="10,0,0,0" Click="btnAnularReserva_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="dgvReservas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                Style="{StaticResource {x:Type DataGrid}}" HeadersVisibility="Column"
                                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaReserva, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                                    <DataGridTextColumn Header="Canal" Binding="{Binding CanalReserva}" Width="90"/>
                                    <DataGridTextColumn Header="Orden" Binding="{Binding OrdenID}" Width="80"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="70"/>
                                    <DataGridTextColumn Header="Talle" Binding="{Binding Talle}" Width="60"/>
                                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ajuste Stock">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fecha desde" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpAjusteDesde" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Fecha hasta" Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="dpAjusteHasta" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Cód/Producto" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtAjusteFiltro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Personal" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="txtAjustePersonal" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" Padding="12,6" Click="btnBuscarAjustes_Click"/>
                                            <Button x:Name="btnNuevoAjuste" Content="➕ Nuevo ajuste" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="10,0,0,0" Click="btnNuevoAjuste_Click"/>
                                            <Button x:Name="btnAnularAjuste" Content="❌ Anular ajuste" Style="{StaticResource DeleteButtonStyle}" Padding="12,6" Margin="10,0,0,0" Click="btnAnularAjuste_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource BackgroundDark}" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ingresos" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="lblAjusteIngresos" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Egresos" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="lblAjusteEgresos" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerColor}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Valorización sin IVA" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="lblAjusteValorSinIva" Text="$ 0" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Valorización con IVA" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="lblAjusteValorConIva" Text="$ 0" FontSize="16" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="dgvAjustes" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                Style="{StaticResource {x:Type DataGrid}}" HeadersVisibility="Column"
                                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="140"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                    <DataGridTextColumn Header="Personal" Binding="{Binding Usuario}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Depósitos">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Filtro (código, producto, rubro, subrubro, proveedor, talle, color)" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="txtFiltroDep" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Tipo stock" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="cmbTipoStockDep" Style="{StaticResource ModuleComboBoxStyle}" SelectedIndex="0" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Todos"/>
                                        <ComboBoxItem Content="Sin stock"/>
                                        <ComboBoxItem Content="Stock distinto a cero"/>
                                        <ComboBoxItem Content="Bajo stock"/>
                                    </ComboBox>
                                    <Button Content="🔍 Buscar" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left" Padding="12,6" Click="btnBuscarDepositos_Click"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="dgvDepositos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                Style="{StaticResource {x:Type DataGrid}}" HeadersVisibility="Column"
                                CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                                    <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="80"/>
                                    <DataGridTextColumn Header="SubRubro" Binding="{Binding SubRubro}" Width="80"/>
                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="100"/>
                                    <DataGridTextColumn Header="Talle" Binding="{Binding Talle}" Width="60"/>
                                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="60"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="tabRegistrar" Header="✏️ Registrar movimiento">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="20" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PRODUCTO (Cód/Nombre)" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtBuscarProducto" Style="{StaticResource ModernTextBox}" TextChanged="txtBuscarProducto_TextChanged" PreviewKeyDown="txtBuscar_PreviewKeyDown" LostFocus="txtBuscar_LostFocus"/>
                                <Popup x:Name="popupProducto" PlacementTarget="{Binding ElementName=txtBuscarProducto}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{DynamicResource SurfaceDark}" BorderBrush="{StaticResource PrimaryColor}" BorderThickness="1" CornerRadius="4" MaxHeight="200" MinWidth="300">
                                        <ListBox x:Name="lstSugerenciasProducto" ItemsSource="{Binding}" DisplayMemberPath="Descripcion" MouseUp="lstSugerenciasProducto_MouseUp" PreviewKeyDown="lstSugerencias_PreviewKeyDown" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                                    </Border>
                                </Popup>
                                <TextBlock x:Name="lblProductoSeleccionado" Text="-" Foreground="{StaticResource SuccessColor}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CANTIDAD (+/-)" Style="{StaticResource LabelStyle}"/>
                                <xctk:IntegerUpDown x:Name="numCantidad" Style="{StaticResource ModuleIntegerUpDownStyle}" FormatString="N0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="MOTIVO" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbTipoMovimiento" Style="{StaticResource ModuleComboBoxStyle}"/>
                            </StackPanel>
                            <Button x:Name="btnGuardarAjuste" Grid.Column="6" Content="💾 GUARDAR" Style="{StaticResource ButtonStyle}" VerticalAlignment="Bottom" Height="40" Padding="20,0" Click="btnGuardarAjuste_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
