<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Forma del diseño actual (vigente). Solo tokens visuales. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="NavItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="LoginCardCornerRadius">15</CornerRadius>
    <CornerRadius x:Key="LoginAsideCornerRadius">15,0,0,15</CornerRadius>
    <CornerRadius x:Key="VKKeyCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="TabItemCornerRadius">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="ComboPopupCornerRadius">8</CornerRadius>

    <Thickness x:Key="ButtonPadding">15,10</Thickness>
    <Thickness x:Key="FieldPadding">12,0</Thickness>
    <Thickness x:Key="FieldFocusBorderThickness">1</Thickness>
    <Thickness x:Key="LoginFormPadding">40</Thickness>
    <Thickness x:Key="NavItemPadding">16,12</Thickness>

    <sys:Double x:Key="ButtonMinHeight">44</sys:Double>
    <sys:Double x:Key="FieldMinHeight">44</sys:Double>
    <sys:Double x:Key="HeadlineFontSize">28</sys:Double>
    <sys:Double x:Key="TitleFontSize">18</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="LabelFontSize">12</sys:Double>
    <sys:Double x:Key="VKKeyFontSize">18</sys:Double>

    <FontFamily x:Key="BodyFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadlineFontFamily">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

    <Thickness x:Key="VKKeyFaceMargin">0,0,0,4</Thickness>
    <Visibility x:Key="VKKeyShadowVisibility">Visible</Visibility>
    <sys:Double x:Key="VKKeyFaceBottomMargin">4</sys:Double>
    <SolidColorBrush x:Key="VKHideButtonBg" Color="#C62828"/>
    <SolidColorBrush x:Key="VKHideButtonHover" Color="#E53935"/>
    <SolidColorBrush x:Key="FieldFocusGlow" Color="#00000000"/>

    <sys:Double x:Key="LoginWindowWidth">800</sys:Double>
    <sys:Double x:Key="LoginWindowHeight">500</sys:Double>
</ResourceDictionary>
