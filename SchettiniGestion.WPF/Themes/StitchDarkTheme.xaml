    <SolidColorBrush x:Key="LoginFormBackgroundBrush" Color="#171F33"/>
    <SolidColorBrush x:Key="LoginAsideBackgroundBrush" Color="#0B1326"/>
    <SolidColorBrush x:Key="LoginFieldBackgroundBrush" Color="#131B2E"/>
    <SolidColorBrush x:Key="LoginFieldBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="LoginMutedTextBrush" Color="#C5C6CD"/>
    <SolidColorBrush x:Key="LoginBrandTextBrush" Color="#B4C5FF"/>
    <SolidColorBrush x:Key="LoginFooterTextBrush" Color="#8F9097"/>
