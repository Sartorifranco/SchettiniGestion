    <SolidColorBrush x:Key="VKKeyBorder"     Color="#3C494E"/>
    <SolidColorBrush x:Key="VKKeyPressBg"    Color="#00D1FF"/>
    <SolidColorBrush x:Key="VKShiftActiveBg" Color="#00D1FF"/>
    <SolidColorBrush x:Key="VKAccentBar"     Color="#00D1FF"/>
</ResourceDictionary>
