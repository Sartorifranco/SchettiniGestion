    <SolidColorBrush x:Key="VKKeySpecialBg"  Color="#D5E3FC"/>
    <SolidColorBrush x:Key="VKKeyShadow"     Color="#C3C6D7"/>
    <SolidColorBrush x:Key="VKKeyBorder"     Color="#C3C6D7"/>
    <SolidColorBrush x:Key="VKKeyPressBg"    Color="#2563EB"/>
    <SolidColorBrush x:Key="VKShiftActiveBg" Color="#004AC6"/>
    <SolidColorBrush x:Key="VKAccentBar"     Color="#2563EB"/>
</ResourceDictionary>
