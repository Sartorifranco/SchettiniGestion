<UserControl x:Class="SchettiniGestion.WPF.TouchDateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="260"
             MinWidth="220">

    <StackPanel>
        <Border x:Name="bordeFecha"
                MinHeight="52"
                Padding="12,8"
                Background="White"
                BorderBrush="#B0BEC5"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Hand"
                MouseLeftButtonDown="bordeFecha_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="📅"
                           FontSize="22"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtFecha"
                               Text="--/--/----"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A1A1A"/>
                    <TextBlock Text="Tocar para elegir fecha"
                               FontSize="11"
                               Foreground="#616161"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="txtChevron"
                           Grid.Column="2"
                           Text="▼"
                           FontSize="14"
                           Foreground="#1E88E5"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="panelCalendario"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#B0BEC5"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,10,0,0"
                Padding="10">
            <Calendar x:Name="calInterno"
                      SelectedDatesChanged="calInterno_SelectedDatesChanged"
                      Style="{StaticResource TouchCalendarStyle}"
                      MinWidth="400"
                      MinHeight="380"
                      HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
</UserControl>
