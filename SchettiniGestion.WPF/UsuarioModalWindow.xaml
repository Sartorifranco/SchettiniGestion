<Window x:Class="SchettiniGestion.WPF.UsuarioModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ModuleBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo" Text="Nuevo usuario"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="NOMBRE DE USUARIO (LOGIN)" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="txtNombreUsuario" Style="{StaticResource ModernTextBox}"
                     Height="48" FontSize="16" Margin="0,0,0,14"/>

            <TextBlock Text="NOMBRE DEL PERSONAL" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
            <TextBox x:Name="txtNombrePersonal" Style="{StaticResource ModernTextBox}"
                     Height="48" FontSize="16" Margin="0,0,0,6"/>
            <TextBlock Text="Nombre real del vendedor o cajero. Se usa en reportes."
                       Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="txtPassword" Style="{StaticResource PasswordBoxStyle}"
                         Height="48" FontSize="16" Margin="0,0,0,6"/>
            <TextBlock x:Name="txtHintPassword"
                       Text="Obligatoria para un usuario nuevo."
                       Style="{StaticResource FieldHintTextStyle}" Margin="0,0,0,14"/>

            <TextBlock Text="ROL" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbRoles" Style="{StaticResource ModuleComboBoxStyle}"
                      Height="48" FontSize="16"
                      DisplayMemberPath="Nombre" SelectedValuePath="RolId"
                      Margin="0,0,0,8"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                    Height="48" FontSize="15" IsCancel="True" Click="btnCancelar_Click"/>
            <Button Grid.Column="2" Content="Guardar" Style="{StaticResource ButtonStyle}"
                    Height="48" FontSize="15" IsDefault="True" Click="btnGuardar_Click"/>
        </Grid>
    </Grid>
</Window>
