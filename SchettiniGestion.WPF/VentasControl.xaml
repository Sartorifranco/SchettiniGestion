<UserControl x:Class="SchettiniGestion.WPF.VentasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource BackgroundDark}"
             Loaded="VentasControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Historial de Ventas" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,15">
            <Button x:Name="btnHoy" Content="📅 HOY" Click="btnFiltroRapido_Click" Tag="Hoy" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="45"/>
            <Button x:Name="btnAyer" Content="⬅ AYER" Click="btnFiltroRapido_Click" Tag="Ayer" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="45"/>
            <Button x:Name="btnSemana" Content="📅 7 DÍAS" Click="btnFiltroRapido_Click" Tag="Semana" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="45"/>
            <Button x:Name="btnMes" Content="📅 ESTE MES" Click="btnFiltroRapido_Click" Tag="Mes" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="45"/>
            <Button x:Name="btnTodos" Content="♾️ TODO" Click="btnFiltroRapido_Click" Tag="Todo" Style="{StaticResource SecondaryButtonStyle}" Height="45"/>
        </UniformGrid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DESDE" Style="{DynamicResource LabelStyle}"/>
                    <DatePicker x:Name="dtpDesde" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="HASTA" Style="{DynamicResource LabelStyle}"/>
                    <DatePicker x:Name="dtpHasta" Height="35" Width="140" FontSize="14" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceDark}" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <Button x:Name="btnBuscar" Grid.Column="4" Content="🔍 BUSCAR" Style="{StaticResource ButtonStyle}" Width="120" VerticalAlignment="Bottom" Height="35" Click="btnBuscar_Click"/>

                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="TOTAL PERÍODO" Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblTotalPeriodo" Text="$ 0,00" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceDark}" CornerRadius="8" Padding="1">
            <DataGrid x:Name="dgvVentas" Style="{StaticResource {x:Type DataGrid}}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NRO" Binding="{Binding FacturaID, StringFormat=D8}" Width="100"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="160"/>
                    <DataGridTextColumn Header="CLIENTE" Binding="{Binding RazonSocial}" Width="*"/>
                    <DataGridTextColumn Header="TIPO" Binding="{Binding TipoComprobante}" Width="120"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C2}" Width="120" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>

                    <DataGridTemplateColumn Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="👁️ Ver" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Height="28" Width="60" Click="btnVerDetalle_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>