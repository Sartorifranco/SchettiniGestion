<Window x:Class="SchettiniGestion.WPF.VirtualKeyboardShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchettiniGestion.WPF"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False">
    <!-- Shell transparente: el negro lo pinta solo VirtualKeyboardControl (sin franja basura). -->
    <local:VirtualKeyboardControl x:Name="keyboard"/>
</Window>
