<Window x:Class="SchettiniGestion.WPF.VirtualKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>

        <!-- ═══════════════════════════════════════════════
             KEYCAP BASE — efecto 3D (cara + sombra física)
             ═══════════════════════════════════════════════ -->
        <ControlTemplate x:Key="KeycapTemplate" TargetType="Button">
            <Grid>
                <!-- Sombra / base física de la tecla -->
                <Border x:Name="shadow"
                        CornerRadius="9"
                        Background="{DynamicResource VKKeyShadow}"
                        Margin="1,4,1,0"/>
                <!-- Cara de la tecla -->
                <Border x:Name="face"
                        CornerRadius="9"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource VKKeyBorder}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,4">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <!-- Presionado: cara baja, sombra desaparece -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="face"   Property="Margin"     Value="0,4,0,0"/>
                    <Setter TargetName="face"   Property="Background" Value="{DynamicResource VKKeyPressBg}"/>
                    <Setter TargetName="face"   Property="BorderThickness" Value="0"/>
                    <Setter TargetName="shadow" Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── Tecla normal ── -->
        <Style x:Key="VKKey" TargetType="Button">
            <Setter Property="Background"     Value="{DynamicResource VKKeyBg}"/>
            <Setter Property="Foreground"     Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="FontSize"       Value="18"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Height"         Value="58"/>
            <Setter Property="Margin"         Value="3,0,3,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable"      Value="False"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template"       Value="{StaticResource KeycapTemplate}"/>
        </Style>

        <!-- ── Tecla especial (Shift, ?#, ABC) ── -->
        <Style x:Key="VKKeySpecial" TargetType="Button" BasedOn="{StaticResource VKKey}">
            <Setter Property="Background" Value="{DynamicResource VKKeySpecialBg}"/>
            <Setter Property="FontSize"   Value="15"/>
        </Style>

        <!-- ── Tecla Enter ── -->
        <Style x:Key="VKKeyEnter" TargetType="Button" BasedOn="{StaticResource VKKey}">
            <Setter Property="Background" Value="{DynamicResource VKKeySpecialBg}"/>
            <Setter Property="FontSize"   Value="20"/>
        </Style>

        <!-- ── Tecla ⌫ (Backspace) ── -->
        <Style x:Key="VKKeyBack" TargetType="Button" BasedOn="{StaticResource VKKey}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="Foreground" Value="#FFEBEE"/>
            <Setter Property="FontSize"   Value="22"/>
        </Style>

        <!-- ── Tecla ✓ (Confirmar/Cerrar) ── -->
        <Style x:Key="VKKeyConfirm" TargetType="Button" BasedOn="{StaticResource VKKey}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="#E8F5E9"/>
            <Setter Property="FontSize"   Value="22"/>
        </Style>

        <!-- ── Barra espaciadora ── -->
        <Style x:Key="VKKeySpace" TargetType="Button" BasedOn="{StaticResource VKKey}">
            <Setter Property="Background" Value="{DynamicResource VKKeyBg}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

    </Window.Resources>

    <!-- ══════════════ PANEL PRINCIPAL ══════════════ -->
    <Border x:Name="mainBorder"
            CornerRadius="20,20,0,0"
            Background="{DynamicResource VKBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                              Direction="90" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Barra superior: indicador de modo | handle | botón ocultar -->
            <Grid Margin="12,8,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Indicador de modo (se actualiza desde código) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource VKKeySpecialBg}"
                            CornerRadius="6"
                            Padding="8,4">
                        <TextBlock x:Name="lblModo"
                                   Text="ABC"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Handle central -->
                <Border Grid.Column="1"
                        Width="44" Height="4" CornerRadius="2"
                        Background="{DynamicResource VKKeyBorder}"
                        VerticalAlignment="Center"/>

                <!-- Botón OCULTAR — prominente, alineado a la derecha -->
                <Button x:Name="btnCerrar"
                        Grid.Column="2"
                        Click="btnCerrar_Click"
                        HorizontalAlignment="Right"
                        Height="36"
                        Padding="12,0"
                        Focusable="False"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b"
                                    CornerRadius="8"
                                    Background="#C62828"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▼" FontSize="11" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ocultar" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#B71C1C"/>
                                    <Setter TargetName="b" Property="Opacity"    Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E53935"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Barra de acento (fina línea de color en la parte superior) -->
            <Border Height="2"
                    Background="{DynamicResource VKAccentBar}"
                    Margin="0,0,0,10"
                    Opacity="0.6"/>

            <!-- ══════════ TECLADO ALFA ══════════ -->
            <StackPanel x:Name="pnlAlpha" Margin="8,0,8,6"/>

            <!-- ══════════ TECLADO NUMÉRICO ══════════ -->
            <!-- Centrado, ancho fijo para el numpad -->
            <StackPanel x:Name="pnlNumeric"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        MinWidth="320"
                        MaxWidth="480"
                        Margin="0,0,0,6"/>

        </StackPanel>
    </Border>
</Window>
