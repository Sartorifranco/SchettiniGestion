<Window x:Class="SchettiniGestion.WPF.VisorClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Visor Cliente" Height="768" Width="1024"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="{StaticResource ModuleBackgroundBrush}">

    <Viewbox Stretch="Uniform">
        <Grid Height="768" Width="1024">

            <Grid x:Name="GridLogo" Visibility="Visible" Background="{StaticResource ModuleBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="imgLogo" Source="logo.png" Height="200" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,30"/>
                    <TextBlock x:Name="txtNombreNegocio" Text="Bienvenido" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridVenta" Visibility="Collapsed" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2D2D30" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                    <TextBlock Text="🛒 SU COMPRA" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <DataGrid x:Name="dgvDetalleCliente" Grid.Row="1" Margin="0,0,0,20"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" RowBackground="Transparent" Foreground="White"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444" BorderThickness="0"
                          RowHeight="60" FontSize="24" HeadersVisibility="Column">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#AAA"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="100"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat=C2}" Width="150"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="180" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#007ACC" CornerRadius="15" Padding="30,20">
                    <Grid>
                        <TextBlock Text="TOTAL A PAGAR:" Foreground="White" FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="lblTotal" Text="$ 0,00" Foreground="White" FontSize="65" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GridPago" Visibility="Collapsed" Background="{StaticResource ModuleBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="¿CÓMO DESEA PAGAR?" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>

                    <UniformGrid Columns="2" Rows="2" Width="800" Height="400">
                        <Button Click="BtnPago_Click" Tag="EFECTIVO" Margin="15" Background="#2D2D30" BorderBrush="#444" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel>
                                <TextBlock Text="💵" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="EFECTIVO" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnPago_Click" Tag="TARJETA" Margin="15" Background="#2D2D30" BorderBrush="#444" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel>
                                <TextBlock Text="💳" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="TARJETA" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnPago_Click" Tag="MERCADOPAGO" Margin="15" Background="#009EE3" BorderBrush="Transparent">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel>
                                <TextBlock Text="📱" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="MERCADO PAGO" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnPago_Click" Tag="CTACTE" Margin="15" Background="#2D2D30" BorderBrush="#444" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="15"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel>
                                <TextBlock Text="📝" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="CUENTA CTE." Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridQR" Visibility="Collapsed" Background="#009EE3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="1" Source="/logo_mercadopago.png" Height="90" HorizontalAlignment="Center" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Grid.Row="2" Text="Escaneá el QR para pagar" Foreground="White" FontSize="45" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" TextWrapping="Wrap" TextAlignment="Center"/>

                <Border Grid.Row="3" Background="White" Padding="20" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Height="380">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.3"/>
                    </Border.Effect>
                    <Image x:Name="imgQR" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,10">
                    <TextBlock Text="Total:" Foreground="White" FontSize="36" VerticalAlignment="Center" Margin="0,0,15,0" Opacity="0.9"/>
                    <TextBlock x:Name="lblTotalQR" Text="$ 0,00" Foreground="White" FontSize="60" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="lblEstadoQR" Grid.Row="5" Text="Esperando lectura..." Foreground="White" FontSize="28" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.9"/>
            </Grid>

            <Grid x:Name="GridGracias" Visibility="Collapsed" Background="#00A86B">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="140" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <TextBlock Text="¡PAGO APROBADO!" Foreground="White" FontSize="70" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Muchas gracias por su compra." Foreground="White" FontSize="35" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.9"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Viewbox>
</Window>