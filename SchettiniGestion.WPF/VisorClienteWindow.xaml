<Window x:Class="SchettiniGestion.WPF.VisorClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Visor Cliente" Height="768" Width="1024"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" WindowState="Normal"
        Background="{DynamicResource ModuleBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="rowPromoInferior" Height="0"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colPromoLateral" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Imagen promocional vertical (lado izquierdo, ideal 1080×1920 o 1080×1080) -->
            <Border x:Name="panelPromoLateral" Grid.Column="0" Visibility="Collapsed"
                    Background="#0A0A0A" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <Border ClipToBounds="True" Background="#0A0A0A">
                    <Grid>
                        <Image x:Name="imgPromo" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <MediaElement x:Name="mediaPromo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
                                      Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                      MediaEnded="MediaPromo_MediaEnded" MediaFailed="MediaPromo_MediaFailed"/>
                        <!-- Controles ocultos: el logo se eliminó del visor para maximizar el área promocional -->
                        <Image x:Name="imgLogo" Height="1" Width="1" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtMarcaPromo" Visibility="Collapsed"/>
                        <Border x:Name="borderMarcaPromo" Visibility="Collapsed" Height="0"/>
                    </Grid>
                </Border>
            </Border>

            <!-- Detalle de venta (derecha) -->
            <Grid x:Name="GridContenido" Grid.Column="1" Background="{DynamicResource ModuleBackgroundBrush}">

            <Grid x:Name="GridBienvenida" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="32">
                    <Image x:Name="imgLogoBienvenida" Height="160" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,24"/>
                    <TextBlock x:Name="txtNombreNegocio" Text="Bienvenido" Foreground="{DynamicResource TextPrimary}"
                               FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Su compra se mostrará aquí" Foreground="{DynamicResource TextSecondary}"
                               FontSize="22" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridVenta" Visibility="Collapsed" Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceDark}" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Text="🛒 SU COMPRA" Foreground="{DynamicResource TextPrimary}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <DataGrid x:Name="dgvDetalleCliente" Grid.Row="1" Margin="0,0,0,16"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" RowBackground="Transparent" Foreground="{DynamicResource TextPrimary}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}" BorderThickness="0"
                          RowHeight="52" FontSize="20" HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="80"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat=C2}" Width="130"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="150" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="{StaticResource PrimaryColor}" CornerRadius="12" Padding="24,16">
                    <Grid>
                        <TextBlock Text="TOTAL A PAGAR:" Foreground="White" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="lblTotal" Text="$ 0,00" Foreground="White" FontSize="52" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GridPago" Visibility="Collapsed" Background="{DynamicResource ModuleBackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900" Margin="24">
                    <TextBlock Text="¿CÓMO DESEA PAGAR?" Foreground="{DynamicResource TextPrimary}" FontSize="40" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,36" TextWrapping="Wrap" TextAlignment="Center"/>
                    <UniformGrid Columns="2" Rows="2" MinWidth="520" MinHeight="320">
                        <Button Click="BtnPago_Click" Tag="EFECTIVO" Margin="10" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel>
                                <TextBlock Text="💵" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="EFECTIVO" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnPago_Click" Tag="TARJETA" Margin="10" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel>
                                <TextBlock Text="VISA  ●●  AMEX  NARANJA X" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="💳" FontSize="42" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <TextBlock Text="TARJETA" Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnPago_Click" Tag="MERCADOPAGO" Margin="10" Background="#009EE3" BorderBrush="Transparent">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel>
                                <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="MERCADO PAGO" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnPago_Click" Tag="CTACTE" Margin="10" Background="{DynamicResource SurfaceDark}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                            <StackPanel>
                                <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="CUENTA CTE." Foreground="{DynamicResource TextPrimary}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridQR" Visibility="Collapsed" Background="#009EE3">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Border Background="White" CornerRadius="16" Padding="22,10" Margin="0,0,0,18">
                        <Image Source="/SCHPOS;component/Resources/mercadopago-logo.png"
                               Width="230" Height="86" Stretch="Uniform"
                               HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Escaneá el QR para pagar" Foreground="White" FontSize="36" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Border Background="White" Padding="16" CornerRadius="16" HorizontalAlignment="Center" Width="300" Height="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
                        </Border.Effect>
                        <Image x:Name="imgQR" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,8">
                        <TextBlock Text="Total:" Foreground="White" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.9"/>
                        <TextBlock x:Name="lblTotalQR" Text="$ 0,00" Foreground="White" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblEstadoQR" Text="Esperando lectura..." Foreground="White" FontSize="22"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.9"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridPoint" Visibility="Collapsed" Background="#F5F5F5">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" MaxWidth="820">
                    <Border Background="White" CornerRadius="16" Padding="22,10" Margin="0,0,0,26">
                        <Image Source="/SCHPOS;component/Resources/mercadopago-logo.png"
                               Width="240" Height="88" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Complete el pago en el Point" Foreground="#222222"
                               FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblTotalPoint" Text="$ 0,00" Foreground="#009EE3"
                               FontSize="58" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                    <TextBlock x:Name="lblEstadoPoint" Text="Enviando el importe a la terminal..."
                               Foreground="#555555" FontSize="23" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="18,11" Margin="5">
                            <TextBlock Text="VISA" Foreground="#1434CB" FontSize="24" FontWeight="ExtraBold" FontStyle="Italic"/>
                        </Border>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="42" Height="24">
                                    <Ellipse Width="24" Height="24" Fill="#EB001B" HorizontalAlignment="Left"/>
                                    <Ellipse Width="24" Height="24" Fill="#F79E1B" HorizontalAlignment="Right" Opacity="0.92"/>
                                </Grid>
                                <TextBlock Text="mastercard" Foreground="#222222" FontSize="17" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#006FCF" CornerRadius="10" Padding="15,11" Margin="5">
                            <TextBlock Text="AMERICAN EXPRESS" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tarjetas admitidas según la habilitación de la cuenta y la terminal"
                               Foreground="#777777" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridGracias" Visibility="Collapsed" Background="#00A650" Opacity="0">
                <Grid.Resources>
                    <Storyboard x:Key="AnimacionPagoAprobado">
                        <DoubleAnimation Storyboard.TargetName="GridGracias" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.22"/>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="circuloAprobado"
                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1.12">
                                <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="circuloAprobado"
                                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1.12">
                                <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="tildeAprobado" Storyboard.TargetProperty="Opacity"
                                         BeginTime="0:0:0.28" From="0" To="1" Duration="0:0:0.22"/>
                        <DoubleAnimation Storyboard.TargetName="textoAprobado" Storyboard.TargetProperty="Opacity"
                                         BeginTime="0:0:0.48" From="0" To="1" Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetName="textoAprobado"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         BeginTime="0:0:0.48" From="24" To="0" Duration="0:0:0.35">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="aroAprobado" Storyboard.TargetProperty="Opacity"
                                         BeginTime="0:0:0.2" From="0.7" To="0" Duration="0:0:0.75"/>
                        <DoubleAnimation Storyboard.TargetName="aroAprobado"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         BeginTime="0:0:0.2" From="0.8" To="1.65" Duration="0:0:0.75"/>
                        <DoubleAnimation Storyboard.TargetName="aroAprobado"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         BeginTime="0:0:0.2" From="0.8" To="1.65" Duration="0:0:0.75"/>
                    </Storyboard>
                </Grid.Resources>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Grid Width="210" Height="210" Margin="0,0,0,34">
                        <Ellipse x:Name="aroAprobado" Stroke="White" StrokeThickness="7" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border x:Name="circuloAprobado" Background="White" CornerRadius="105"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="0.2"/></Border.RenderTransform>
                            <Path x:Name="tildeAprobado" Data="M 48,104 L 86,142 L 164,64"
                                  Stroke="#00A650" StrokeThickness="18" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="textoAprobado" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform><TranslateTransform Y="24"/></StackPanel.RenderTransform>
                        <TextBlock Text="¡PAGO APROBADO!" Foreground="White" FontSize="58" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock Text="El cobro se acreditó correctamente" Foreground="White" FontSize="28"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" Opacity="0.92"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>

        <!-- Carrusel inferior de banners horizontales (imágenes landscape) -->
        <Border x:Name="panelPromoInferior" Grid.Row="1" Visibility="Collapsed" Background="#0A0A0A"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Grid ClipToBounds="True">
                <Image x:Name="imgPromoHorizontal" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
                <MediaElement x:Name="mediaPromoHorizontal" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
                              Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                              MediaEnded="MediaPromoHorizontal_MediaEnded" MediaFailed="MediaPromoHorizontal_MediaFailed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
