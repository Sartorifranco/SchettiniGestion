<Window x:Class="SchettiniGestion.WPF.VisorClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor Cliente" Height="600" Width="800"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1E1E1E">

    <Viewbox Stretch="Uniform">
        <Grid Height="600" Width="800">

            <Grid x:Name="GridVenta" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Border Background="#2D2D30" Margin="10,10,10,0" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛒 SU COMPRA" Foreground="White" FontWeight="Bold" FontSize="30" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="dgvDetalleCliente" Grid.Row="1" Margin="10" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="#333337" RowBackground="#333337" 
                          Foreground="White" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#555"
                          HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2D2D30"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PRODUCTO" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ImagenPath}" Height="50" Width="50" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" FontSize="18"/>
                        <DataGridTextColumn Header="CANT" Binding="{Binding Cantidad}" Width="80" FontSize="18"/>
                        <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioUnitario, StringFormat=C2}" Width="120" FontSize="18"/>
                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=C2}" Width="120" FontSize="18" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#007ACC" Margin="10,0,10,10" CornerRadius="10">
                    <Grid>
                        <TextBlock Text="TOTAL A PAGAR:" Foreground="White" FontSize="25" Margin="30,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="lblTotal" Text="$ 0.00" Foreground="White" FontWeight="Bold" FontSize="70" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,30,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="GridPago" Visibility="Collapsed" Background="#1E1E1E">
                <TextBlock Text="¿CÓMO DESEA PAGAR?" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                <UniformGrid Columns="2" Rows="2" Margin="50,100,50,50">
                    <Button Click="BtnPago_Click" Tag="EFECTIVO" Margin="10" Background="#2D2D30" BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="💵" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock Text="EFECTIVO" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnPago_Click" Tag="TARJETA" Margin="10" Background="#2D2D30" BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="💳" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock Text="TARJETA" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnPago_Click" Tag="MERCADOPAGO" Margin="10" Background="#009EE3" BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="📱" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock Text="MERCADO PAGO" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="BtnPago_Click" Tag="CTACTE" Margin="10" Background="#2D2D30" BorderBrush="Transparent">
                        <StackPanel>
                            <TextBlock Text="📝" FontSize="60" HorizontalAlignment="Center"/>
                            <TextBlock Text="CUENTA CTE." Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>

            <Grid x:Name="GridQR" Visibility="Collapsed" Background="#009EE3">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ESCANEE PARA PAGAR" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Border Background="White" Padding="20" CornerRadius="10" HorizontalAlignment="Center">
                        <Image x:Name="imgQR" Width="300" Height="300"/>
                    </Border>
                    <TextBlock x:Name="lblTotalQR" Text="$ 0,00" Foreground="White" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <Button Content="VOLVER" Click="BtnVolver_Click" Width="200" Height="60" FontSize="20" FontWeight="Bold" Margin="0,30,0,0" Background="#1E1E1E" Foreground="White"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GridGracias" Visibility="Collapsed" Background="#00A86B">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="100" HorizontalAlignment="Center"/>
                    <TextBlock Text="¡MUCHAS GRACIAS!" Foreground="White" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Por favor, retire su comprobante." Foreground="White" FontSize="30" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>