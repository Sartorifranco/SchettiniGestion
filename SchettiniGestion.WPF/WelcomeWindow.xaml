<Window x:Class="SchettiniGestion.WPF.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido a SCHPOS" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="#1E1E1E">

    <Border BorderBrush="#007ACC" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#252526">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="SCHPOS" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="PUNTO DE VENTA" Foreground="#007ACC" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Configuración Inicial" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="Cree el usuario administrador para comenzar." Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center" Margin="20,10" FontSize="12"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40">
                <TextBlock Text="👋 ¡Hola!" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock Text="Parece que es la primera vez que inicia el sistema." Foreground="#AAA" FontSize="16" Margin="0,0,0,30"/>

                <TextBlock Text="Nombre de Usuario (Admin):" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUser" Height="40" FontSize="16" Padding="5" Background="#333" Foreground="White" BorderBrush="#555" Text="admin"/>

                <TextBlock Text="Contraseña:" Foreground="White" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPass" Height="40" FontSize="16" Padding="5" Background="#333" Foreground="White" BorderBrush="#555"/>

                <TextBlock Text="Repetir Contraseña:" Foreground="White" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassConfirm" Height="40" FontSize="16" Padding="5" Background="#333" Foreground="White" BorderBrush="#555"/>

                <Button x:Name="btnCrear" Content="CREAR ADMINISTRADOR E INICIAR" Click="btnCrear_Click"
                        Height="50" Margin="0,30,0,0" Background="#00A86B" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Name="bdr" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#00C47D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="Button_Click" Background="Transparent" Foreground="Gray" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>