# Copiar a /etc/schpos/license-api.env y ajustar permisos:
#   sudo cp license-api.env.example /etc/schpos/license-api.env
#   sudo chmod 640 /etc/schpos/license-api.env
#   sudo chown root:www-data /etc/schpos/license-api.env

# Clave de administración (header X-Api-Key en /generate y /history)
ApiSecurity__AdminApiKey=REEMPLAZAR-CLAVE-ADMIN-LARGA-Y-ALEATORIA

# Opcional: si se define, /validate exige header X-Pos-Api-Key
# ApiSecurity__PosApiKey=

# Opcional: override de ruta de datos
# Licensing__DataFilePath=/var/lib/schpos-licenses/datos.json

# Opcional: override de clave AES (debe coincidir con SCHPOS)
# Licensing__SecretKey=Soctech_Sistemas_Seguridad_2025!
