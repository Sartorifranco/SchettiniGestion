# Copiar a /etc/schpos/license-api.env y ajustar permisos:
#   sudo mkdir -p /etc/schpos /var/lib/schpos-licenses
#   sudo cp license-api.env.example /etc/schpos/license-api.env
#   sudo chmod 640 /etc/schpos/license-api.env
#   sudo chown root:www-data /etc/schpos/license-api.env
#
# NUNCA subas este archivo al repositorio con secretos reales.

# Clave de administración del panel (login + header X-Api-Key para scripts)
ApiSecurity__AdminApiKey=GENERAR-CLAVE-ADMIN-LARGA-Y-ALEATORIA

# Obligatoria en Production: protege POST /api/licenses/validate
ApiSecurity__PosApiKey=GENERAR-CLAVE-POS-LARGA-Y-ALEATORIA
ApiSecurity__RequirePosApiKey=true

# Orígenes del panel (CORS con credenciales / cookie)
ApiSecurity__AllowedOrigins__0=https://licencias.schpos.com.ar

# Debe coincidir EXACTAMENTE con LicenseManager.SECRET_KEY de SCHPOS.
# Sin esta variable la API no arranca en Production.
Licensing__SecretKey=PEGAR-LA-MISMA-CLAVE-AES-QUE-USA-SCHPOS

# Opcional
# Licensing__DataFilePath=/var/lib/schpos-licenses/datos.json
