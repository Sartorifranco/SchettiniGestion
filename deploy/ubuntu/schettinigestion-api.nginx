# Sitio: licencias.schpos.com.ar
# Copiar a: /etc/nginx/sites-available/schettinigestion-api
# Enlazar:  sudo ln -s /etc/nginx/sites-available/schettinigestion-api /etc/nginx/sites-enabled/

# Redirección HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name licencias.schpos.com.ar;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Rate limit zones (definir una sola vez en http{} si ya existe, o incluir aquí vía conf.d)
# limit_req_zone $binary_remote_addr zone=schpos_api:10m rate=30r/m;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name licencias.schpos.com.ar;

    ssl_certificate     /etc/letsencrypt/live/licencias.schpos.com.ar/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/licencias.schpos.com.ar/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 1m;

    # Cabeceras de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/schettinigestion-api.access.log;
    error_log  /var/log/nginx/schettinigestion-api.error.log;

    location / {
        # limit_req zone=schpos_api burst=20 nodelay;
        proxy_pass         http://127.0.0.1:5080;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }
}
